# NuttX defconfig overlay for STM32F746G-Discovery test runner under
# Renode.  Applied on top of stm32f746g-disco:nsh base configuration.

# oveRTOS test app
CONFIG_EXTERNAL_OVE_TEST=y
CONFIG_EXTERNAL_OVE_TEST_PROGNAME="ove_test"
CONFIG_EXTERNAL_OVE_TEST_PRIORITY=100
CONFIG_EXTERNAL_OVE_TEST_STACKSIZE=16384

# Boot directly into the test runner (no NSH shell)
CONFIG_INIT_ENTRYPOINT="ove_test_main"

# POSIX features needed by NuttX backend modules
CONFIG_LIBC_INLINE_QUEUE=y
CONFIG_TLS_NELEM=4
CONFIG_TLS_TASK_NELEM=4
# SIG_EVTHREAD requires SCHED_WORKQUEUE + SCHED_HPWORK; mps2-an500:nsh
# enables those automatically, stm32f746g-disco:nsh does not.
CONFIG_SCHED_WORKQUEUE=y
CONFIG_SCHED_HPWORK=y
CONFIG_SCHED_HPWORKPRIORITY=192
CONFIG_SCHED_HPWORKSTACKSIZE=4096
CONFIG_SIG_EVTHREAD=y
CONFIG_SIG_EVTHREAD_HPWORK=y

# Pthreads
CONFIG_PTHREAD_MUTEX_TYPES=y
CONFIG_PTHREAD_MUTEX_ROBUST=y
CONFIG_PTHREAD_CLEANUP=y
CONFIG_PTHREAD_MUTEX_DEFAULT_PRIO_INHERIT=y

# POSIX message queues
CONFIG_MQ_MAXMSGSIZE=256

# POSIX timers
CONFIG_DISABLE_POSIX_TIMERS=n

# Memory.  stm32f746g-disco:nsh ships with 2 KB stacks for tasks /
# pthreads — cmocka + ove_test infrastructure overflows that.  Match
# mps2-an500's 4 KB defaults; the panic seen otherwise is a thread
# stack overrun on the first pthread create in test_thread.
CONFIG_ARCH_INTERRUPTSTACK=2048
CONFIG_IDLETHREAD_STACKSIZE=2048
CONFIG_INIT_STACKSIZE=4096
CONFIG_DEFAULT_TASK_STACKSIZE=4096
CONFIG_PTHREAD_STACK_DEFAULT=4096
CONFIG_POSIX_SPAWN_DEFAULT_STACKSIZE=4096
CONFIG_IRQ_WORK_STACKSIZE=4096
CONFIG_STACK_COLORATION=y

# Enough heap for test suites
CONFIG_MM_REGIONS=1

# Console — stm32f746g-disco:nsh routes the serial console through
# USART1 (CONFIG_USART1_SERIAL_CONSOLE in the base defconfig).  Renode
# models USART1 as STM32F7_USART, so the test.resc taps that into a
# file backend.  Don't override UART selection here.

# File system support (for posix_fs/posix_nvs stubs)
CONFIG_FS_TMPFS=y

# Disable verbose debug logging (base mps2-an500:nsh enables DEBUG_SCHED_INFO
# which floods the console with pthread_mutex_timedlock/unlock messages)
# CONFIG_DEBUG_SCHED_INFO is not set
# CONFIG_DEBUG_SCHED_WARN is not set
# CONFIG_DEBUG_SCHED is not set

# Disable features not needed for testing
# CONFIG_NSH_LIBRARY is not set
CONFIG_SCHED_WAITPID=y

# setjmp/longjmp needed by cmocka test framework
CONFIG_ARCH_SETJMP_H=y

# Portable on-target unwinder for the oveRTOS sampling profiler
# (matches the board defconfig used for sim/dashboard runs).
CONFIG_SCHED_BACKTRACE=y

# NuttX defconfig overlay for the isolated Linux-personality QEMU runner.
# Applied on top of mps2-an500:nsh. Runs only the bFLT/SVC-trap test as the
# init task. WIP: the on-target SVC trap is blocked on the flat-build
# svc/scheduling collision (the clean fix is CONFIG_BUILD_PROTECTED, which
# mps2-an500 lacks via CMake upstream).

# oveRTOS test app (init)
CONFIG_EXTERNAL_OVE_TEST=y
CONFIG_EXTERNAL_OVE_TEST_PROGNAME="ove_test"
CONFIG_EXTERNAL_OVE_TEST_PRIORITY=100
CONFIG_EXTERNAL_OVE_TEST_STACKSIZE=16384

# Boot directly into the test runner instead of nsh
CONFIG_INIT_ENTRYPOINT="ove_test_main"

# Memory
CONFIG_ARCH_INTERRUPTSTACK=2048
CONFIG_IDLETHREAD_STACKSIZE=2048
CONFIG_STACK_COLORATION=y
CONFIG_MM_REGIONS=1

# Console (semihosting UART on QEMU)
CONFIG_DEV_CONSOLE=y
CONFIG_SERIAL=y
CONFIG_UART0_SERIAL_CONSOLE=y
CONFIG_UART0_BAUD=115200

# Disable verbose debug logging from the base mps2-an500:nsh config
# CONFIG_DEBUG_SCHED_INFO is not set
# CONFIG_DEBUG_SCHED_WARN is not set
# CONFIG_DEBUG_SCHED is not set

# Disable features not needed for this minimal runner
# CONFIG_NSH_LIBRARY is not set
CONFIG_SCHED_WAITPID=y

# setjmp/longjmp needed by CMocka and the SVC-trap recovery path
CONFIG_ARCH_SETJMP_H=y

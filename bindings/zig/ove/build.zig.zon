.{
    .name = .ove,
    .version = "0.1.0",
    .fingerprint = 0xf8771ea884296860,
    // Pinned to 0.16: binding uses the unified `create(std.mem.Allocator)`
    // shape on every primitive, `comptime anytype` trampoline introspection
    // on `Thread.spawn` and `Timer.create`, `Instant.now()` `+|` saturating
    // arithmetic. Earlier zig versions either lack these constructs or have
    // incompatible stdlib API shapes.
    .minimum_zig_version = "0.16.0",
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
    },
}

# Linux personality — engine-agnostic syscall dispatch + per-engine SVC seam.
{% if config.get("CONFIG_OVE_LINUX") == True %}
set(OVE_LINUX ON)
# The module's extracted subsystem TUs (src/fs/*.c, src/proc/*.c) include their headers
# src-relative (e.g. #include "fs/lxp_pipe.h"), matching how the module builds itself
# (lxp's own build adds -I src). lxp_syscall.c gets this for free via quote-include's
# current-dir search, but the src/fs + src/proc TUs need src on the include path.
include_directories(${OVE_DIR}/modules/lxp/src)
# ---- lxp module: map oveRTOS Kconfig -> the module's own LXP_ENABLE_* + sizing ----
# The lxp module (modules/lxp) is OS-agnostic: it gates on LXP_ENABLE_* / LXP_* knobs,
# not CONFIG_OVE_*. oveRTOS supplies them here from its Kconfig (its adapters + seams,
# which include the module's headers, need them too, so these are compile-wide).
add_compile_definitions(LXP_ENABLE_LINUX=1 LXP_ENABLE_LOADER=1)
{% if config.get("CONFIG_OVE_LINUX_GUEST_FLOAT_ABI_HARD") == True %}
# The guest ABI is independent of the host firmware ABI. A hard-float guest can
# park in the syscall top half and later resume in a recreated FreeRTOS task, so
# the seam and shared core must carry its complete single-precision VFP state.
set(OVE_LINUX_GUEST_FLOAT_ABI "hard")
add_compile_definitions(LXP_ENABLE_FPU_CONTEXT=1)
{% else %}
set(OVE_LINUX_GUEST_FLOAT_ABI "soft")
{% endif %}
{% for feat, cfg in [("NET","CONFIG_OVE_LINUX_NET"), ("NETFS","CONFIG_OVE_LINUX_NETFS"),
                     ("NETFS_EXEC","CONFIG_OVE_LINUX_NETFS_EXEC"), ("PTY","CONFIG_OVE_LINUX_PTY"),
                     ("DEV","CONFIG_OVE_LINUX_DEV"), ("DEV_FB","CONFIG_OVE_LINUX_DEV_FB"),
                     ("DEV_INPUT","CONFIG_OVE_LINUX_DEV_INPUT"),
                     ("DEV_INPUT_TESTPAD","CONFIG_OVE_LINUX_DEV_INPUT_TESTPAD"),
                     ("TOUCH","CONFIG_OVE_FT5336")] %}
{% if config.get(cfg) == True %}
add_compile_definitions(LXP_ENABLE_{{ feat }}=1)
{% endif %}
{% endfor %}
{% if config.get("CONFIG_OVE_RTOS_ZEPHYR") == True %}
# 256K program regions (matching FreeRTOS/NuttX): the guest text XIPs from the embedded cpio, so the
# region holds only the exec's RW data + stack. 512K wasted ~half; at 8 regions the old 512K made the
# pools 8x(512K+512K)=8 MiB = the whole SDRAM1, leaving no room for the LTDC framebuffer (link
# overflow). 8x(256K+512K)=6 MiB leaves 2 MiB for the framebuffer + headroom.
add_compile_definitions(LXP_PROG_REGION_SIZE=0x40000u LXP_PIPE_BUF=2048 LXP_PTY_BUF=512)
# The 256 KiB on-chip SRAM is tight once the Zephyr net stack (heap + pkt/buf pools + RX thread)
# lands beside the personality's .bss. The tmpfs (/tmp) arena defaults to 64 KiB; a point-to-point
# net + SSH/netfs test writes little to /tmp, so 16 KiB reclaims 48 KiB of SRAM.
add_compile_definitions(LXP_WFS_POOL=0x4000u)
{% endif %}
{% if config.get("CONFIG_OVE_RTOS_ZEPHYR") == True and config.get("CONFIG_OVE_BOARD_STM32F746G_DISCO") == True %}
# STM32F746 (Zephyr): 12-slot pipe pool for SSH pipelines. A single dropbear session's
# stdin/stdout/stderr already peak at 4 pipes, so the 4-slot default leaves nothing for the shell's
# own `ls | wc` (-> EMFILE). At LXP_PIPE_BUF=2048 that pool is 12x2K=24K, which does not fit the
# nearly-full 256 KiB SRAM once the net stack lands — relocate it to external SDRAM via LXP_FAR_BSS.
# The Zephyr SDRAM1 memory-region section is "SDRAM1" (LINKER_DT_NODE_REGION_NAME(sdram1)), the same
# NOLOAD region the guest program pools already live in; the pool is coordinator-owned (the guest
# reaches pipe bytes only through copy-in/out syscalls) so it needs no per-program MPU partition.
add_compile_definitions(LXP_NPIPE=12)
add_compile_definitions([==[LXP_FAR_BSS=__attribute__((section("SDRAM1")))]==])
# 10 program regions (default 8). An inbound SSH session's process tree is deep before any
# pipeline runs: inetd (listener) + dropbear (session) + the login shell already hold 3 regions,
# so a 3-stage `ls | grep | wc` (+ its transient vfork snapshot) exhausts the 8-region pool -> a
# child either vfork-fails (ENOMEM) or falls back to SHARING the parent region, corrupting it
# (SIGSEGV). 10 regions clear that. Each region = 256K image + 512K dyn pool = 768K of SDRAM, so
# 10 fit the 8 MiB SDRAM1 (10 x 768K = 7.5 MiB, leaving room for the framebuffer/bounce).
add_compile_definitions(LXP_NREG=10)
{% endif %}
{% if config.get("CONFIG_OVE_RTOS_FREERTOS") == True and config.get("CONFIG_OVE_BOARD_STM32F746G_DISCO") == True %}
# STM32F746: bigger pipe pool for SSH pipelines, relocated to external SDRAM.
add_compile_definitions(LXP_NPIPE=12)
add_compile_definitions([==[LXP_FAR_BSS=__attribute__((section(".sdram_bss")))]==])
{% endif %}
{% if config.get("CONFIG_OVE_RTOS_NUTTX") == True and config.get("CONFIG_OVE_BOARD_STM32F746G_DISCO") == True %}
# STM32F746 (NuttX): match FreeRTOS's 12-slot pipe pool. A single non-interactive dropbear session's
# stdin/stdout/stderr pipes alone peak at 4 slots, so the 4-slot default leaves nothing for the
# shell's own pipeline (`ls | head` -> EMFILE). NuttX owns its linker script and has no .sdram_bss
# NOLOAD hook (the seam's guest pools use fixed SDRAM addresses, not a section), so the pool stays in
# internal-SRAM .bss; a 2 KiB per-pipe buffer keeps 12 x 2K = 24K within the SRAM budget (vs the
# 4 x 4K = 16K default) and matches the proven Zephyr LXP_PIPE_BUF.
add_compile_definitions(LXP_NPIPE=12 LXP_PIPE_BUF=2048)
{% endif %}
{% if config.get("CONFIG_OVE_BOARD_QEMU_MPS2_AN500") == True and config.get("CONFIG_OVE_LINUX") == True %}
# an500 QEMU Linux: the rootfs cpio XIPs from the bottom of the 16 MiB block at 0x60000000
# (QEMU -device loader), so the FDPIC program pools share the rest -> fewer program regions.
{% if config.get("CONFIG_OVE_RTOS_NUTTX") == True %}
# NuttX takes 6, and it must be EVEN. Its pools are fixed addresses with one PMSAv7 region per
# entry (backends/nuttx/nuttx_lnx_trap.c), and dyn_pools[] sits directly after the program
# regions — a region's base must be aligned to its size, and LXP_PROG_REGION_SIZE (256K) is half
# LXP_DYN_POOL_SIZE (512K), so an odd count lands the array on a half-size boundary and every
# guest faults DACCVIOL on its own pool. This was 5 for both RTOSes, which is why the NuttX
# personality never ran a guest. 6x(256K+512K) = 4.5 MiB fits the 8 MiB pool at 0x60800000;
# nuttx_lnx_trap.c static-asserts the alignment and the fit.
add_compile_definitions(LXP_NREG=6)
{% else %}
# FreeRTOS keeps its pools in a linker-placed .psram section, so the compiler aligns each entry
# and the count need not be even — but the section must fit PSRAM: 6 overflows it (.psram lands
# past 0x61000000). 5x(256K+512K) = 3.75 MiB.
add_compile_definitions(LXP_NREG=5)
{% endif %}
{% endif %}

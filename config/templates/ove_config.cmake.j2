            "${OVE_DIR}/backends/common/httpd_ui/vendor/alpine.min.js"
    COMMENT "Bundling httpd dashboard assets"
)
add_custom_target(httpd_ui_bundle DEPENDS "${OVE_DIR}/backends/common/ove_net_httpd_ui_gz.h")
list(APPEND OVE_BACKEND_SOURCES "${OVE_DIR}/backends/common/ove_net_httpd.c")
list(APPEND OVE_BACKEND_SOURCES "${OVE_DIR}/backends/common/ove_net_httpd_routes.c")

list(APPEND OVE_BACKEND_SOURCES "${OVE_DIR}/modules/lxp/src/net/lxp_net.c")
# Host adapter for the personality's handle-based net-ops port: owns the socket
# storage pool and bridges to the ove_net HAL. Statically wires g_ove_lnx_net_ops.
list(APPEND OVE_BACKEND_SOURCES "${OVE_DIR}/backends/common/lxp_ove_adapter.c")
{% endif %}
{% if config.get("CONFIG_OVE_LINUX_NETFS") == True %}
# Remote filesystem: a coordinator-owned 9P2000.L client bridging FD_NET opens on
# a /mnt path to a 9P server (diod). Selects CONFIG_OVE_NET for the TCP transport.
list(APPEND OVE_BACKEND_SOURCES "${OVE_DIR}/modules/lxp/src/netfs/lxp_netfs.c")
{% endif %}
{% if config.get("CONFIG_OVE_LINUX_PTY") == True %}
# Pseudo-terminal layer: /dev/ptmx + /dev/pts/N (FD_PTY) with a minimal line
# discipline — the interactive tty for a network login shell (dropbear over SSH).
list(APPEND OVE_BACKEND_SOURCES "${OVE_DIR}/modules/lxp/src/pty/lxp_pty.c")
{% endif %}
{% if config.get("CONFIG_OVE_RTOS_NUTTX") == True %}
list(APPEND OVE_BACKEND_SOURCES "${OVE_DIR}/backends/nuttx/nuttx_lnx_trap.c")
{% elif config.get("CONFIG_OVE_RTOS_ZEPHYR") == True %}
list(APPEND OVE_BACKEND_SOURCES "${OVE_DIR}/backends/zephyr/zephyr_lnx.c")
# The Zephyr seam (ove_lnx_run) traps svc #0 by interposing the engine's
# software-fault handler; the app must add the link option:
#   target_link_options(app PUBLIC "-Wl,--wrap=z_do_kernel_oops")
{% elif config.get("CONFIG_OVE_RTOS_FREERTOS") == True %}
list(APPEND OVE_BACKEND_SOURCES "${OVE_DIR}/backends/freertos/freertos_lnx.c")
# The FreeRTOS seam owns SVC_Handler (a strong symbol; the board FreeRTOSConfig.h
# must NOT alias vPortSVCHandler->SVC_Handler) and uses the ARM_CM4_MPU port for
# per-task privilege + MPU. No --wrap needed.
{% endif %}
{% endif %}


{% if config.get("CONFIG_OVE_NET_HTTPD") == True %}
# Bundle dashboard assets (gzip + xxd → C header) before compiling routes
add_custom_command(
    OUTPUT "${OVE_DIR}/backends/common/ove_net_httpd_ui_gz.h"
    COMMAND bash "${OVE_DIR}/backends/common/httpd_ui/bundle.sh"
            "${OVE_DIR}/backends/common/ove_net_httpd_ui_gz.h"

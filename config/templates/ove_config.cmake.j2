# Linux personality — engine-agnostic syscall dispatch + per-engine SVC seam.
{% if config.get("CONFIG_OVE_LINUX") == True %}
set(OVE_LINUX ON)
# The module's extracted subsystem TUs (src/fs/*.c, src/proc/*.c) include their headers
# src-relative (e.g. #include "fs/lxp_pipe.h"), matching how the module builds itself
# (lxp's own build adds -I src). lxp_syscall.c gets this for free via quote-include's
# current-dir search, but the src/fs + src/proc TUs need src on the include path.
include_directories(${OVE_DIR}/modules/lxp/src)
# ---- lxp module: map oveRTOS Kconfig -> the module's own LXP_ENABLE_* + sizing ----
# The lxp module (modules/lxp) is OS-agnostic: it gates on LXP_ENABLE_* / LXP_* knobs,
# not CONFIG_OVE_*. oveRTOS supplies them here from its Kconfig (its adapters + seams,
# which include the module's headers, need them too, so these are compile-wide).
add_compile_definitions(LXP_ENABLE_LINUX=1 LXP_ENABLE_LOADER=1)
{% for feat, cfg in [("NET","CONFIG_OVE_LINUX_NET"), ("NETFS","CONFIG_OVE_LINUX_NETFS"),
                     ("NETFS_EXEC","CONFIG_OVE_LINUX_NETFS_EXEC"), ("PTY","CONFIG_OVE_LINUX_PTY"),
                     ("DEV","CONFIG_OVE_LINUX_DEV"), ("DEV_FB","CONFIG_OVE_LINUX_DEV_FB"),
                     ("DEV_INPUT","CONFIG_OVE_LINUX_DEV_INPUT"),
                     ("DEV_INPUT_TESTPAD","CONFIG_OVE_LINUX_DEV_INPUT_TESTPAD"),
                     ("TOUCH","CONFIG_OVE_FT5336")] %}
{% if config.get(cfg) == True %}
add_compile_definitions(LXP_ENABLE_{{ feat }}=1)
{% endif %}
{% endfor %}
{% if config.get("CONFIG_OVE_RTOS_ZEPHYR") == True %}
add_compile_definitions(LXP_PROG_REGION_SIZE=0x80000u LXP_PIPE_BUF=2048 LXP_PTY_BUF=512)
{% endif %}
{% if config.get("CONFIG_OVE_RTOS_FREERTOS") == True and config.get("CONFIG_OVE_BOARD_STM32F746G_DISCO") == True %}
# STM32F746: bigger pipe pool for SSH pipelines, relocated to external SDRAM.
add_compile_definitions(LXP_NPIPE=12)
add_compile_definitions([==[LXP_FAR_BSS=__attribute__((section(".sdram_bss")))]==])
{% endif %}
{% if config.get("CONFIG_OVE_BOARD_QEMU_MPS2_AN500") == True and config.get("CONFIG_OVE_LINUX") == True %}
# an500 QEMU Linux: the rootfs cpio XIPs from the bottom 12 MiB of PSRAM (QEMU -device
# loader @ 0x60000000), so the FDPIC program pools share the top 4 MiB of the 16 MiB PSRAM
# -> fewer program regions (5x(256K+512K) = 3.75 MiB fits).
add_compile_definitions(LXP_NREG=5)
{% endif %}
# The embedded BusyBox rootfs.cpio comes from <OVE_BUILDROOT>/<OVE_LINUX_ROOTFS_OUTPUT>/images/.
# Both are CONFIG_* (Kconfig) — no local paths are baked into the oveRTOS sources. A relative
# OVE_BUILDROOT is resolved against the oveRTOS root in cmake/OveLinuxFixtures.cmake.
set(OVE_BUILDROOT "{{ config.get('CONFIG_OVE_BUILDROOT', '../buildroot') }}")
set(OVE_LINUX_ROOTFS_OUTPUT "{{ config.get('CONFIG_OVE_LINUX_ROOTFS_OUTPUT', 'output') }}")

add_compile_definitions(LXP_ENABLE_TOUCH=1)
{% endif %}
{% if config.get("CONFIG_OVE_RTOS_ZEPHYR") == True %}
# Guest text XIPs from the rootfs CPIO backing, so a dynamic program region holds only the exec's
# small RW data, ld.so RW data, and stack. The real STM32 QSPI image uses 128K regions to increase
# process capacity; remote exec retains 256K because it copies the fetched executable's own text
# into this region. Other Zephyr targets keep the conservative default.
{% if config.get("CONFIG_OVE_BOARD_STM32F746G_DISCO") == True and config.get("CONFIG_OVE_LINUX_NETFS_EXEC") != True %}
add_compile_definitions(LXP_PROG_REGION_SIZE=0x20000u LXP_PIPE_BUF=2048 LXP_PTY_BUF=512)
{% else %}
add_compile_definitions(LXP_PROG_REGION_SIZE=0x40000u LXP_PIPE_BUF=2048 LXP_PTY_BUF=512)
{% endif %}
{% endif %}
# tmpfs (/tmp) byte pool. All three STM32 engines place this coordinator-owned
# storage in external SDRAM and expose the same 256 KiB capacity. That supports
# sizeable temporary databases and mmap-backed network buffers while keeping
# the allocation bounded. Zephyr's SRAM-limited an521 profile stays at 16 KiB;
# other boards retain LXP's portable 64 KiB default.
{% if config.get("CONFIG_OVE_BOARD_STM32F746G_DISCO") == True %}
add_compile_definitions(LXP_WFS_POOL=0x40000u)
{% elif config.get("CONFIG_OVE_RTOS_ZEPHYR") == True %}
add_compile_definitions(LXP_WFS_POOL=0x4000u)
{% endif %}
{% if config.get("CONFIG_OVE_RTOS_ZEPHYR") == True and config.get("CONFIG_OVE_BOARD_STM32F746G_DISCO") == True %}
# STM32F746 (Zephyr): 12-slot pipe pool for SSH pipelines. A single dropbear session's
# stdin/stdout/stderr already peak at 4 pipes, so the 4-slot default leaves nothing for the shell's
# own `ls | wc` (-> EMFILE). At LXP_PIPE_BUF=2048 that pool is 12x2K=24K, which does not fit the
# nearly-full 256 KiB SRAM once the net stack lands — relocate it to external SDRAM via LXP_FAR_BSS.
# The Zephyr SDRAM1 memory-region section is "SDRAM1" (LINKER_DT_NODE_REGION_NAME(sdram1)), the same
# NOLOAD region the guest program pools already live in; the pool is coordinator-owned (the guest
# reaches pipe bytes only through copy-in/out syscalls) so it needs no per-program MPU partition.
add_compile_definitions(LXP_NPIPE=12)
add_compile_definitions([==[LXP_FAR_BSS=__attribute__((section("SDRAM1")))]==])
# An inbound SSH session's process tree is deep before any
# pipeline runs: inetd (listener) + dropbear (session) + the login shell already hold 3 regions,
# so a 3-stage `ls | grep | wc` (+ its transient vfork snapshot) exhausts the 8-region pool -> a
# child fails with ENOMEM. More regions leave useful headroom for pipelines and network daemons.
# With local QSPI XIP, 12 x (128K program + 512K dynamic) retains the old 7.5 MiB pool footprint.
{% if config.get("CONFIG_OVE_LINUX_NETFS_EXEC") == True %}
# netfs exec-off-mount adds a 256K g_netfs_exec_stage buffer + the 9P client's ~24K .bss to SDRAM1,
# which overflows it at 10 regions. Drop to 9 (frees one 768K region) to fund the stage; the netfs
# milestone exercises browse/read/exec from shallow process trees (shell + one child), so 9 is ample
# — and inetd+dropbear+shell+a 2-3 stage pipe still fits for SSH-driven netfs.
add_compile_definitions(LXP_NREG=9)
{% else %}
add_compile_definitions(LXP_NREG=12)
{% endif %}
{% endif %}
{% if config.get("CONFIG_OVE_RTOS_FREERTOS") == True and config.get("CONFIG_OVE_BOARD_STM32F746G_DISCO") == True %}
# STM32F746: bigger pipe pool for SSH pipelines, relocated to external SDRAM.
add_compile_definitions(LXP_NPIPE=12)
add_compile_definitions([==[LXP_FAR_BSS=__attribute__((section(".sdram_bss")))]==])
{% if config.get("CONFIG_OVE_LINUX_NETFS_EXEC") == True %}
# Remote exec retains 256K program rows and adds a 256K staging buffer. Nine
# regions still fit the external-SDRAM envelope and are the minimum useful
# capacity for SSH + lvmusic + network traffic + a transient sqlite3 child.
add_compile_definitions(LXP_NREG=9)
{% else %}
# QSPI-backed dynamic executables keep text XIP, so 128K program/stack regions plus the unchanged
# 512K dynamic arenas allow 11 isolated processes in the 7 MiB pool window.
add_compile_definitions(LXP_PROG_REGION_SIZE=0x20000u LXP_NREG=11)
{% endif %}
{% endif %}
{% if config.get("CONFIG_OVE_RTOS_NUTTX") == True and config.get("CONFIG_OVE_BOARD_STM32F746G_DISCO") == True %}
# STM32F746 (NuttX): match FreeRTOS's 12-slot pipe pool. A single non-interactive dropbear session's
# stdin/stdout/stderr pipes alone peak at 4 slots, so the 4-slot default leaves nothing for the
# shell's own pipeline (`ls | head` -> EMFILE). NuttX owns its linker script and has no .sdram_bss
# NOLOAD hook (the NuttX host binding uses fixed SDRAM addresses, not a section), so the pipe pool
# stays in internal-SRAM .bss; a 2 KiB per-pipe buffer keeps 12 x 2K = 24K within the SRAM budget (vs the
# 4 x 4K = 16K default) and matches the proven Zephyr LXP_PIPE_BUF.
add_compile_definitions(LXP_NPIPE=12 LXP_PIPE_BUF=2048)
# The tmpfs pool is ordinary privileged coordinator memory, not a guest MPU
# allocation. Put it in the unused cacheable tail of the 8 MiB SDRAM envelope:
# above every dynamic/program/staging row and outside the framebuffer's Device
# subregion. The LXP NuttX port statically rejects future layout overlap.
add_compile_definitions(LXP_WFS_POOL_BASE=0xC07C0000u)
{% if config.get("CONFIG_OVE_LINUX_NETFS_EXEC") == True %}
# The 256K remote-exec stage still leaves room for nine 768K guest rows below
# the fixed tmpfs pool. Nine regions are required for an inbound SSH session
# to retain lvmusic + network traffic + one transient database child.
add_compile_definitions(LXP_NREG=9)
{% else %}
# The NuttX host binding lays the large program/dynamic pools in external SDRAM, but each region also
# adds one process slot plus four transient slots worth of privileged metadata to SRAM1. Keep
# this profile at the same eight-region/twelve-slot capacity as the proven full profile. Ten
# regions leave only about 2.5K of the early kernel heap, so inode_root_reserve() cannot allocate
# NuttX's root inode before the board adds SRAM2 and DTCM as later heap regions.
add_compile_definitions(LXP_PROG_REGION_SIZE=0x20000u LXP_NREG=8)
{% endif %}
{% endif %}
{% if config.get("CONFIG_OVE_BOARD_QEMU_MPS2_AN500") == True and config.get("CONFIG_OVE_LINUX") == True %}
# an500 QEMU Linux: the rootfs cpio XIPs from the bottom of the 16 MiB block at 0x60000000
# (QEMU -device loader), so the FDPIC program pools share the rest -> fewer program regions.
{% if config.get("CONFIG_OVE_RTOS_NUTTX") == True %}
# NuttX retains six regions in its fixed upper 8 MiB pool. Its single rootfs MPU region covers
# the lower 8 MiB only; CONFIG_OVE_LINUX_ROOTFS_SIZE is the shared app/seam/runner bound.
# The seam lays its 512K dynamic rows first,
# so every PMSAv7 base remains naturally aligned even when the configured count is odd.
add_compile_definitions(LXP_NREG=6)
{% else %}
# FreeRTOS keeps its pools in a linker-placed .psram section. The section must fit the top 4 MiB:
# 5x(256K+512K) = 3.75 MiB. Remote-exec's 256K stage plus cold captures requires one fewer row.
{% if config.get("CONFIG_OVE_LINUX_NETFS_EXEC") == True %}
add_compile_definitions(LXP_NREG=4)
{% else %}
add_compile_definitions(LXP_NREG=5)
{% endif %}
{% endif %}
{% endif %}
{% if config.get("CONFIG_OVE_BOARD_QEMU_MPS2_AN521") == True and config.get("CONFIG_OVE_LINUX") == True %}
# AN521 has one 16 MiB PSRAM bank. The production rootfs occupies the lower
# 0x00ef0000 bytes; retain one process region in the remaining 1088 KiB so every
# supported profile (including the netfs-exec staging buffer) has a runnable
# QEMU validation target without embedding the rootfs in internal flash.
add_compile_definitions(LXP_NREG=1)
{% endif %}
# The embedded BusyBox rootfs.cpio comes from <OVE_BUILDROOT>/<OVE_LINUX_ROOTFS_OUTPUT>/images/.
# Both are CONFIG_* (Kconfig) — no local paths are baked into the oveRTOS sources. A relative
# OVE_BUILDROOT is resolved against the oveRTOS root in cmake/OveLinuxFixtures.cmake.
set(OVE_BUILDROOT "{{ config.get('CONFIG_OVE_BUILDROOT', '../buildroot') }}")
set(OVE_LINUX_ROOTFS_OUTPUT "{{ config.get('CONFIG_OVE_LINUX_ROOTFS_OUTPUT', 'output') }}")
# The module owns the one translation-unit inventory shared by standalone,
# firmware, host-test, and fuzz consumers. Firmware selects the feature groups
# below; adding an unclassified src/*.c file makes configuration fail closed.
include("${OVE_DIR}/modules/lxp/cmake/lxp_sources.cmake")
list(APPEND OVE_BACKEND_SOURCES
     ${LXP_RUNTIME_SOURCES}
     ${LXP_COORDINATOR_SOURCES}
     ${LXP_POST_COORDINATOR_SOURCES})
# Explicit oveRTOS -> LXP thread-snapshot contract adapter.
list(APPEND OVE_BACKEND_SOURCES "${OVE_DIR}/backends/common/lxp_ove_thread_adapter.c")
# oveRTOS-owned provider composition and pre-rootfs-access facade.
list(APPEND OVE_BACKEND_SOURCES "${OVE_DIR}/backends/common/lxp_ove_host.c")
# Host-scoped snapshots over LXP diagnostics, latency, and port observations.
list(APPEND OVE_BACKEND_SOURCES "${OVE_DIR}/backends/common/lxp_ove_observability.c")
# System-console transport and run-scoped RX-readiness binding.
list(APPEND OVE_BACKEND_SOURCES "${OVE_DIR}/backends/common/lxp_ove_console.c")
{% if config.get("CONFIG_OVE_LINUX_FS") == True %}
# Persistent /data provider: all native volume operations are serialized on a
# host worker so LXP owns Linux VFS semantics while oveRTOS owns storage access.
list(APPEND OVE_BACKEND_SOURCES "${OVE_DIR}/backends/common/lxp_ove_fs_adapter.c")
{% endif %}
# Coordinator counters plus module-owned arena / loader utilities retain their
# established archive order after the oveRTOS adapters.
list(APPEND OVE_BACKEND_SOURCES ${LXP_UTILITY_SOURCES})
{% if config.get("CONFIG_OVE_LINUX_LATENCY") == True %}
# The module spells this gate LXP_ENABLE_LATENCY, not CONFIG_OVE_*: modules/lxp builds
# standalone under its own suites and check-decoupled.sh forbids oveRTOS symbols inside it,
# so the Kconfig choice is translated here. Global rather than per-target — the counters live
# in the module while the app reads them back, and a gate reaching only one of the two would
# quietly pair a real recorder with a no-op reader.
add_compile_definitions(LXP_ENABLE_LATENCY=1)
{% endif %}
{% if config.get("CONFIG_OVE_LINUX_DEV") == True %}
# /dev character-device layer: core registry + routing (class drivers added by
# their own CONFIG_OVE_LINUX_DEV_* below).
list(APPEND OVE_BACKEND_SOURCES ${LXP_DEV_SOURCES})
{% if config.get("CONFIG_OVE_LINUX_BLOCK") == True %}
list(APPEND OVE_BACKEND_SOURCES ${LXP_BLOCK_SOURCES})
{% endif %}
# Host adapter for the display/input port: exports the immutable provider table
# passed to lxp_run(), bridging fb/touch ops to ove_fb_* / ove_ft5336_*.
list(APPEND OVE_BACKEND_SOURCES "${OVE_DIR}/backends/common/lxp_ove_disp_adapter.c")
{% if config.get("CONFIG_OVE_LINUX_DEV_FB") == True %}
list(APPEND OVE_BACKEND_SOURCES ${LXP_DEV_FB_SOURCES})
{% endif %}
{% if config.get("CONFIG_OVE_LINUX_DEV_DMA2D") == True %}
list(APPEND OVE_BACKEND_SOURCES ${LXP_DEV_DMA2D_SOURCES})
{% if config.get("CONFIG_OVE_RTOS_NUTTX") == True and config.get("CONFIG_OVE_BOARD_STM32F746G_DISCO") == True %}
# NuttX STM32: the strong backend ONLY — a weak fallback in the same static
# archive would satisfy the reference first and the strong object never pull.
list(APPEND OVE_BACKEND_SOURCES "${OVE_DIR}/drivers/nuttx/stm32f7/stm32f7_dma2d.c")
{% elif config.get("CONFIG_OVE_RTOS_ZEPHYR") == True and config.get("CONFIG_OVE_BOARD_STM32F746G_DISCO") == True %}
# Zephyr STM32: the strong backend ONLY (same static-archive reasoning as NuttX).
list(APPEND OVE_BACKEND_SOURCES "${OVE_DIR}/drivers/zephyr/stm32f7/stm32f7_dma2d.c")
{% else %}
# Weak ove_hal_dma2d fallback for engines/boards with no strong DMA2D backend;
# a board with Chrom-ART strong-overrides it via direct link (FreeRTOS).
list(APPEND OVE_BACKEND_SOURCES "${OVE_DIR}/backends/common/ove_hal_dma2d.c")
{% endif %}
{% endif %}
{% if config.get("CONFIG_OVE_LINUX_DEV_INPUT") == True %}
list(APPEND OVE_BACKEND_SOURCES ${LXP_DEV_INPUT_SOURCES})
{% endif %}
{% if config.get("CONFIG_OVE_FT5336") == True %}
list(APPEND OVE_BACKEND_SOURCES "${OVE_DIR}/src/ove_ft5336.c")
{% endif %}
{% endif %}
{% if config.get("CONFIG_OVE_LINUX_NET") == True %}
# Socket layer: bridges the personality's socket syscalls (FD_SOCKET) to the
# engine-neutral ove_net HAL. Selects CONFIG_OVE_NET, whose block adds the
# per-engine *_net.c backend + the native TCP/IP stack (lwIP on FreeRTOS).
list(APPEND OVE_BACKEND_SOURCES ${LXP_NET_SOURCES})
# Host adapter for the personality's handle-based net-ops port: owns the socket
# storage pool and bridges to the ove_net HAL. Statically wires g_ove_lnx_net_ops.
list(APPEND OVE_BACKEND_SOURCES "${OVE_DIR}/backends/common/lxp_ove_adapter.c")
{% endif %}
{% if config.get("CONFIG_OVE_LINUX_NETFS") == True %}
# Remote filesystem: a coordinator-owned 9P2000.L client bridging FD_NET opens on
# a /mnt path to a 9P server (diod). Selects CONFIG_OVE_NET for the TCP transport.
list(APPEND OVE_BACKEND_SOURCES ${LXP_NETFS_SOURCES})
{% endif %}
{% if config.get("CONFIG_OVE_LINUX_PTY") == True %}
# Pseudo-terminal layer: /dev/ptmx + /dev/pts/N (FD_PTY) with a minimal line
# discipline — the interactive tty for a network login shell (dropbear over SSH).
list(APPEND OVE_BACKEND_SOURCES ${LXP_PTY_SOURCES})
{% endif %}
{% if config.get("CONFIG_OVE_LINUX_RT_SCOPE") == True and
      (config.get("CONFIG_OVE_RTOS_FREERTOS") == True or
       config.get("CONFIG_OVE_RTOS_ZEPHYR") == True or
       config.get("CONFIG_OVE_RTOS_NUTTX") == True) %}
# OVE-facing timing facade. Canonical LXP owns SVC accumulation and syscall
# naming; the embedding supplies counter frequency and optional native metrics.
list(APPEND OVE_BACKEND_SOURCES "${OVE_DIR}/backends/common/ove_lxp_metrics.c")
{% endif %}
{% if config.get("CONFIG_OVE_RTOS_NUTTX") == True %}
# LXP owns native NuttX task/trap/MPU mechanics. oveRTOS supplies board memory
# placement and host policy through g_lxp_nuttx_port_config.
list(APPEND OVE_BACKEND_SOURCES
    "${OVE_DIR}/modules/lxp/ports/nuttx/lxp_nuttx_port.c"
    "${OVE_DIR}/backends/nuttx/nuttx_lxp_host.c")
{% elif config.get("CONFIG_OVE_RTOS_ZEPHYR") == True %}
# LXP owns native Zephyr K_USER thread/trap/domain mechanics. oveRTOS supplies
# external-memory placement and host policy through g_lxp_zephyr_port_config.
list(APPEND OVE_BACKEND_SOURCES
    "${OVE_DIR}/modules/lxp/ports/zephyr/lxp_zephyr_port.c"
    "${OVE_DIR}/backends/zephyr/zephyr_lxp_host.c")
# The port traps lxp_run()'s guest svc #0 by interposing Zephyr's
# software-fault handler; the board must add the link option:
#   target_link_options(app PUBLIC "-Wl,--wrap=z_do_kernel_oops")
{% elif config.get("CONFIG_OVE_RTOS_FREERTOS") == True %}
list(APPEND OVE_BACKEND_SOURCES
     "${OVE_DIR}/modules/lxp/ports/freertos/lxp_freertos_port.c"
     "${OVE_DIR}/backends/freertos/freertos_lxp_host.c")
# LXP's FreeRTOS port owns SVC_Handler (a strong symbol; FreeRTOSConfig.h
# must NOT alias vPortSVCHandler->SVC_Handler) and uses the ARM_CM4_MPU port for
# per-task privilege + MPU. oveRTOS supplies memory placement and board/HAL
# callbacks through g_lxp_freertos_port_config. No --wrap is needed.
{% endif %}
{% endif %}

# Trace stream (dashboard swimlane) — backend-agnostic ring + emit

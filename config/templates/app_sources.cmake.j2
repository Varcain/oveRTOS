# Auto-generated from app.yaml by oveRTOS build system — do not edit.

{% if app.lang in ['c', 'cpp'] %}
set(APP_SOURCES
{% for src in app.sources %}
    ${OVE_APP_DIR}/{{ src }}
{% endfor %}
)

set(APP_INCLUDE_DIRS
{% for inc in app.includes %}
    ${OVE_APP_DIR}/{{ inc }}
{% endfor %}
)
{% elif app.lang == 'rust' %}
set(APP_RUST_CRATE_DIR ${OVE_APP_DIR}{% if app.rust.crate_dir != '.' %}/{{ app.rust.crate_dir }}{% endif %})
set(APP_RUST_LIB_NAME "{{ app.rust.lib_name }}")

set(APP_SOURCES "")

set(APP_INCLUDE_DIRS
    ${OVE_APP_DIR}
)
{% elif app.lang == 'zig' %}
set(APP_ZIG_SRC_DIR ${OVE_APP_DIR}/{{ app.zig.src_dir }})
set(APP_ZIG_LIB_NAME "{{ app.zig.lib_name }}")

set(APP_SOURCES "")

set(APP_INCLUDE_DIRS
    ${OVE_APP_DIR}
)
{% endif %}

{% if app.c_sources is defined %}
# Companion C/C++ sources (e.g. model data for Rust/Zig apps)
set(APP_C_COMPANION_SOURCES
{% for src in app.c_sources %}
    ${OVE_APP_DIR}/{{ src }}
{% endfor %}
)
{% if app.c_includes is defined %}
set(APP_C_COMPANION_INCLUDES
{% for inc in app.c_includes %}
    ${OVE_APP_DIR}/{{ inc }}
{% endfor %}
)
{% endif %}
{% endif %}

{% if app.generated_image_sources is defined %}
# Auto-generated image data (from app.yaml `images:` key, paths absolute)
set(APP_GENERATED_IMAGE_SOURCES
{% for src in app.generated_image_sources %}
    {{ src }}
{% endfor %}
)
# Append to APP_SOURCES for C/C++ apps, APP_C_COMPANION_SOURCES for Rust/Zig.
{% if app.lang in ['c', 'cpp'] %}
list(APPEND APP_SOURCES ${APP_GENERATED_IMAGE_SOURCES})
{% else %}
if(DEFINED APP_C_COMPANION_SOURCES)
    list(APPEND APP_C_COMPANION_SOURCES ${APP_GENERATED_IMAGE_SOURCES})
else()
    set(APP_C_COMPANION_SOURCES ${APP_GENERATED_IMAGE_SOURCES})
endif()
{% endif %}
{% endif %}

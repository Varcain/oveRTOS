# Auto-generated by oveRTOS build system — do not edit.
# NuttX defconfig overlay for oveRTOS application.
# Applied on top of the NuttX board config.

{% if config.get("CONFIG_OVE_ZERO_HEAP") == True %}
# ── Zero-heap: static sizing + boot-only allocation ──
# All resources are sized at compile time; oveRTOS creates everything
# during init (ove_main), then ove_run() calls ove_heap_lock() and the
# main kmm heap stops growing — every subsequent kmm_malloc / __wrap_-
# malloc that lands after the lock is rerouted to a fixed-size BSS
# pool (CONFIG_OVE_NUTTX_ZH_RESERVED_HEAP, default 16 KiB) managed by
# backends/nuttx/nuttx_zh_reserved_heap.c.
#
# Irreducible kernel-heap consumers that have to land BEFORE the lock
# (all bounded, all init-time only):
#   - task_create / pthread_create (TCB + stack alloc per thread)
#   - mq_open(O_CREAT) in nuttx_audio.c (POSIX-required)
#   - task_tls_alloc() one-shot per slot index
#   - group_setuptaskfiles + env_dup at task spawn
#
# Post-lock consumers that are unavoidable on NuttX's POSIX socket
# layer and use the reserved pool:
#   - fs_heap_zalloc(struct file) per FD allocated in fdlist_allocate
#   - lib_malloc(struct dns_query_data_s) per DNS query
#   - lib_malloc(NETDB_BUFSIZE) in getaddrinfo
# These are why FreeRTOS+lwIP can hit pure NULL-on-trap (lwIP runs
# entirely out of BSS pools) but NuttX needs the reserved-heap
# fallback. Total RAM footprint is still bounded at compile time.
CONFIG_MM_REGIONS=1
# CONFIG_DEBUG_MM is not set
# CONFIG_MM_BACKTRACE is not set
# CONFIG_MM_DUMP_ON_FAILURE is not set
CONFIG_OVE_NUTTX_HEAP_LOCK=y

# Pre-allocated kernel resource pools — pinned via Kconfig so no run-
# time growth.  Override per-app by setting CONFIG_OVE_NUTTX_* in
# defconfig fragments.
CONFIG_MAX_TASKS={{ config.get("CONFIG_OVE_NUTTX_MAX_TASKS", 16) }}
CONFIG_NFILE_DESCRIPTORS_PER_BLOCK={{ config.get("CONFIG_OVE_NUTTX_FD_BLOCK", 8) }}
CONFIG_PREALLOC_TIMERS={{ config.get("CONFIG_OVE_NUTTX_PREALLOC_TIMERS", 8) }}
CONFIG_PREALLOC_MQ_MSGS={{ config.get("CONFIG_OVE_NUTTX_PREALLOC_MQ_MSGS", 16) }}
{% if config.get("CONFIG_OVE_NET") == True %}
CONFIG_NET_TCP_CONNS={{ config.get("CONFIG_OVE_NUTTX_TCP_CONNS", 8) }}
CONFIG_NET_UDP_CONNS={{ config.get("CONFIG_OVE_NUTTX_UDP_CONNS", 8) }}
CONFIG_IOB_NBUFFERS={{ config.get("CONFIG_OVE_NUTTX_IOB_NBUFFERS", 24) }}
CONFIG_IOB_BUFSIZE={{ config.get("CONFIG_OVE_NUTTX_IOB_BUFSIZE", 196) }}
{% endif %}
{% endif %}

# oveRTOS external app
CONFIG_EXTERNAL_OVE_APP=y
CONFIG_EXTERNAL_OVE_APP_PROGNAME="{{ config.get('CONFIG_NUTTX_PROGNAME', 'ove_app') }}"
CONFIG_EXTERNAL_OVE_APP_PRIORITY={{ config.get('CONFIG_NUTTX_PRIORITY', 100) }}
CONFIG_EXTERNAL_OVE_APP_STACKSIZE={{ config.get('CONFIG_NUTTX_STACKSIZE', 16384) }}

# Entry point
CONFIG_INIT_ENTRYPOINT="ove_app_main"

# Watchdog timer
CONFIG_WATCHDOG=y

# Inline queue functions — required for correct scheduler operation.
# Without this, NuttX uses library queue functions that can corrupt
# the scheduler linked lists (HardFault in nxsched_add_prioritized).
CONFIG_LIBC_INLINE_QUEUE=y

# Dedicated interrupt stack (ISRs must not run on tiny thread stacks)
CONFIG_ARCH_INTERRUPTSTACK=2048

# Idle thread needs enough stack for ISR nesting when no interrupt stack
CONFIG_IDLETHREAD_STACKSIZE=2048

# Stack overflow detection
CONFIG_STACK_COLORATION=y

# CPU load monitoring (for sim dashboard thread view)
CONFIG_SCHED_CPULOAD_SYSCLK=y

# Thread-local storage (needed for ove_thread_get_self)
CONFIG_TLS_NELEM=4
CONFIG_TLS_TASK_NELEM=4

# High-priority work queue (required for SIGEV_THREAD timer callbacks)
CONFIG_SCHED_HPWORK=y

# SIGEV_THREAD for safe timer callbacks (runs on HP work queue, no signals)
CONFIG_SIG_EVTHREAD=y
CONFIG_SIG_EVTHREAD_HPWORK=y

{% if config.get("CONFIG_OVE_APP_LANG_CXX") == True or config.get("CONFIG_OVE_INFER") == True %}
# C++ support (also needed for TFLite inference engine).
# Use the toolchain's full C++ standard library — the oveRTOS C++
# bindings require C++20 concepts/requires, and TFLite needs <algorithm>,
# <new>, <memory>, etc. that NuttX's minimal cxx/ doesn't provide.
CONFIG_HAVE_CXX=y
CONFIG_HAVE_CXXINITIALIZE=y
CONFIG_LIBCXXTOOLCHAIN=y
# Enable float/double support so NuttX's <cmath> declares std::acos etc.,
# matching what GCC's C++ math.h wrapper expects.
CONFIG_HAVE_FLOAT=y
CONFIG_HAVE_DOUBLE=y
{% endif %}

{% if config.get("CONFIG_OVE_BOARD_QEMU_MPS2_AN500") == True %}
# Suppress verbose scheduler debug logging on QEMU
# (mps2-an500:nsh base enables DEBUG_SCHED_INFO which floods console)
# CONFIG_DEBUG_SCHED_INFO is not set
# CONFIG_DEBUG_SCHED_WARN is not set
# CONFIG_DEBUG_SCHED is not set
{% endif %}

{% if config.get("CONFIG_OVE_AUDIO") == True %}
# Audio subsystem
CONFIG_AUDIO=y
{% endif %}

{% if config.get("CONFIG_OVE_PROFILER") == True %}
# On-target unwinder for the oveRTOS sampling profiler
# (backends/nuttx/nuttx_profiler.c invokes up_backtrace(tcb,…)).
#
# Costs we accept here that the kernel build inflicts on EVERY object:
#   - SCHED_BACKTRACE → arch/arm/Kconfig:1517-1549 enables an UNWINDER_*
#     choice with default UNWINDER_ARM, which `select FRAME_POINTER`
#     and triggers gcc.cmake:178-180 to add
#         -funwind-tables -fasynchronous-unwind-tables
#     for the whole kernel + every userspace lib (≈ 46 KB on STM32F746
#     in .ARM.exidx + .ARM.extab on a hiroic-sized image).
#   - FRAME_POINTER → gcc.cmake:122-126 then adds
#         -fno-omit-frame-pointer -fno-optimize-sibling-calls
#     globally, blocking tail-call optimization and burning one register
#     across every function (~5 % code-size penalty).
# These costs are worth it for sim profiling but pure waste on embedded
# targets where OVE_PROFILER cannot be set (it depends on OVE_SIM —
# see config/Config.in.debug:83-86), so we only emit it for sim.
CONFIG_SCHED_BACKTRACE=y
{% endif %}

{% if config.get("CONFIG_OVE_NET") == True %}
# Networking (POSIX sockets)
CONFIG_NET=y
CONFIG_NET_SOCKOPTS=y
CONFIG_NET_TCP=y
CONFIG_NET_TCP_WRITE_BUFFERS=y
CONFIG_NET_UDP=y
CONFIG_NET_ICMP=y
CONFIG_NET_ICMP_SOCKET=y
CONFIG_NET_ARP=y
CONFIG_NET_LOOPBACK=y
CONFIG_NET_STATISTICS=y
CONFIG_NSOCKET_DESCRIPTORS=16
CONFIG_NET_NACTIVESOCKETS=16
CONFIG_NET_ETH_PKTSIZE=1518
CONFIG_NETDB_DNSCLIENT=y
CONFIG_NETDB_DNSCLIENT_NAMESIZE=64
CONFIG_NETDB_DNSSERVER_IPv4=y
CONFIG_NETDB_DNSSERVER_IPv4ADDR=0x08080808
CONFIG_NETUTILS_NETLIB=y
# Board-specific netdev driver selection (e.g. CONFIG_STM32F7_ETHMAC for
# stm32f746g-discovery, CONFIG_NETDEV_LATEINIT for boards with no on-chip
# MAC) must come from boards/<board>/nuttx/ove_board_defconfig.
{% endif %}

{% if config.get("CONFIG_OVE_LVGL") == True %}
# LVGL — built externally from dl/lvgl; config via board lv_conf.h.

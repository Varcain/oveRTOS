/* Definitions that map the FreeRTOS port interrupt handlers to their CMSIS
standard names.  The SVC alias is OMITTED for the Linux personality
(CONFIG_OVE_LINUX): the personality seam (backends/freertos/freertos_lnx.c) OWNS
the SVC_Handler vector and forwards FreeRTOS's start-scheduler svc to the port's
vPortSVCHandler, so vPortSVCHandler must keep its own name (else the seam's
`b vPortSVCHandler` is an undefined reference). PendSV is untouched by the seam. */
{% if config.get("CONFIG_OVE_LINUX") != True %}
#define vPortSVCHandler SVC_Handler
{% endif %}
#define xPortPendSVHandler PendSV_Handler

{% if config.get("CONFIG_OVE_LINUX") == True and (config.get("CONFIG_OVE_BOARD_QEMU_MPS2_AN500") == True or config.get("CONFIG_OVE_BOARD_STM32F746G_DISCO") == True) %}
/* Linux guest MPU isolation (ARM_CM4_MPU port): each program runs as an
 * UNPRIVILEGED restricted task so a stray access faults instead of corrupting the
 * kernel. The corrected QEMU an500 model exposes 16 regions; the real STM32F746 exposes 8.
 * configTOTAL_MPU_REGIONS must match exactly or the port skips MPU setup. The r0p1 silicon needs
 * the errata-837070 BASEPRI workaround; QEMU's r1p2 must not enable it. */
#define configUSE_MPU_WRAPPERS_V1                       1
{% if config.get("CONFIG_OVE_BOARD_QEMU_MPS2_AN500") == True %}
#define configTOTAL_MPU_REGIONS                         16
{% else %}
#define configTOTAL_MPU_REGIONS                         8
{% endif %}
{% if config.get("CONFIG_OVE_BOARD_STM32F746G_DISCO") == True %}
#define configENABLE_ERRATA_837070_WORKAROUND           1
/* Real STM32F746 with the M7 D-cache ON (stm32f7_init.c): the port's SRAM MPU regions (task
 * stacks, the privileged-RAM region, the all-RAM region for a non-restricted task) must be Normal
 * *cacheable, non-shareable* — NOT the port default 0x07 (shareable, which the single-core M7
 * treats as NON-cacheable).  Task TCBs/stacks + the stack-overflow guard pattern are written at
 * creation through the cacheable background map (dirty in the D-cache); reading them back through a
 * non-cacheable region bypasses the cache → STALE SRAM → prvRestoreContextOfFirstTask reads a null
 * pxTopOfStack → BusFault at the start-scheduler SVC (and false "stack overflow" trips).  0x0B
 * (TEX=001,S=0,C=1,B=1 = Normal WBWA non-shareable) matches the cacheable writes, so the reads are
 * coherent with no SCB cache maintenance.  (No main-SRAM DMA in the personality: console is polled,
 * QSPI is memory-mapped, FT5336 is polled, I2S audio lives in DTCM.) */
#define configTEX_S_C_B_SRAM                            0x0B
{% else %}
#define configENABLE_ERRATA_837070_WORKAROUND           0
{% endif %}
/* Our SVC vector is the seam's strong SVC_Handler (not vPortSVCHandler), so the
 * port's handler-installation assert must be disabled or it hangs at boot. */
#define configCHECK_HANDLER_INSTALLATION                0
#define configENFORCE_SYSTEM_CALLS_FROM_KERNEL_ONLY     0
#define configALLOW_UNPRIVILEGED_CRITICAL_SECTIONS      0
{% endif %}

{% if config.get("CONFIG_OVE_BOARD_QEMU_MPS2_AN500") == True %}
/* QEMU doesn't emulate the DWT cycle counter — use a SysTick-based
 * millisecond counter instead.  Incremented from vApplicationTickHook()
 * which FreeRTOS calls on every tick (1 kHz). */
extern volatile uint32_t ove_runtime_counter_ms;
#define portCONFIGURE_TIMER_FOR_RUN_TIME_STATS() (ove_runtime_counter_ms = 0)
#define portGET_RUN_TIME_COUNTER_VALUE() ove_runtime_counter_ms
{% else %}
/* Run-time stats use the ARM DWT cycle counter for microsecond resolution */
#define portCONFIGURE_TIMER_FOR_RUN_TIME_STATS() do { \
	CoreDebug->DEMCR |= CoreDebug_DEMCR_TRCENA_Msk; \
	/* Cortex-M7: unlock DWT before writing its registers */ \
	*((volatile uint32_t *)0xE0001FB0u) = 0xC5ACCE55u; \
	DWT->CYCCNT = 0; \
	DWT->CTRL |= DWT_CTRL_CYCCNTENA_Msk; \
} while(0)
#define portGET_RUN_TIME_COUNTER_VALUE() (DWT->CYCCNT / (SystemCoreClock / 1000000U))
{% endif %}


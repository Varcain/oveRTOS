extern "C" {
#endif
void ove_freertos_runtime_counter_init(void);
uint64_t ove_freertos_runtime_counter_get(void);
#ifdef __cplusplus
}
#endif
#define portCONFIGURE_TIMER_FOR_RUN_TIME_STATS() ove_freertos_runtime_counter_init()
#define portGET_RUN_TIME_COUNTER_VALUE() ove_freertos_runtime_counter_get()
#define OVE_FREERTOS_RUNTIME_TO_US(count) ((uint64_t)(count) / (SystemCoreClock / 1000000u))
{% endif %}


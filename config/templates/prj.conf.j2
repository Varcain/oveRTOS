# Auto-generated by oveRTOS build system — do not edit.

# Unified libc — picolibc on all Zephyr targets, regardless of zero-heap
# state.  Without this hoist the non-zero-heap path inherits Zephyr's per-
# board default (newlib on most ARM boards), giving inconsistent footprint
# and printf semantics across heap/zeroheap builds.  PICOLIBC_USE_MODULE
# `depends on !GLIBCXX_LIBCPP` (Zephyr's lib/libc/picolibc/Kconfig:13-14),
# so C++ apps must use PICOLIBC_USE_TOOLCHAIN (Zephyr SDK ships picolibc).
# PICOLIBC_IO_LONG_LONG is opt-in; default is integer-only and silently
# truncates %llu/%lld to %u/%d.
CONFIG_PICOLIBC=y
CONFIG_PICOLIBC_IO_LONG_LONG=y
{% if config.get("CONFIG_OVE_APP_LANG_CXX") == True %}
CONFIG_PICOLIBC_USE_TOOLCHAIN=y
{% else %}
CONFIG_PICOLIBC_USE_MODULE=y
{% endif %}

{% if config.get("CONFIG_ZEPHYR_I2S", True) %}
# Audio
CONFIG_I2S=y
{% endif %}

{% if config.get("CONFIG_OVE_ZERO_HEAP") == True %}
# Fully static: no kernel heap, no dynamic thread pool, no libc heap.
# Block-scope ove_thread_create / ove_workqueue_create now emit
# K_THREAD_STACK_DEFINE-equivalent statics directly (see
# backends/zephyr/include/ove_storage_zephyr.h:OVE_THREAD_STACK_BLOCK_STATIC_),
# so DYNAMIC_THREAD / k_thread_stack_alloc are no longer required.
# Picolibc's printf is malloc-free, so the libc heap goes to zero too.
#
# `CONFIG_HEAP_MEM_POOL_IGNORE_MIN=y` overrides the
# `HEAP_MEM_POOL_ADD_SIZE_*` requirements that subsystems (DHCPV4, DNS,
# net_buf, …) declare via Kconfig.  Without it Zephyr's kernel/CMakeLists
# bumps `K_HEAP_MEM_POOL_SIZE` up to the sum of those requirements and
# instantiates `_system_heap` regardless of CONFIG_HEAP_MEM_POOL_SIZE — which
# fails the zero-heap kernel-allocator audit on networking apps.
CONFIG_HEAP_MEM_POOL_SIZE=0
CONFIG_HEAP_MEM_POOL_IGNORE_MIN=y
CONFIG_THREAD_STACK_INFO=y
CONFIG_THREAD_CUSTOM_DATA=y
CONFIG_MAIN_STACK_SIZE=4096
CONFIG_SYSTEM_WORKQUEUE_STACK_SIZE=2048
CONFIG_ISR_STACK_SIZE=2048
CONFIG_IDLE_STACK_SIZE=512
{% elif config.get("CONFIG_ZEPHYR_DYNAMIC_THREAD", True) %}
# Dynamic thread stacks (heap must be large enough for stacks + runtime mallocs)
CONFIG_DYNAMIC_THREAD=y
CONFIG_DYNAMIC_THREAD_ALLOC=y
CONFIG_THREAD_STACK_INFO=y
CONFIG_THREAD_CUSTOM_DATA=y
CONFIG_HEAP_MEM_POOL_SIZE={{ config.get("CONFIG_ZEPHYR_HEAP_MEM_POOL_SIZE", 65536) }}
CONFIG_MAIN_STACK_SIZE=4096
CONFIG_SYS_HEAP_RUNTIME_STATS=y
{% endif %}

{% if config.get("CONFIG_ZEPHYR_FPU", True) %}
# Hardware FPU (required for hard-float ABI and CMSIS-DSP performance)
CONFIG_FPU=y
CONFIG_FP_HARDABI=y
{% if config.get("CONFIG_OVE_LINUX_GUEST_FLOAT_ABI_HARD") == True %}
# Hard-float Linux guest: the guest uses the VFP while the coordinator (also hard-float) can
# preempt it, so give each thread its own FPU context. The Zephyr seam additionally captures the
# guest's s0-s31 + FPSCR from the extended exception frame at the svc boundary and restores it in
# the resume trampoline, covering the park/task-recreate case Zephyr's context switch cannot see.
CONFIG_FPU_SHARING=y
{% endif %}
# FPU context adds ~68 bytes per exception frame; size ISR stack accordingly
CONFIG_ISR_STACK_SIZE=4096
{% endif %}

{% if config.get("CONFIG_ZEPHYR_CMSIS_DSP", True) %}
# DSP (CMSIS-DSP FFT)
CONFIG_CMSIS_DSP=y
CONFIG_CMSIS_DSP_TRANSFORM=y
CONFIG_CMSIS_DSP_COMPLEXMATH=y
CONFIG_CMSIS_DSP_BASICMATH=y
CONFIG_CMSIS_DSP_SUPPORT=y
{% endif %}

{% if config.get("CONFIG_OVE_FS", False) and config.get("CONFIG_ZEPHYR_SD_FILESYSTEM", True) %}
# SD card / filesystem
CONFIG_DISK_ACCESS=y
CONFIG_DISK_DRIVERS=y
CONFIG_DISK_DRIVER_SDMMC=y
CONFIG_FILE_SYSTEM=y
CONFIG_FAT_FILESYSTEM_ELM=y
CONFIG_FS_FATFS_WINDOW_ALIGNMENT=32
# Never format removable media as a mount-error side effect. A missing,
# unformatted, or damaged card must fail closed and leave its contents intact.
CONFIG_FS_FATFS_MOUNT_MKFS=n
# Match the public OVE_FS_PATH_MAX contract and allow the personality's bounded
# descriptor table to use the native volume without hitting Zephyr's default
# four-file limit.
CONFIG_FS_FATFS_LFN=y
CONFIG_FS_FATFS_LFN_MODE_STACK=y
CONFIG_FS_FATFS_MAX_LFN=255
CONFIG_FS_FATFS_REENTRANT=y
CONFIG_FS_FATFS_NUM_FILES=16
CONFIG_FS_FATFS_NUM_DIRS=8
{% endif %}

{% if config.get("CONFIG_OVE_NET") == True %}
# Networking (BSD sockets) — pool counts driven by OVE_ZEPHYR_NET_* Kconfig
CONFIG_NETWORKING=y
CONFIG_NET_SOCKETS=y
# AF_INET SOCK_RAW (IPPROTO_ICMP) so the personality's raw-ICMP ping works (Z3).
CONFIG_NET_SOCKETS_INET_RAW=y
CONFIG_NET_TCP=y
CONFIG_NET_UDP=y
CONFIG_NET_IPV4=y
CONFIG_NET_IPV6=n
CONFIG_NET_ARP=y
CONFIG_NET_DHCPV4=y
CONFIG_DNS_RESOLVER=y
CONFIG_NET_MAX_CONN={{ config.get("CONFIG_OVE_ZEPHYR_NET_MAX_CONN", 16) }}
CONFIG_NET_MAX_CONTEXTS={{ config.get("CONFIG_OVE_ZEPHYR_NET_MAX_CONTEXTS", 16) }}
CONFIG_NET_PKT_RX_COUNT={{ config.get("CONFIG_OVE_ZEPHYR_NET_PKT_RX_COUNT", 14) }}
CONFIG_NET_PKT_TX_COUNT={{ config.get("CONFIG_OVE_ZEPHYR_NET_PKT_TX_COUNT", 14) }}
CONFIG_NET_BUF_RX_COUNT={{ config.get("CONFIG_OVE_ZEPHYR_NET_BUF_RX_COUNT", 36) }}
CONFIG_NET_BUF_TX_COUNT={{ config.get("CONFIG_OVE_ZEPHYR_NET_BUF_TX_COUNT", 36) }}
CONFIG_NET_MGMT=y
CONFIG_NET_MGMT_EVENT=y
CONFIG_NET_L2_ETHERNET=y
CONFIG_ETH_STM32_HAL=y
CONFIG_NET_CONTEXT_RCVTIMEO=y
CONFIG_NET_CONTEXT_SNDTIMEO=y
{% endif %}

{% if config.get("CONFIG_OVE_LINUX") == True %}
# AT_RANDOM and getrandom(2) must fail closed unless a CSPRNG is available.
CONFIG_CSPRNG_NEEDED=y
{% if get_bool("CONFIG_OVE_BOARD_STM32F746G_DISCO") %}
CONFIG_TEST_RANDOM_GENERATOR=n
CONFIG_ENTROPY_STM32_RNG=y
CONFIG_HARDWARE_DEVICE_CS_GENERATOR=y
{% else %}
# Emulator-only personality targets have no physical entropy device. Keep the
# insecure provider explicit so it cannot leak into STM32 production images.
CONFIG_TEST_RANDOM_GENERATOR=y
CONFIG_TEST_CSPRNG_GENERATOR=y
{% endif %}
{% elif config.get("CONFIG_OVE_NET") == True %}
# Non-personality network samples retain the existing test-provider policy.
CONFIG_ENTROPY_GENERATOR=y
CONFIG_TEST_RANDOM_GENERATOR=y
{% endif %}

{% if config.get("CONFIG_OVE_EVENTGROUP", False) %}
# Kernel events (for ove_eventgroup)
CONFIG_EVENTS=y
{% endif %}

{% if config.get("CONFIG_ZEPHYR_CONSOLE_SUBSYS", True) %}
# Serial input
CONFIG_CONSOLE_SUBSYS=y
CONFIG_CONSOLE_GETCHAR=y
{% endif %}

# Thread introspection (for sim dashboard thread view)
CONFIG_THREAD_NAME=y
CONFIG_THREAD_MONITOR=y
CONFIG_INIT_STACKS=y
CONFIG_THREAD_RUNTIME_STATS=y

# Logging thread needs enough stack for vfprintf-based timestamp formatting
CONFIG_LOG_PROCESS_THREAD_STACK_SIZE=2048

# Keep printk output synchronous — prevents message drops in benchmarks
CONFIG_LOG_PRINTK=n

{% if config.get("CONFIG_OVE_APP_LANG_CXX") == True or config.get("CONFIG_OVE_INFER") == True %}
# C++ support — full libstdc++ for C++20 (span, atomic, type_traits, …).
# Libc selection is at top of file — GLIBCXX_LIBCPP `select`s
# REQUIRES_FULL_LIBCPP, requiring PICOLIBC_USE_TOOLCHAIN (already set).
# Exception-throwing C++ becomes a hard failure under zero-heap (consistent
# with intent: libstdc++ exception machinery allocates).
# Enabled also when CONFIG_OVE_INFER is set: TFLM is upstream C++ that
# transitively pulls in <cstddef> / <cstdarg> / <utility> etc., so the
# inference backend builds even when the application language is C/Rust/Zig.
CONFIG_CPP=y
CONFIG_STD_CPP23=y
CONFIG_GLIBCXX_LIBCPP=y
{% endif %}

# GNU-style global static constructors — required by libstdc++ /
# picolibc and by Zephyr modules that emit C++/init-array constructors.
# Without it, ld.bfd refuses the link with "GNU-style constructors
# required but STATIC_INIT_GNU not enabled" on any C app that
# transitively pulls in such an object (DHCP/DNS/net subsystems on
# stm32f746 zephyr-zh, picolibc init paths, etc.).  Cheap when no
# constructors actually exist — just enables the linker section
# layout.
CONFIG_STATIC_INIT_GNU=y

{% if config.get("CONFIG_OVE_LVGL") == True %}
{% if config.get("CONFIG_OVE_BOARD_QEMU_MPS2_AN500") != True %}
# LVGL display (v9) — use Zephyr's display subsystem
CONFIG_LVGL=y
CONFIG_DISPLAY=y
CONFIG_STATIC_INIT_GNU=y
# Drive LVGL from the app's own graphics thread (ove_lvgl_handler -> lv_timer_handler),
# matching the FreeRTOS/NuttX seams — NOT Zephyr's system workqueue.  The workqueue path
# rendered but never advanced periodic lv_timers (the benchmark's scene-change timer stuck
# on frame 0); the app thread has a 16 KB stack and is the sole lv_timer_handler caller.
CONFIG_LV_Z_RUN_LVGL_ON_WORKQUEUE=n
CONFIG_LV_Z_LVGL_MUTEX=y
# 16-bit RGB565 to match the STM32F746 panel (and the FreeRTOS/NuttX native build,
# lv_conf_stm32f746g_discovery.h LV_COLOR_DEPTH 16).  At 24-bit the opacity-layer
# benchmark scene allocates a layer buffer too large for the LVGL heap and tiles/
# thrashes (scene stuck), plus every flush pays a 24->16 conversion for the panel.
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_32=y
{% if config.get("CONFIG_OVE_ZERO_HEAP") == True %}
CONFIG_LV_Z_MEM_POOL_SIZE=16384
{% else %}
CONFIG_LV_Z_MEM_POOL_SIZE={{ config.get("CONFIG_ZEPHYR_LV_MEM_POOL_SIZE", 16384) }}
{% endif %}
CONFIG_LV_USE_OBSERVER=y
CONFIG_LV_USE_FLEX=y
# Perf monitor — mirror the native global LVGL config (include/ove/lv_conf_common.h sets
# LV_USE_SYSMON / LV_USE_PERF_MONITOR / *_LOG_MODE all on).  lvgl_benchmark accumulates
# per-scene FPS by observing the sysmon perf subject; without SYSMON the whole path is
# compiled out (LV_USE_PERF_MONITOR forced 0) and every scene reports N/A.  Zephyr configures
# LVGL via Kconfig, not lv_conf.h, so wire the same globals here.  LOG_MODE routes perf to the
# log instead of an on-screen overlay, so the measured render cost matches the native build.
CONFIG_LV_USE_SYSMON=y
CONFIG_LV_USE_PERF_MONITOR=y
CONFIG_LV_USE_PERF_MONITOR_LOG_MODE=y
{% endif %}
{% endif %}

{% if config.get("CONFIG_OVE_LINUX") == True %}
# Linux personality (Cortex-M): run a loaded program unprivileged and trap its
# svc. CONFIG_USERSPACE gives unprivileged user threads + MPU memory domains;
# CONFIG_EXTRA_EXCEPTION_INFO populates the callee-saved register the seam reads
# (r7 = the Linux syscall number) on Armv8-M. THREAD_CUSTOM_DATA backs the
# ove_thread handle slot.
CONFIG_USERSPACE=y
CONFIG_EXTRA_EXCEPTION_INFO=y
CONFIG_THREAD_CUSTOM_DATA=y
# Zephyr decodes an Arm fault and writes a long register dump before the
# personality's fatal-error hook can contain an unprivileged guest. Route those
# prints through the seam: it discards only guest-fault output (the coordinator
# emits one compact record) and forwards privileged/kernel faults to printk.
CONFIG_EXCEPTION_DUMP_HOOK=y
CONFIG_EXCEPTION_DUMP_HOOK_ONLY=y
# Scheduling contract. All values are PREEMPTIBLE priorities (non-negative):
# scope critical=0, coordinator/main=3, Ethernet RX=4, network TC=5,
# Linux guest=6, system workqueue=7. This keeps guest/network saturation below
# the real-time task and prevents a cooperative infrastructure thread from
# monopolising the CPU. Keep in sync with ove_zephyr_priority.h.
CONFIG_MAIN_THREAD_PRIORITY=3
CONFIG_SYSTEM_WORKQUEUE_PRIORITY=7
{% if config.get("CONFIG_OVE_NET") == True %}
CONFIG_NET_TC_THREAD_PREEMPTIVE=y
CONFIG_NET_TC_THREAD_PRIO_CUSTOM=y
CONFIG_NET_TC_TX_THREAD_BASE_PRIO=5
CONFIG_NET_TC_RX_THREAD_BASE_PRIO=5
{% if get_bool("CONFIG_OVE_BOARD_STM32F746G_DISCO") %}
CONFIG_ETH_STM32_HAL_RX_THREAD_PREEMPTIVE=y
CONFIG_ETH_STM32_HAL_RX_THREAD_PRIO=4
{% endif %}
{% endif %}
# W^X holds for every program. Rootfs code executes from a shared RX mapping;
# remote code uses a rounded RO+X prefix over the full RW+XN program region.
# Keep Zephyr's own domain-policy enforcement enabled for every profile.
CONFIG_EXECUTE_XOR_WRITE=y
# The USERSPACE thread-id bitmap must cover every k_thread kobject: the NSLOT program slots
# (NREG+4) + the kernel's own threads + the board's driver threads. On the real STM32F746 with
# NREG bumped to 10 (LXP_NREG, for SSH-session process depth) that total reaches 25, needing 4
# bytes (32 slots). gen_kobject_list.py hard-errors ("Too many thread objects") if it's too small;
# 4 is harmless for the an521 (fewer threads).
CONFIG_MAX_THREAD_BYTES=4
# Keep native round-robin disabled for the personality. On Zephyr 4.4 its
# per-CPU slice-timeout reset can reinsert a zero-delta timeout while tickless
# sys_clock_announce() drains elapsed ticks, locking STM32 under frequent guest
# park/resume. The LXP seam instead accounts only priority-6 guests in a bounded
# timer callback and wakes a priority-5 seam thread to rotate an expired guest
# in thread context. Coordinator and host RT priorities 0..4 remain immediately
# preemptive and unrelated equal-priority work is unaffected.
CONFIG_TIMESLICING=n
# Real STM32F746: enable the FMC memory controller so the external SDRAM (which hosts the
# program-image pool) is brought up at boot. The upstream board only pulls MEMC in via the LTDC
# display, which the headless personality disables — so enable it explicitly. No-op on the an521.
CONFIG_MEMC=y
# Headless personality: drop the board's app drivers (display/audio/SD) — the personality uses none
# of them and they cost RAM, flash, and USERSPACE thread-id slots. No-ops on boards without them.
CONFIG_DISPLAY=n
CONFIG_AUDIO=n
CONFIG_AUDIO_CODEC=n
CONFIG_I2S=n
CONFIG_DISK_ACCESS=n
CONFIG_DISK_DRIVERS=n
# Drop Zephyr's logging subsystem. The personality drives its own USART1 console (serial_wrapper.c),
# so Zephyr's LOG only emits driver INFO noise (QSPI SFDP, PHY id) that competes with it on the same
# UART. It also costs SRAM (the deferred log buffer + the log-process thread + its stack) on a board
# whose 256 KB SRAM is already full once the net stack lands, AND its deferred %s packaging faults
# during a fault-dump LOG_PANIC flush (a runtime string pointer in the package derefs to a wild
# address -> a precise BusFault that masks the real dump). No-op where LOG was already off.
CONFIG_LOG=n
{% if get_bool("CONFIG_OVE_BOARD_STM32F746G_DISCO") %}
# Real STM32F746 (M7, PMSAv7 — only 8 MPU regions): the guest needs three domain partitions
# (libc TLS + image + dynamic arena) in addition to its K_USER stack. The board-specific static
# regions leave no room for all three while the supervisor stack guard also owns an MPU slot.
# Dropping that guard reclaims the required region. MPU_STACK_GUARD is selected by
# ARM_STACK_PROTECTION (default y if HW_STACK_PROTECTION), so a bare CONFIG_MPU_STACK_GUARD=n is
# overridden — disable the parent HW_STACK_PROTECTION. The program's OWN overflow protection is
# intact (a user thread faults out of its domain region); this only drops overflow detection for
# trusted framework threads. Board-gated so the QEMU an521 (with MPU headroom to spare) keeps it.
CONFIG_HW_STACK_PROTECTION=n
# With that supervisor stack guard off, an ISR/MSP-stack overflow is SILENT. The personality runs
# each UNPRIVILEGED program's `svc #0` syscall dispatch in Handler mode on the ISR stack
# (z_interrupt_stacks). lxp_dispatch's path resolution is deep and uses several
# nested 256-byte path buffers, and with CONFIG_FPU every exception frame is extended (~68 B more).
# The default 4096 overflows on path-heavy syscalls (an `ls -l` loop resets in ~1 command; lvbench's
# shallow /dev/fb0 writes survive ~2 runs) -> it corrupts kernel SRAM -> a wild return into
# sh_exit's SYSRESETREQ -> a silent reset with NO fault dump (a deliberate reset, not a CPU fault,
# so z_fatal_error never runs). Size the ISR stack for it — FREE on the tight 8-region MPU budget:
# it lives in the static kernel-SRAM region, so it costs zero MPU regions, unlike re-enabling the
# guard. Found via on-target GDB (reset at z_arm_reset, no dump, current=lnx2, CFSR=0). The 256 KB
# on-chip SRAM is nearly full, so free the room for this from the k_heap pool below (the personality
# keeps its real pools in SDRAM, so a small Zephyr k_heap is ample) rather than growing SRAM use.
CONFIG_ISR_STACK_SIZE=12288
# k_heap: the personality keeps its real pools in SDRAM and the net stack's declared heap floor is
# tiny (HEAP_MEM_POOL_ADD_SIZE_GETADDRINFO=280 B; net_pkt/net_buf use slabs, not the heap; guest
# mallocs live in the SDRAM dyn pools), and the on-target audit shows peak_used=0 — so 8 KB is
# ample. It was 24 KB; the reclaimed 16 KB funds LXP_NREG=10 (its extra per-slot g_lxp_proc /
# tramp-stack / domain state is SRAM-resident), keeping the 256 KB budget net-neutral.
CONFIG_HEAP_MEM_POOL_SIZE=8192
# Every STM32 Linux-personality profile XIPs its rootfs from the on-board N25Q at 0x90000000.
# The common ove-linux.overlay enables and retypes the QSPI window; keep its driver and
# memory-mapped mode independent of framebuffer support so headless Minimal can boot too.
CONFIG_FLASH=y
CONFIG_FLASH_STM32_QSPI=y
CONFIG_STM32_MEMMAP=y
{% if get_bool("CONFIG_OVE_FB") %}
# lvbench on the panel: re-enable the LTDC display over the headless CONFIG_DISPLAY=n above.
# The ove-linux-fb.overlay re-enables the display nodes and applies display-active FMC timing.
CONFIG_DISPLAY=y
CONFIG_STM32_LTDC=y
CONFIG_STM32_LTDC_RGB565=y
CONFIG_STM32_LTDC_FB_NUM=1
{% endif %}
# Enable the Cortex-M7 I-cache. Zephyr's stm32f7 soc init calls sys_cache_instr_enable() /
# sys_cache_data_enable(), but both are no-ops unless CONFIG_CACHE_MANAGEMENT is set — so the M7
# boots with caches OFF and the guest program (text XIP'd from an embedded flash CPIO or QSPI NOR)
# runs fully uncached, ~3.5x slower than the I-cached FreeRTOS/NuttX personalities. Turning cache
# management on lets the I-cache cover that XIP program text.
CONFIG_CACHE_MANAGEMENT=y
# Enable the D-cache for the Linux personality. The program pool + framebuffer live in FMC SDRAM; the
# guest maps its pool WBWA-cacheable NON-shareable (OVE_MEM_PART_RW_CACHE), the SAME attribute the
# privileged run loop sees through the devicetree sdram1 ATTR_MPU_RAM region appended by
# CONFIG_MEM_ATTR after Zephyr's compiled flash/internal-SRAM regions. Coordinator<->guest is
# coherent through one cache on this single core; /dev/fb0 separately cleans the framebuffer on
# present for the LTDC DMA. NON-shareable avoids the shareable-Normal FMC precise-BusFault that kept
# the D-cache off before. Enabling it halves guest render time: the LVGL draw buffer + fonts/rodata
# XIP'd from the QSPI NOR are now D-cached. Board-gated; an521/QEMU has no cache model.
CONFIG_DCACHE=y
{% endif %}
{% endif %}

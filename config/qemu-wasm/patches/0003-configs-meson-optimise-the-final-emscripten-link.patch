From: oveRTOS
Subject: [PATCH] configs/meson: optimise the final Emscripten link

The Emscripten cross file replaces the link arguments that configure
generates.  It supplies no optimisation flag, so emcc links the emulator
at -O0, which skips Binaryen's standard optimisation passes and leaves
Emscripten assertions enabled.

Link at -O2 to roughly halve both qemu-system-arm.wasm (26.4 to 13.8 MB)
and the JS glue (622 to 319 KB).  Timed in headless Chromium, the
FreeRTOS Linux personality reached its login prompt 20% sooner (11.8
to 9.4 s) and cut a shell loop's time by 19% (28.2 to 22.8 s).  Linking
at -O3 was only about 3% faster still.

---
--- a/configs/meson/emscripten.txt
+++ b/configs/meson/emscripten.txt
@@ -4,8 +4,8 @@
 objc_args = ['-pthread']
 # -sPROXY_TO_PTHREAD link time flag always requires -pthread even during
 # configuration so explicitly add the flag here.
-c_link_args = ['-pthread','-sASYNCIFY=1','-sPROXY_TO_PTHREAD=1','-sFORCE_FILESYSTEM','-sALLOW_TABLE_GROWTH','-sTOTAL_MEMORY=2GB','-sWASM_BIGINT','-sEXPORT_ES6=1','-sASYNCIFY_IMPORTS=ffi_call_js','-sEXPORTED_RUNTIME_METHODS=addFunction,removeFunction,TTY,FS']
-cpp_link_args = ['-pthread','-sASYNCIFY=1','-sPROXY_TO_PTHREAD=1','-sFORCE_FILESYSTEM','-sALLOW_TABLE_GROWTH','-sTOTAL_MEMORY=2GB','-sWASM_BIGINT','-sEXPORT_ES6=1','-sASYNCIFY_IMPORTS=ffi_call_js','-sEXPORTED_RUNTIME_METHODS=addFunction,removeFunction,TTY,FS']
+c_link_args = ['-O2','-pthread','-sASYNCIFY=1','-sPROXY_TO_PTHREAD=1','-sFORCE_FILESYSTEM','-sALLOW_TABLE_GROWTH','-sTOTAL_MEMORY=2GB','-sWASM_BIGINT','-sEXPORT_ES6=1','-sASYNCIFY_IMPORTS=ffi_call_js','-sEXPORTED_RUNTIME_METHODS=addFunction,removeFunction,TTY,FS']
+cpp_link_args = ['-O2','-pthread','-sASYNCIFY=1','-sPROXY_TO_PTHREAD=1','-sFORCE_FILESYSTEM','-sALLOW_TABLE_GROWTH','-sTOTAL_MEMORY=2GB','-sWASM_BIGINT','-sEXPORT_ES6=1','-sASYNCIFY_IMPORTS=ffi_call_js','-sEXPORTED_RUNTIME_METHODS=addFunction,removeFunction,TTY,FS']
 
 [project options]
 # Workaround for failure to find glib-2.0 when building idef parser,

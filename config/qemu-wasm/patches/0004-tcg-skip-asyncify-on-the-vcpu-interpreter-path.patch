From: oveRTOS
Subject: [PATCH] tcg: skip Asyncify on the vCPU interpreter path

Asyncify instruments the vCPU's TCG interpreter path.  Exclude the 28
functions there that Asyncify would otherwise instrument directly: the
interpreter loop, translator, softmmu/TLB lookup, interrupt entry, TB
hash table and a few helpers.  They run on vCPU threads.  Main-thread RAM
writes can also reach TB invalidation and its hash-table locking path;
in the shipped configuration these update TB and dirty-page metadata
synchronously, without switching coroutines.  In headless Chromium this
cut the median shell-loop wall time by 17% (22.4 to 18.6 s) and time to
login from 9.3 to 7.6 s.

A helper called through ffi_call_js could reach a coroutine switch.  In
the shipped headless configuration with MEMFS and no block devices,
nothing on a vCPU thread enters or yields a coroutine.  Abort if one
ever does, before a fiber swap can corrupt execution.  The check calls
qemu_in_vcpu_thread() out of line, so a pooled coroutine that resumes on
another thread reads that thread's state; tools without vCPUs get a stub
that returns false.

---
--- a/configs/meson/emscripten.txt
+++ b/configs/meson/emscripten.txt
@@ -4,8 +4,8 @@
 objc_args = ['-pthread']
 # -sPROXY_TO_PTHREAD link time flag always requires -pthread even during
 # configuration so explicitly add the flag here.
-c_link_args = ['-O2','-pthread','-sASYNCIFY=1','-sPROXY_TO_PTHREAD=1','-sFORCE_FILESYSTEM','-sALLOW_TABLE_GROWTH','-sTOTAL_MEMORY=2GB','-sWASM_BIGINT','-sEXPORT_ES6=1','-sASYNCIFY_IMPORTS=ffi_call_js','-sEXPORTED_RUNTIME_METHODS=addFunction,removeFunction,TTY,FS']
-cpp_link_args = ['-O2','-pthread','-sASYNCIFY=1','-sPROXY_TO_PTHREAD=1','-sFORCE_FILESYSTEM','-sALLOW_TABLE_GROWTH','-sTOTAL_MEMORY=2GB','-sWASM_BIGINT','-sEXPORT_ES6=1','-sASYNCIFY_IMPORTS=ffi_call_js','-sEXPORTED_RUNTIME_METHODS=addFunction,removeFunction,TTY,FS']
+c_link_args = ['-O2','-sASYNCIFY_REMOVE=["arm_cpu_do_interrupt","arm_cpu_exec_interrupt","arm_translate_code","arm_v7m_cpu_exec_interrupt","atomic_mmu_lookup","cpu_exec_loop","cpu_tb_exec","do_ldst","do_ldst_sg","do_ldst_sg_imm","helper_access_check_cp_reg","helper_cpsr_write_eret","helper_get_cp_reg","helper_get_cp_reg64","helper_lookup_tb_ptr","helper_set_cp_reg","helper_set_cp_reg64","mmu_lookup","mmu_lookup1","probe_access_internal","qht_insert","qht_insert__locked","qht_lock","qht_lookup_custom","tb_gen_code","tb_invalidate_phys_page_range__locked","tlb_fill_align","tlb_set_page_full"]','-pthread','-sASYNCIFY=1','-sPROXY_TO_PTHREAD=1','-sFORCE_FILESYSTEM','-sALLOW_TABLE_GROWTH','-sTOTAL_MEMORY=2GB','-sWASM_BIGINT','-sEXPORT_ES6=1','-sASYNCIFY_IMPORTS=ffi_call_js','-sEXPORTED_RUNTIME_METHODS=addFunction,removeFunction,TTY,FS']
+cpp_link_args = ['-O2','-sASYNCIFY_REMOVE=["arm_cpu_do_interrupt","arm_cpu_exec_interrupt","arm_translate_code","arm_v7m_cpu_exec_interrupt","atomic_mmu_lookup","cpu_exec_loop","cpu_tb_exec","do_ldst","do_ldst_sg","do_ldst_sg_imm","helper_access_check_cp_reg","helper_cpsr_write_eret","helper_get_cp_reg","helper_get_cp_reg64","helper_lookup_tb_ptr","helper_set_cp_reg","helper_set_cp_reg64","mmu_lookup","mmu_lookup1","probe_access_internal","qht_insert","qht_insert__locked","qht_lock","qht_lookup_custom","tb_gen_code","tb_invalidate_phys_page_range__locked","tlb_fill_align","tlb_set_page_full"]','-pthread','-sASYNCIFY=1','-sPROXY_TO_PTHREAD=1','-sFORCE_FILESYSTEM','-sALLOW_TABLE_GROWTH','-sTOTAL_MEMORY=2GB','-sWASM_BIGINT','-sEXPORT_ES6=1','-sASYNCIFY_IMPORTS=ffi_call_js','-sEXPORTED_RUNTIME_METHODS=addFunction,removeFunction,TTY,FS']
 
 [project options]
 # Workaround for failure to find glib-2.0 when building idef parser,
--- a/util/coroutine-wasm.c
+++ b/util/coroutine-wasm.c
@@ -22,6 +22,8 @@
 #include "qemu/osdep.h"
 #include "qemu/coroutine_int.h"
 #include "qemu/coroutine-tls.h"
+#include "qemu/error-report.h"
+#include "system/cpus.h"
 
 #include <emscripten/fiber.h>
 
@@ -88,6 +90,16 @@
     CoroutineEmscripten *from = DO_UPCAST(CoroutineEmscripten, base, from_);
     CoroutineEmscripten *to = DO_UPCAST(CoroutineEmscripten, base, to_);
 
+    /*
+     * ASYNCIFY_REMOVE skips vCPU interpreter frames.  Abort before a
+     * fiber swap with one of those frames live can corrupt execution.
+     */
+    if (qemu_in_vcpu_thread()) {
+        error_report("coroutine switch on a vCPU thread: the vCPU "
+                     "path is excluded from Asyncify (ASYNCIFY_REMOVE)");
+        abort();
+    }
+
     set_current(to_);
     to->action = action;
     emscripten_fiber_swap(&from->fiber, &to->fiber);
--- a/stubs/iothread-lock.c
+++ b/stubs/iothread-lock.c
@@ -1,5 +1,6 @@
 #include "qemu/osdep.h"
 #include "qemu/main-loop.h"
+#include "system/cpus.h"
 
 static bool bql_is_locked = false;
 static uint32_t bql_unlock_blocked;
@@ -43,3 +44,8 @@
 void bql_update_status(bool locked)
 {
 }
+
+bool qemu_in_vcpu_thread(void)
+{
+    return false;
+}

From: oveRTOS
Subject: [PATCH] accel/tcg: learn MMIO TB splits

QEMU exits and replays an MMIO access in a one-instruction TB each time
the access occurs before the end of its TB. In the browser, each exit
raises a JavaScript exception.
On a single vCPU without icount, remember where a TB first replayed,
retire it and end its next translation at that access. The four-way hint
table never evicts entries, so two hot TBs cannot evict each other and
force repeated translation. The discovering execution keeps its replay.
Learned TBs never chain directly to a successor because a device access,
such as a CCR write, can change the CPU flags used to translate it.

On the FreeRTOS AN500 Linux bundle, native rewinds fell from 1,091,727
to 124 over login and a 3,000-step shell loop. Browser loop times fell
from 21.8-27.3 s to 16.6-20.2 s over three interleaved rounds. Completed
lvbench redraws rose from 123-179 to 190-203 over two rounds.

---
--- a/accel/tcg/translate-all.c
+++ b/accel/tcg/translate-all.c
@@ -37,6 +37,9 @@
 #include "internal-common.h"
 #include "tcg/perf.h"
 #include "tcg/insn-start-words.h"
+#ifndef CONFIG_USER_ONLY
+#include "hw/core/boards.h"
+#endif
 
 TBContext tb_ctx;
 
@@ -170,15 +173,17 @@
 /*
  * The cpu state corresponding to 'host_pc' is restored in
  * preparation for exiting the TB.
+ * Return the number of instructions left in the TB, including the current
+ * instruction, or a negative value if host_pc is outside the TB.
  */
-void cpu_restore_state_from_tb(CPUState *cpu, TranslationBlock *tb,
-                               uintptr_t host_pc)
+int cpu_restore_state_from_tb(CPUState *cpu, TranslationBlock *tb,
+                              uintptr_t host_pc)
 {
     uint64_t data[INSN_START_WORDS];
     int insns_left = cpu_unwind_data_from_tb(tb, host_pc, data);
 
     if (insns_left < 0) {
-        return;
+        return insns_left;
     }
 
     if (tb_cflags(tb) & CF_USE_ICOUNT) {
@@ -191,6 +196,7 @@
     }
 
     cpu->cc->tcg_ops->restore_state_to_opc(cpu, tb, data);
+    return insns_left;
 }
 
 bool cpu_restore_state(CPUState *cpu, uintptr_t host_pc)
@@ -226,9 +232,53 @@
     return false;
 }
 
+#ifndef CONFIG_USER_ONLY
+typedef struct SplitHint {
+    tb_page_addr_t addr;
+    uint64_t cs_base;
+    uint32_t flags, cflags;
+    int cap;
+} SplitHint;
+
+static SplitHint split_hints[1024];
+static bool split_enabled;
+
+#define SPLIT_WAYS 4
+
+/* The first set entry with this key, else the first free one, else NULL. */
+static SplitHint *split_slot(tb_page_addr_t addr, uint64_t cs_base,
+                             uint32_t flags, uint32_t cflags)
+{
+    unsigned hash = tb_hash_func(addr, 0, flags, cs_base, cflags);
+    SplitHint *set = &split_hints[hash % (ARRAY_SIZE(split_hints) / SPLIT_WAYS)
+                                  * SPLIT_WAYS];
+    SplitHint *free = NULL;
+
+    for (int i = 0; i < SPLIT_WAYS; i++) {
+        if (!set[i].cap) {
+            free = free ? free : &set[i];
+        } else if (set[i].addr == addr && set[i].cs_base == cs_base &&
+                   set[i].flags == flags && set[i].cflags == cflags) {
+            return &set[i];
+        }
+    }
+    return free;
+}
+
+void tb_clear_split_hints(void)
+{
+    if (split_enabled) {
+        memset(split_hints, 0, sizeof(split_hints));
+    }
+}
+#endif
+
 void page_init(void)
 {
     page_table_config_init();
+#ifndef CONFIG_USER_ONLY
+    split_enabled = current_machine->smp.max_cpus == 1 && !icount_enabled();
+#endif
 }
 
 /*
@@ -266,6 +316,9 @@
     tcg_insn_unit *gen_code_buf;
     int gen_code_size, search_size, max_insns;
     int64_t ti;
+#ifndef CONFIG_USER_ONLY
+    bool mmio_split = false;
+#endif
     void *host_pc;
 
     assert_memory_lock();
@@ -283,6 +336,17 @@
         max_insns = TCG_MAX_INSNS;
     }
     QEMU_BUILD_BUG_ON(CF_COUNT_MASK + 1 != TCG_MAX_INSNS);
+
+#ifndef CONFIG_USER_ONLY
+    if (split_enabled && phys_pc != -1) {
+        SplitHint *h = split_slot(phys_pc, s.cs_base, s.flags, s.cflags);
+
+        if (h && h->cap && h->cap < max_insns) {
+            max_insns = h->cap;
+            mmio_split = true;
+        }
+    }
+#endif
 
  buffer_overflow:
     assert_no_pages_locked();
@@ -314,6 +378,10 @@
     if (phys_pc != -1) {
         tb_lock_page0(phys_pc);
     }
+
+#ifndef CONFIG_USER_ONLY
+    tb->mmio_split = mmio_split;
+#endif
 
     tcg_ctx->gen_tb = tb;
     tcg_ctx->guest_mo = cpu->cc->tcg_ops->guest_default_memory_order;
@@ -576,14 +644,15 @@
 {
     TranslationBlock *tb;
     const CPUClass *cc = cpu->cc;
-    uint32_t n;
+    uint32_t n, cf;
+    int insns_left;
 
     tb = tcg_tb_lookup(retaddr);
     if (!tb) {
         cpu_abort(cpu, "cpu_io_recompile: could not find TB for pc=%p",
                   (void *)retaddr);
     }
-    cpu_restore_state_from_tb(cpu, tb, retaddr);
+    insns_left = cpu_restore_state_from_tb(cpu, tb, retaddr);
 
     /*
      * Some guests must re-execute the branch when re-executing a delay
@@ -604,7 +673,25 @@
      * double instrument the instruction. Also don't let an IRQ sneak
      * in before we execute it.
      */
-    cpu->cflags_next_tb = curr_cflags(cpu) | CF_MEMI_ONLY | CF_NOIRQ | n;
+    cf = curr_cflags(cpu);
+    cpu->cflags_next_tb = cf | CF_MEMI_ONLY | CF_NOIRQ | n;
+
+    if (split_enabled && insns_left > 1 && insns_left <= tb->icount &&
+        tb_page_addr0(tb) != -1 && tb_page_addr1(tb) == -1 &&
+        tb_cflags(tb) == cf) {
+        tb_page_addr_t addr = tb_page_addr0(tb);
+        int cap = tb->icount - insns_left + 1;
+        SplitHint *h = split_slot(addr, tb->cs_base, tb->flags, cf);
+
+        if (h) {
+            if (h->cap) {
+                h->cap = MIN(cap, h->cap);
+            } else {
+                *h = (SplitHint){ addr, tb->cs_base, tb->flags, cf, cap };
+            }
+            tb_phys_invalidate(tb, -1);
+        }
+    }
 
     if (qemu_loglevel_mask(CPU_LOG_EXEC)) {
         vaddr pc = cpu->cc->get_pc(cpu);
--- a/accel/tcg/internal-common.h
+++ b/accel/tcg/internal-common.h

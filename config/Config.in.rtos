menu "RTOS Selection"

choice
    prompt "RTOS backend"

config OVE_RTOS_FREERTOS
    bool "FreeRTOS"
    help
      Use FreeRTOS via STM32CubeF7 SDK.

config OVE_RTOS_ZEPHYR
    bool "Zephyr RTOS"
    help
      Use the Zephyr Project RTOS.

config OVE_RTOS_NUTTX
    bool "Apache NuttX"
    help
      Use the Apache NuttX RTOS.

config OVE_RTOS_POSIX
    bool "POSIX (native host)"
    help
      Run natively on Linux/macOS using POSIX threads for
      display, input, and audio. No cross-compilation needed.

endchoice

# ==========================================================================
# FreeRTOS
# ==========================================================================
menu "FreeRTOS"
    visible if OVE_RTOS_FREERTOS

    choice FREERTOS_SOURCE_METHOD
        prompt "Source method"
        default FREERTOS_SOURCE_GIT

    config FREERTOS_SOURCE_GIT
        bool "Git repository"
    config FREERTOS_SOURCE_TARBALL
        bool "Tarball download"
    config FREERTOS_SOURCE_LOCAL
        bool "Local directory"
    endchoice

    config FREERTOS_TARBALL_URL
        string "Tarball URL"
        depends on FREERTOS_SOURCE_TARBALL

    config FREERTOS_LOCAL_PATH
        string "Local path"
        depends on FREERTOS_SOURCE_LOCAL

    comment "Git URLs and versions are controlled by manifest.yaml"
        depends on FREERTOS_SOURCE_GIT

    menu "Kernel Configuration"
        config FREERTOS_USE_PREEMPTION
            bool "Preemptive scheduling"
            default y

        config FREERTOS_TICK_RATE_HZ
            int "Tick rate (Hz)"
            default 1000

        config FREERTOS_MAX_PRIORITIES
            int "Max priorities"
            default 12

        config FREERTOS_MINIMAL_STACK_SIZE
            int "Minimal stack size (words)"
            default 128

        config FREERTOS_TOTAL_HEAP_SIZE
            int "Total heap size (bytes)"
            default 65536

        config FREERTOS_MAX_TASK_NAME_LEN
            int "Max task name length"
            default 16

        config FREERTOS_CHECK_FOR_STACK_OVERFLOW
            int "Stack overflow check level (0-2)"
            default 2
            range 0 2

        config FREERTOS_GENERATE_RUN_TIME_STATS
            bool "Generate run-time stats"
            default y

        config FREERTOS_USE_TIMERS
            bool "Software timers"
            default y

        config FREERTOS_TIMER_TASK_PRIORITY
            int "Timer task priority"
            default 4
            depends on FREERTOS_USE_TIMERS

        config FREERTOS_TIMER_QUEUE_LENGTH
            int "Timer queue length"
            default 10
            depends on FREERTOS_USE_TIMERS

        config FREERTOS_TIMER_TASK_STACK_DEPTH
            int "Timer task stack depth"
            default 128
            depends on FREERTOS_USE_TIMERS

        config FREERTOS_PRIO_BITS
            int "NVIC priority bits"
            default 4

        config FREERTOS_LOWEST_INTERRUPT_PRIORITY
            hex "Lowest interrupt priority"
            default 0xf

        config FREERTOS_MAX_SYSCALL_INTERRUPT_PRIORITY
            int "Max syscall interrupt priority"
            default 5

        menu "API Includes"
            config FREERTOS_INCLUDE_vTaskPrioritySet
                bool "vTaskPrioritySet"
                default y

            config FREERTOS_INCLUDE_uxTaskPriorityGet
                bool "uxTaskPriorityGet"
                default y

            config FREERTOS_INCLUDE_vTaskDelete
                bool "vTaskDelete"
                default y

            config FREERTOS_INCLUDE_vTaskSuspend
                bool "vTaskSuspend"
                default y

            config FREERTOS_INCLUDE_vTaskDelay
                bool "vTaskDelay"
                default y

            config FREERTOS_INCLUDE_xTaskGetSchedulerState
                bool "xTaskGetSchedulerState"
                default y

            config FREERTOS_INCLUDE_uxTaskGetStackHighWaterMark
                bool "uxTaskGetStackHighWaterMark"
                default y

            config FREERTOS_INCLUDE_xTimerPendFunctionCall
                bool "xTimerPendFunctionCall"
                default y

            config FREERTOS_INCLUDE_eTaskGetState
                bool "eTaskGetState"
                default y
        endmenu
    endmenu
endmenu

# ==========================================================================
# Zephyr
# ==========================================================================
menu "Zephyr"
    visible if OVE_RTOS_ZEPHYR

    choice ZEPHYR_SOURCE_METHOD
        prompt "Source method"
        default ZEPHYR_SOURCE_WEST

    config ZEPHYR_SOURCE_WEST
        bool "West workspace (recommended)"
    config ZEPHYR_SOURCE_LOCAL
        bool "Local Zephyr installation"
    endchoice

    config ZEPHYR_LOCAL_PATH
        string "Local Zephyr base path"
        depends on ZEPHYR_SOURCE_LOCAL

    comment "West manifest URL and revision are controlled by manifest.yaml"
        depends on ZEPHYR_SOURCE_WEST

    menu "Kernel Configuration"
        config ZEPHYR_HEAP_MEM_POOL_SIZE
            int "Heap memory pool size (bytes)"
            default 65536

        config ZEPHYR_DYNAMIC_THREAD
            bool "Enable dynamic threads"
            default y

        config ZEPHYR_I2S
            bool "Enable I2S audio"
            default y

        config ZEPHYR_CMSIS_DSP
            bool "Enable CMSIS-DSP"
            default y

        config ZEPHYR_SD_FILESYSTEM
            bool "Enable SD card filesystem"
            default y

        config ZEPHYR_CONSOLE_SUBSYS
            bool "Enable console subsystem"
            default y

        config ZEPHYR_LVGL
            bool "Enable LVGL display"
            default y

        config ZEPHYR_LV_MEM_POOL_SIZE
            int "LVGL memory pool size"
            default 16384
            depends on ZEPHYR_LVGL

        comment "--- For advanced Zephyr kernel config, run: make zephyr-menuconfig ---"
    endmenu
endmenu

# ==========================================================================
# NuttX
# ==========================================================================
menu "NuttX"
    visible if OVE_RTOS_NUTTX

    choice NUTTX_SOURCE_METHOD
        prompt "Source method"
        default NUTTX_SOURCE_GIT

    config NUTTX_SOURCE_GIT
        bool "Git repository"
    config NUTTX_SOURCE_LOCAL
        bool "Local directory"
    endchoice

    config NUTTX_LOCAL_PATH
        string "Local NuttX path"
        depends on NUTTX_SOURCE_LOCAL

    comment "Git URLs and versions are controlled by manifest.yaml"
        depends on NUTTX_SOURCE_GIT

    menu "Kernel Configuration"
        config NUTTX_PROGNAME
            string "Program name"
            default "ove_app"

        config NUTTX_PRIORITY
            int "Task priority"
            default 100

        config NUTTX_STACKSIZE
            int "Stack size"
            default 8192

        comment "--- For advanced NuttX kernel config, run: make nuttx-menuconfig ---"
    endmenu
endmenu

# ==========================================================================
# POSIX
# ==========================================================================
menu "POSIX"
    visible if OVE_RTOS_POSIX

    config POSIX_DISPLAY_WIDTH
        int "Window width (pixels)"
        default 480

    config POSIX_DISPLAY_HEIGHT
        int "Window height (pixels)"
        default 272

    config POSIX_DISPLAY_ZOOM
        int "Display zoom factor (percent)"
        default 100

    config POSIX_AUDIO_SAMPLE_RATE
        int "Audio sample rate (Hz)"
        default 44100

    config POSIX_AUDIO_CHANNELS
        int "Audio channels"
        default 1

    config POSIX_AUDIO_FRAMES_PER_BUFFER
        int "Frames per audio buffer"
        default 512

    comment "LVGL version is controlled by manifest.yaml"
endmenu

endmenu

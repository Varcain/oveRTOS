menu "oveRTOS Modules"

comment "Core modules (always enabled)"

config OVE_THREAD
    bool
    default y
    help
      Thread management. Always enabled — required by ove_app_run().

config OVE_APP
    bool
    default y
    help
      Application lifecycle. Always enabled.

comment "Optional modules"

config OVE_ARENA
    bool "Arena allocator (bounded region allocator)"
    default n
    help
      Backend-independent fixed-capacity region allocator. Manages a
      caller-supplied buffer with first-fit alloc/free + coalescing and
      never grows the system heap. Backing pool for loadable modules and
      for carving private, fault-bounded pools.

config OVE_LOADER
    bool "Module loader (relocatable ELF / bFLT / FDPIC)"
    default n
    help
      Runtime loader for relocatable native code modules: resolves imports
      against a symbol table, applies relocations, and exposes loaded
      symbols. Reusable for plugins / OTA code modules and the basis for the
      Linux personality's program loader.

config OVE_PROTECTED
    bool "Protected tasks (fault-contained execution)"
    default n
    help
      Run untrusted/loaded code so a memory-protection fault is trapped and
      contained instead of taking down the system. The POSIX host backend uses
      the process MMU + signals; target backends add the unprivileged-task /
      MPU model.

config OVE_LINUX
    bool "Linux personality (syscall surface for loaded programs)"
    default n
    select OVE_ARENA
    select OVE_LOADER
    help
      Impersonate the Linux syscall ABI so stock uClibc-ng (bFLT/FDPIC)
      binaries can run as oveRTOS programs. Provides the engine-agnostic
      syscall dispatch; a per-engine SVC trap feeds it. The personality
      selects its mandatory module loader and bounded process arena.

config OVE_LINUX_GUEST_QUANTUM_MS
    int "Linux guest scheduling quantum (ms)"
    depends on OVE_LINUX
    default 10
    range 1 100
    help
      Base continuous CPU budget for a nice-0 Linux guest while another guest
      is runnable. nice -20..19 maps to a bounded 40..1 share weight, scaling
      this quantum around weight 20. Every guest remains in one best-effort
      RTOS priority class; host real-time, service, and coordinator threads can
      always preempt it immediately.

      FreeRTOS applies a guest-only SysTick budget. NuttX adjusts only guest
      SCHED_RR slices (subject to its kernel tick granularity). Zephyr keeps
      native global time slicing disabled and uses a seam-owned guest-only
      quantum timer, avoiding its per-CPU slice-timeout park/resume hazard.

config OVE_BUILDROOT
    string "Buildroot tree path (Linux-personality rootfs.cpio source)"
    depends on OVE_LINUX
    default "../buildroot"
    help
      Path to the Buildroot clone that provides <output>/images/rootfs.cpio —
      the BusyBox userspace embedded into the firmware. A relative path is
      resolved against the oveRTOS root, so the default expects buildroot as a
      sibling checkout. Build the rootfs with
      tests/sim/zephyr-linux/regen-rootfs-fixture.sh. NOT used by non-Linux builds.

choice OVE_LINUX_GUEST_FLOAT_ABI
    prompt "Linux guest floating-point calling convention"
    depends on OVE_LINUX && (OVE_RTOS_FREERTOS || OVE_RTOS_NUTTX || OVE_RTOS_ZEPHYR)
    # STM32F746G-DISCO defaults to hard-float: the F746 FPv5-SP is present, all 3
    # seams support it, and it is the validated GUI/personality config there.
    default OVE_LINUX_GUEST_FLOAT_ABI_HARD if OVE_BOARD_STM32F746G_DISCO
    default OVE_LINUX_GUEST_FLOAT_ABI_SOFT
    help
      Select the ABI used by programs inside the Linux personality. This is
      independent of OVE_ARM_FLOAT_ABI, which controls the host FreeRTOS
      firmware and its linked libraries.

config OVE_LINUX_GUEST_FLOAT_ABI_SOFT
    bool "Soft-float guest ABI (core argument registers)"
    help
      Use the maintained soft-float FDPIC Buildroot userspace from "output".
      Guest floating-point operations are provided by software helpers and do
      not require VFP state to survive a parked syscall.

config OVE_LINUX_GUEST_FLOAT_ABI_HARD
    bool "Hard-float guest ABI (VFP argument registers)"
    depends on OVE_BOARD_STM32F746G_DISCO || OVE_BOARD_QEMU_MPS2_AN500
    help
      Use the Cortex-M7 FPv5-SP hard-float FDPIC Buildroot userspace from
      "output-hardfloat" and preserve s0-s31 plus FPSCR across every deferred
      syscall, signal and parked guest task resume. Supported by the FreeRTOS port
      (STM32F746G-DISCO, MPS2-AN500), the LXP NuttX port (STM32F746G-DISCO, via
      CONFIG_ARCH_FPU + regs[] VFP capture) and the Zephyr seam (STM32F746G-DISCO,
      via CONFIG_FPU_SHARING + extended-ESF VFP capture).
endchoice

config OVE_LINUX_GUEST_FP_SELFTEST
    bool "Run hard-float guest context self-test instead of init"
    depends on OVE_LINUX_GUEST_FLOAT_ABI_HARD
    default n
    help
      Development/test mode for the linux_interop app. Select the rootfs guest
      entrypoint's fpcheck mode after the normal RTOS-to-guest round trip instead
      of booting userspace. The guest validates s0-s31 plus FPSCR across repeated
      deferred and blocking syscall paths.

config OVE_LINUX_LATENCY
    bool "Measure Linux-personality coordinator latency"
    depends on OVE_LINUX
    default n
    help
      Instrument the personality coordinator: how long it spends dispatching one
      guest event (per event class) and how long an event waits between the guest
      publishing it and the coordinator claiming it (per slot). Both are recorded
      as a count, a maximum and a fixed histogram; nothing is enforced and no
      threshold exists — this measures the bound the design argues for so a limit
      can be set from real numbers.

      Costs one timestamp read per event plus a counter update, and compiles to
      nothing when off. Enable for measurement runs, not for production.

config OVE_LINUX_RT_SCOPE
    bool "Two-channel host real-time oscilloscope demo"
    depends on OVE_LINUX && OVE_BOARD_STM32F746G_DISCO
    default y
    select OVE_SYNC
    help
      Drive a two-channel oscilloscope demonstration on STM32F746G-DISCO.
      TIM3 generates a 1 kHz reference pulse directly on Arduino D3/PB4.
      The same timer interrupt wakes an OVE_PRIO_CRITICAL host thread, which
      emits its response pulse on Arduino D4/PG7 while Linux-personality
      userspace is under load. The horizontal distance between the rising
      edges is interrupt-to-thread dispatch latency; response width is a
      small fixed host workload. A pinless TIM5 timebase also counts collapsed
      releases, and a low-priority reporter prints cumulative dispatch jitter,
      missed executions and late completions every 10 seconds. On FreeRTOS it
      also measures the Linux SVC dispatch body and reports the syscall number
      responsible for each window and lifetime maximum.

      This option is enabled by default for Linux-personality builds on the
      board. Disable it for applications that need TIM3, TIM5, PB4, or PG7.

config OVE_LINUX_ROOTFS_OUTPUT_OVERRIDE
    string "Override Buildroot output subdir (normally empty)"
    depends on OVE_LINUX
    default ""
    help
      Leave empty to select "output" for a soft-float guest and
      "output-hardfloat" for a hard-float guest. Set this only for an
      out-of-tree Buildroot O= directory whose ABI matches the guest choice.

config OVE_LINUX_ROOTFS_OUTPUT
    string
    depends on OVE_LINUX
    default OVE_LINUX_ROOTFS_OUTPUT_OVERRIDE if OVE_LINUX_ROOTFS_OUTPUT_OVERRIDE != ""
    default "output-hardfloat" if OVE_LINUX_GUEST_FLOAT_ABI_HARD
    default "output"
    help
      Derived Buildroot output subdir used for rootfs.cpio. Keeping this symbol
      hidden prevents a saved soft-float default from pinning the wrong rootfs
      after the guest ABI is changed. Use OVE_LINUX_ROOTFS_OUTPUT_OVERRIDE for
      an explicit out-of-tree directory.

config OVE_LINUX_ROOTFS_EXTERNAL
    bool
    depends on OVE_LINUX
    default y if OVE_LINUX_ROOTFS_QSPI
    default y if OVE_BOARD_QEMU_MPS2_AN500 || OVE_BOARD_QEMU_MPS2_AN521
    help
      Derived storage-mode contract for a rootfs staged at the configured
      physical address instead of linked into the firmware as a fixture.

config OVE_LINUX_ROOTFS_BASE
    hex
    depends on OVE_LINUX
    default 0x90000000 if OVE_LINUX_ROOTFS_QSPI
    default 0x60000000 if OVE_BOARD_QEMU_MPS2_AN500
    default 0x80000000 if OVE_BOARD_QEMU_MPS2_AN521
    default 0
    help
      Generated physical base of the externally staged, executable rootfs
      window. This is consumed by the application, RTOS isolation seam and
      board runner so those layers cannot silently describe different ranges.

config OVE_LINUX_ROOTFS_SIZE
    hex
    depends on OVE_LINUX
    default 0x01000000 if OVE_LINUX_ROOTFS_QSPI
    default 0x00800000 if OVE_BOARD_QEMU_MPS2_AN500 && OVE_RTOS_NUTTX
    default 0x00c00000 if OVE_BOARD_QEMU_MPS2_AN500
    default 0x00ef0000 if OVE_BOARD_QEMU_MPS2_AN521
    default 0
    help
      Generated usable extent of the externally staged rootfs. The AN500
      value is engine-specific: NuttX has one 8 MiB PMSAv7 region, while
      FreeRTOS uses adjacent 8 MiB and 4 MiB task regions.

config OVE_LINUX_ROOTFS_FILE_CAPACITY
    int
    default 512
    range 1 4096
    depends on OVE_LINUX
    help
      Number of immutable CPIO index entries owned by the oveRTOS LXP host.
      This is host-composition storage rather than application state.

config OVE_LINUX_ROOTFS_NAME_CAPACITY
    int
    default 12288 if OVE_BOARD_STM32F746G_DISCO && OVE_RTOS_NUTTX
    default 15360
    range 1024 1048576
    depends on OVE_LINUX
    help
      Bytes reserved by the oveRTOS LXP host for normalized CPIO pathnames.
      The general 15 KiB bound retains more than 4 KiB of growth beyond the
      measured rootfs. STM32 NuttX uses the proven 12 KiB bound so its early
      SRAM1 allocator remains below g_idle_topstack before SRAM2 and DTCM are
      added.

config OVE_LINUX_GUEST_POOL_BASE
    hex
    depends on OVE_LINUX
    default 0xc0100000 if OVE_BOARD_STM32F746G_DISCO && OVE_RTOS_NUTTX
    default 0x60800000 if OVE_BOARD_QEMU_MPS2_AN500 && OVE_RTOS_NUTTX
    default 0x60c00000 if OVE_BOARD_QEMU_MPS2_AN500 && OVE_RTOS_FREERTOS
    default 0x80ef0000 if OVE_BOARD_QEMU_MPS2_AN521
    default 0
    help
      Generated base of a fixed-address guest program pool. A zero value means
      that the engine linker/devicetree owns placement instead.

config OVE_LINUX_GUEST_POOL_SIZE
    hex
    depends on OVE_LINUX
    default 0x00700000 if OVE_BOARD_STM32F746G_DISCO && OVE_RTOS_NUTTX
    default 0x00800000 if OVE_BOARD_QEMU_MPS2_AN500 && OVE_RTOS_NUTTX
    default 0x00400000 if OVE_BOARD_QEMU_MPS2_AN500 && OVE_RTOS_FREERTOS
    default 0x00110000 if OVE_BOARD_QEMU_MPS2_AN521
    default 0
    help
      Generated extent of a fixed-address guest program pool. The seam checks
      its configured rows against this bound; linkers/devicetree retain their
      own overflow checks at the placement boundary.

config OVE_QSPI
    bool "QSPI NOR flash (memory-mapped XIP)"
    default n
    help
      Bring up the on-board QSPI NOR (STM32F746-Discovery: N25Q128A, 16 MB) in
      memory-mapped mode at 0x90000000, so large read-only data (the Linux
      personality rootfs) can be executed/read in place from external flash
      instead of consuming the internal 1 MB flash.

config OVE_LINUX_ROOTFS_QSPI
    bool "Linux personality: rootfs.cpio in QSPI NOR (XIP), not internal flash"
    default n
    depends on OVE_LINUX
    select OVE_QSPI
    help
      Read the embedded rootfs from the QSPI memory-mapped window (0x90000000)
      instead of embedding it in the firmware image. Frees the internal flash
      for the firmware, so a large (LVGL) rootfs fits on the STM32F746. The
      CPIO must be programmed into QSPI separately; on STM32F746G-DISCO use
      boards/stm32f746g-discovery/freertos/flash-qspi.sh, which drives OpenOCD
      stmqspi directly.

config OVE_LINUX_NET
    bool "Linux personality: BSD socket layer"
    default n
    depends on OVE_LINUX
    select OVE_NET
    help
      Bridge the Linux personality's socket syscalls (socket/connect/send/recv/
      shutdown/...) to the engine-neutral ove_net HAL (lwIP / NuttX net / Zephyr
      net), so stock networking tools (wget, nc, ping, httpd) run under the
      personality. Selects OVE_NET, which pulls in the per-engine TCP/IP stack and
      the board's Ethernet driver. ove_lxp_host_init() brings the interface up
      from the configured static or DHCP topology before the program runs;
      ove_lxp_host_init_cpio() remains available for custom composition.

config OVE_LINUX_NETIF_DHCP
    bool "Linux host interface: use DHCP"
    default n
    depends on OVE_LINUX_NET
    help
      Ask the native network backend for an address. When disabled, the three
      IPv4 strings below form the static product topology.

config OVE_LINUX_NETIF_IPV4_ADDRESS
    string "Linux host interface: static IPv4 address"
    default "172.1.1.2"
    depends on OVE_LINUX_NET && !OVE_LINUX_NETIF_DHCP

config OVE_LINUX_NETIF_IPV4_NETMASK
    string "Linux host interface: static IPv4 netmask"
    default "255.255.255.0"
    depends on OVE_LINUX_NET && !OVE_LINUX_NETIF_DHCP

config OVE_LINUX_NETIF_IPV4_GATEWAY
    string "Linux host interface: static IPv4 gateway"
    default "172.1.1.1"
    depends on OVE_LINUX_NET && !OVE_LINUX_NETIF_DHCP

config OVE_LINUX_NETIF_ADDRESS_WAIT_MS
    int "Linux host interface: address wait (ms)"
    default 10000
    range 0 120000
    depends on OVE_LINUX_NET
    help
      Bounded best-effort wait after native interface bring-up. A zero value
      performs one address check without sleeping.

config OVE_LINUX_FS
    bool "Linux personality: persistent /data filesystem"
    default n
    depends on OVE_LINUX && !OVE_BOARD_QEMU_MPS2_AN500 && !OVE_BOARD_QEMU_MPS2_AN521
    select OVE_FS
    select OVE_QUEUE
    select OVE_SYNC
    select OVE_TIME
    help
      Route the Linux personality's /data mount to the engine-native ove_fs
      volume (SD/FAT on STM32F746). Native filesystem calls execute on one
      serialized host worker and use bounded, statically owned handles.
      Missing or unformatted media does not prevent the personality from
      starting; /data operations report ENODEV until the volume can mount.

config OVE_LINUX_FS_SERVER_PERIOD_US
    int "Native filesystem server period (microseconds)"
    default 1000
    range 100 1000000
    depends on OVE_LINUX_FS
    help
      Minimum admission period for the serialized native filesystem worker.
      At most one bounded request is started per period.

config OVE_LINUX_FS_SERVER_BUDGET_US
    int "Native filesystem request wall-time budget (microseconds)"
    default 300
    range 1 1000000
    depends on OVE_LINUX_FS
    help
      Telemetry threshold for one native filesystem request. Calls exceeding
      this wall-time budget increment /proc/lxp_fs budget_overruns. The RTOS
      may preempt the worker, so this is an overrun detector, not a claim that
      an opaque filesystem call can be forcibly stopped at the threshold.

config OVE_BLOCK
    bool "Raw block-media API"
    default n
    help
      Provide engine-neutral sector geometry, read, write, and sync operations.
      This is intentionally separate from ove_fs: callers must arbitrate raw
      media ownership against mounted filesystems.

config OVE_LINUX_BLOCK
    bool "Linux personality: /dev/mmcblk0 block device"
    default n
    depends on OVE_LINUX && !OVE_BOARD_QEMU_MPS2_AN500 && !OVE_BOARD_QEMU_MPS2_AN521
    select OVE_BLOCK
    select OVE_LINUX_FS
    select OVE_LINUX_DEV
    help
      Expose SD media as /dev/mmcblk0 plus validated MBR primary partition
      views. Uses the same bounded storage server and ownership state as /data.

config OVE_LINUX_BLOCK_WRITE
    bool "Allow writable Linux raw block opens"
    default n
    depends on OVE_LINUX_BLOCK
    help
      Permit privileged guests to modify raw media after /data is explicitly
      unmounted. Keep disabled unless fdisk/mkfs-style administration is needed.

config OVE_LINUX_NETFS
    bool "Linux personality: remote filesystem (9P2000.L)"
    default n
    depends on OVE_LINUX
    select OVE_LINUX_NET
    help
      Mount a directory exported by a 9P server (diod on a Raspberry Pi) under a
      path like /mnt/pi, so the guest browses it transparently (ls/cat/stat/less)
      over a coordinator-owned, non-blocking TCP connection. Read-only. Selects
      the Linux socket layer, which in turn selects the engine TCP/IP stack. The
      configured mount topology is consumed by ove_lxp_host_init(); callers
      using ove_lxp_host_init_cpio() may instead supply a custom topology.

config OVE_LINUX_NETFS_SERVER_IP
    string "netfs: 9P server IPv4 (a.b.c.d)"
    default "172.1.1.1"
    depends on OVE_LINUX_NETFS

config OVE_LINUX_NETFS_PORT
    int "netfs: 9P server TCP port"
    default 564
    depends on OVE_LINUX_NETFS

config OVE_LINUX_NETFS_ANAME
    string "netfs: 9P export path to attach (diod -e)"
    default "/srv/pi9"
    depends on OVE_LINUX_NETFS

config OVE_LINUX_NETFS_MOUNTPOINT
    string "netfs: guest mount point"
    default "/mnt/pi"
    depends on OVE_LINUX_NETFS

config OVE_LINUX_NETFS_UNAME
    string "netfs: user name"
    default "root"
    depends on OVE_LINUX_NETFS

config OVE_LINUX_NETFS_EXEC
    bool "netfs: execute programs off the mount (relaxes W^X)"
    default n
    depends on OVE_LINUX_NETFS
    help
      Allow execve() of a dynamic FDPIC program that lives on the remote mount:
      its own text is staged into RAM and its program region is made RW+Execute
      (a per-process, MPU-contained W^X hole). The program links the LOCAL rootfs
      libc/ld.so (XIP from flash), so only its own small text is fetched. Off by
      default so normal builds keep strict W^X. Remote binaries must be built with
      the FDPIC toolchain and be ABI-compatible with the device's libc.

config OVE_LINUX_PTY
    bool "Linux personality: pseudo-terminal (pty) layer"
    default n
    depends on OVE_LINUX
    help
      Unix98 pseudo-terminals for the Linux personality: /dev/ptmx mints a
      master↔slave pair and /dev/pts/N is the slave, with a minimal in-kernel
      line discipline (echo / canonical editing / ICRNL / ONLCR / ISIG ^C→SIGINT).
      Needed for an interactive network login shell — an SSH server (dropbear)
      allocates a pty and runs the login shell on the slave. Works with
      OVE_LINUX_NET (the SSH transport); the pty read/write park is independent,
      but poll(2)-parking on a pty reuses the socket poll path (enable OVE_LINUX_NET).

config OVE_LINUX_DEV
    bool "Linux personality: /dev character-device layer"
    default n
    depends on OVE_LINUX
    help
      A small in-kernel device model for the Linux personality: class drivers
      register /dev nodes (framebuffer /dev/fb0, touch /dev/input/event0, ...)
      and open/read/write/ioctl/poll/mmap on those paths route to the driver,
      bridging to the engine-neutral ove_* HALs. Needed to run a graphical
      (LVGL fbdev) program under the personality. Enable a class below.

config OVE_LINUX_DEV_FB
    bool "Linux personality: /dev/fb0 framebuffer node"
    default n
    depends on OVE_LINUX_DEV
    select OVE_FB
    help
      Expose the OVE_FB framebuffer as /dev/fb0 (FBIOGET_*SCREENINFO + pwrite
      scanlines), so a stock LVGL fbdev program renders under the personality.

config OVE_LINUX_DEV_DMA2D
    bool "Linux personality: /dev/dma2d 2D accelerator (Chrom-ART)"
    default n
    depends on OVE_LINUX_DEV_FB
    help
      Expose the STM32 DMA2D (Chrom-ART) 2D accelerator as /dev/dma2d so a guest
      LVGL program can offload fill/blit/blend to hardware, bypassing the tiny M7
      D-cache. The board must provide ove_hal_dma2d_* (drivers/.../dma2d_port);
      without it the device returns an error and the guest renders in software.

config OVE_LINUX_DEV_INPUT
    bool "Linux personality: /dev/input/event0 evdev touch node"
    default n
    depends on OVE_LINUX_DEV
    help
      Expose a single-touch evdev stream (ABS_X/ABS_Y/BTN_TOUCH/SYN_REPORT) as
      /dev/input/event0, fed by the FT5336 driver on real hardware or the testpad
      injector on QEMU, so an LVGL program becomes touch-interactive.

config OVE_LINUX_DEV_INPUT_TESTPAD
    bool "Linux personality: synthetic touch injector (QEMU)"
    default n
    depends on OVE_LINUX_DEV_INPUT
    help
      Replay a canned touch gesture from the run-loop tick (no host channel), so
      the evdev path is deterministically testable on QEMU where there is no
      touch panel.

config OVE_FT5336
    bool "FT5336 capacitive touch controller (STM32F746-Discovery)"
    default n
    select OVE_I2C
    help
      Minimal FT5336 driver (ove_i2c client at 0x38). The evdev class polls it
      from the run-loop tick to produce /dev/input/event0 touch events on real
      STM32F746 hardware.

config OVE_FT5336_I2C_INSTANCE
    int "FT5336 ove_i2c instance"
    default 0
    depends on OVE_FT5336
    help
      Which ove_i2c controller the FT5336 touch panel is wired to. On the
      STM32F746-Discovery the touch controller is on I2C3 = ove_i2c instance 2
      (the stm32f7 i2c backend maps 0->I2C1, 1->I2C2, 2->I2C3).

config OVE_SYNC
    bool "Synchronization primitives (mutex, sem, event, condvar)"
    default n

config OVE_AUDIO
    bool "Audio subsystem"
    default n
    select OVE_I2S if OVE_RTOS_FREERTOS && !OVE_BOARD_QEMU_MPS2_AN500

config OVE_AUDIO_NODE_CONVERTER
    bool "Audio format converter node"
    depends on OVE_AUDIO
    default n

config OVE_AUDIO_NODE_GAIN
    bool "Audio gain node"
    depends on OVE_AUDIO
    default n
    help
      Per-channel linear gain stage in the audio graph. Configured via
      ove_audio_node_gain_set(); applied in-place during process().
      Enable when an app needs runtime volume control or fader
      automation without modifying the source node.

config OVE_AUDIO_NODE_TAP
    bool "Audio tap/observer node"
    depends on OVE_AUDIO
    default n
    help
      Read-only observer node that copies frames flowing through a
      point in the graph into a ring buffer readable from another
      thread (e.g. for metering, waveform display, or logging). Does
      not modify the audio path.

config OVE_AUDIO_NODE_CHANNEL_MAP
    bool "Audio channel mapper node"
    depends on OVE_AUDIO
    default n

config OVE_FS
    bool "File system"
    default n

config OVE_FS_MAX_OPEN_FILES
    int "Required concurrent native filesystem file handles"
    default 16 if OVE_LINUX_FS
    default 4
    range 1 64
    depends on OVE_FS
    help
      Maximum number of caller-owned file handles that an application may
      keep active concurrently. Backends which reserve per-open native
      resources use this value as their capacity contract. This does not size
      the separate four-entry ove_fs_open() convenience pool; callers needing
      this full capacity use ove_fs_open_init() with caller-owned storage.

config OVE_CONSOLE
    bool "Console I/O"
    default n

config OVE_LOG
    bool "Logging"
    default n
    depends on OVE_CONSOLE

config OVE_TIME
    bool "Time and delay functions"
    default n

config OVE_BOARD
    bool "Board descriptor and init"
    default n

config OVE_GPIO
    bool "GPIO control"
    default n

config OVE_LED
    bool "LED control"
    default n
    select OVE_GPIO

config OVE_BSP
    bool "Board support package (compat — selects board+gpio+led)"
    default n
    select OVE_BOARD
    select OVE_GPIO
    select OVE_LED

config OVE_LVGL
    bool "LVGL UI framework"
    default n
    select OVE_SYNC

config OVE_QUEUE
    bool "Message queues"
    default n

config OVE_TIMER
    bool "Software timers"
    default n

config OVE_EVENTGROUP
    bool "Event groups"
    default n

config OVE_SHELL
    bool "Interactive shell"
    default n
    depends on OVE_CONSOLE

config OVE_NVS
    bool "Non-volatile storage"
    default n

config OVE_WATCHDOG
    bool "Watchdog timer"
    # On by default for the Linux personality on real STM32F746 hardware: it runs untrusted
    # guest code, so a hardware last-resort that reboots the board if the HOST RTOS itself
    # wedges is worth its ~1.3 KB of internal SRAM. Scoped to that board+rtos+app because the
    # IWDG backend is STM32 HAL only (the QEMU an500 machine has no IWDG and would not build),
    # and only linux_interop ships a feeder. Off everywhere else; opt out in menuconfig.
    default y if OVE_LINUX && OVE_RTOS_FREERTOS && OVE_BOARD_STM32F746G_DISCO
    default n

config OVE_WATCHDOG_SELFTEST
    bool "Watchdog self-test (deliberately wedges the host once)"
    depends on OVE_WATCHDOG && OVE_LINUX
    default n
    help
      Debug/proof aid for the linux_interop app: a few seconds after the guest
      is running, deliberately starve the personality coordinator (a spinner
      just above it in priority, interrupts left enabled) so the high-priority
      watchdog monitor observes a stalled heartbeat, withholds the feed, and the
      IWDG resets the board. The next boot reports its reset cause as "watchdog"
      and does NOT re-trip, so the board wedges exactly once and then runs clean.

      This proves the heartbeat-gated feed actually resets a wedged host. It is
      destructive by design (it reboots the board) — never enable it in a
      production image.

config OVE_LINUX_FAULTTEST
    bool "Host-fault self-test (deliberately faults a privileged host task once)"
    depends on OVE_LINUX && OVE_WATCHDOG
    default n
    help
      Debug/proof aid for the linux_interop app: a few seconds after the guest
      is running, a privileged host task executes an undefined instruction. The
      seam's fault handler cannot attribute the fault to any guest slot, so it
      does NOT contain it — it prints a "HOST FAULT" diagnostic and halts, and
      the watchdog then resets the board. The next boot reports its reset cause
      as "watchdog" and does NOT re-trip.

      This proves a fault in trusted/host context is fatal (never recovered as if
      it were a guest fault). Requires the watchdog for recovery and the one-shot.
      Destructive by design — never enable it in a production image.

config OVE_LINUX_SMASHTEST
    bool "Stack-protector self-test (deliberately smashes a host stack once)"
    depends on OVE_LINUX && OVE_STACK_CANARIES && OVE_WATCHDOG
    default n
    help
      Debug/proof aid: a few seconds after the guest is running, a host task
      overflows a local buffer past its stack canary. -fstack-protector-strong's
      epilogue check then calls __stack_chk_fail, which prints a "STACK SMASH"
      diagnostic and halts; the watchdog resets. The next boot reports its reset
      cause as "watchdog" and does NOT re-trip.

      Proves the protector's fail path reaches the board's __stack_chk_fail (not
      picolibc's silent default). Destructive by design — never ship it.

config OVE_WORKQUEUE
    bool "Work queues"
    default n

config OVE_STREAM
    bool "Stream I/O"
    default n

config OVE_ASYNC
    bool "Async runtime substrate (Embassy)"
    default n
    depends on OVE_TIMER && OVE_SYNC && OVE_TIME
    help
      Provides the C primitives the Rust binding needs to host
      Embassy: ove_irq_lock/unlock, ove_is_in_isr, and the
      nanosecond-period timer variant ove_timer_init_ns. Wakes
      the executor through the existing ove_event_signal_from_isr.

      No effect on the C API surface for non-async users; symbols
      are gated by CONFIG_OVE_ASYNC and absent when the option is
      off.

      Rust apps then opt in via the `async` cargo feature on the
      `ove` crate.

menu "Bus drivers"

config OVE_UART
    bool "UART serial"
    default n
    select OVE_SYNC
    select OVE_STREAM
    help
      General-purpose UART driver with configurable baud rate,
      framing, async RX buffering, and thread-safe TX.

config OVE_SPI
    bool "SPI bus master"
    default n
    select OVE_SYNC
    select OVE_GPIO
    help
      SPI master driver with configurable clock, mode, and
      software CS management via GPIO. Thread-safe bus locking.

config OVE_I2C
    bool "I2C bus master"
    default n
    select OVE_SYNC
    help
      I2C master driver with standard/fast/fast-plus speed,
      register-level convenience APIs, and thread-safe bus locking.

config OVE_FB
    bool "Framebuffer (raw linear RGB565 display)"
    default n
    help
      A minimal raw framebuffer HAL: one linear RGB565 buffer plus a board
      backend (an500 pushes RAM to a host viewer; STM32F746 uses the LTDC
      scanout buffer in SDRAM). Bridged to /dev/fb0 by the Linux personality's
      framebuffer class driver (OVE_LINUX_DEV_FB).

config OVE_I2S
    bool "I2S / SAI audio bus"
    default n
    help
      I2S audio bus driver with DMA double-buffered streaming,
      half-buffer completion callbacks, and configurable sample
      rate, bit depth, and channel count. Codec initialisation
      is board-specific and not part of this driver.

endmenu

menu "Machine learning"

config OVE_INFER
    bool "ML inference engine (LiteRT / TF Lite Micro)"
    default n
    depends on OVE_TIME && OVE_CONSOLE
    help
      Portable C API for running .tflite models via LiteRT
      (formerly TensorFlow Lite Micro). Requires C++ support
      in the toolchain.

config OVE_INFER_CMSIS_NN
    bool "CMSIS-NN kernel acceleration"
    default n
    depends on OVE_INFER
    help
      Use ARM CMSIS-NN optimized kernels for int8 quantized
      operators. Provides 2-10x speedup on Cortex-M4/M7.
      Automatically disabled on non-ARM targets.

config OVE_INFER_ARENA_SIZE
    int "Default tensor arena size (bytes)"
    default 65536
    depends on OVE_INFER
    help
      Default arena allocation for models that don't specify
      a custom size. Can be overridden per-model via
      ove_model_config.arena_size.

endmenu

menu "Networking"

config OVE_NET
    bool "Socket API (TCP/UDP) and DNS"
    default n
    help
      BSD-like socket API with DNS resolution. Each backend uses
      its native TCP/IP stack (POSIX sockets, lwIP, Zephyr net,
      NuttX sockets).

config OVE_NET_MAC_FROM_UID
    bool "Derive the Ethernet MAC from the STM32 chip UID"
    default y
    depends on OVE_NET
    help
      Derive a per-chip, locally-administered unicast MAC address from
      the STM32 96-bit unique device ID instead of a fixed compiled-in
      address, so two boards on one LAN do not collide. Honoured by the
      FreeRTOS STM32F7 lwIP driver; NuttX and Zephyr already derive a
      unique MAC from the UID / DT natively. Disable to keep a
      predictable fixed MAC (e.g. for a DHCP reservation).

config OVE_ASYNC_NET
    bool "Async networking substrate (embassy-net)"
    default n
    depends on OVE_ASYNC
    help
      Provides board-specific transport hooks the Rust embassy-net
      driver consumes (ove_qemu_net_async_*, future ove_eth_*).
      Mutually exclusive with OVE_NET at runtime — both want the
      same MAC/transport; only one IP stack at a time.

      Rust apps opt in via the `async-net` cargo feature on the
      `ove` crate plus a board-specific transport feature (e.g.
      `async-net-qemu-shm`).

config OVE_NET_TLS
    bool "TLS (mbedTLS)"
    default n
    depends on OVE_NET
    help
      Portable TLS layer using mbedTLS. Provides encrypted
      sockets for HTTPS and secure MQTT.

config OVE_NET_HTTP
    bool "HTTP/1.1 client"
    default n
    depends on OVE_NET
    help
      Portable HTTP/1.1 client for REST APIs. Supports both
      plain HTTP and HTTPS (when OVE_NET_TLS is enabled).

config OVE_NET_MQTT
    bool "MQTT 3.1.1 client"
    default n
    depends on OVE_NET
    help
      Lightweight MQTT 3.1.1 client for IoT pub/sub messaging.
      Supports QoS 0/1, keep-alive, and optional TLS.

config OVE_NET_MQTT_RX_BUF
    int "MQTT receive buffer size (bytes)"
    default 1024
    depends on OVE_NET_MQTT

config OVE_NET_MQTT_TX_BUF
    int "MQTT transmit buffer size (bytes)"
    default 512
    depends on OVE_NET_MQTT

config OVE_NET_MQTT_MAX_SUBS
    int "Max concurrent MQTT subscriptions"
    default 8
    depends on OVE_NET_MQTT
    help
      Maximum number of topic filters tracked for wildcard matching.

config OVE_NET_SNTP
    bool "SNTP time synchronization"
    default n
    depends on OVE_NET && OVE_TIME
    help
      Simple NTP client that queries a time server over UDP and
      stores a UTC offset for wall-clock time correction.

config OVE_NET_TLS_HEAP_SIZE
    int "TLS static heap size (bytes)"
    default 32768
    depends on OVE_NET_TLS
    help
      Size of the BSS-resident buffer mbedTLS allocates from in
      zero-heap mode (mbedtls_memory_buffer_alloc_init).  32 KB is
      sufficient for TLS 1.2 with RSA-2048; budget ~24 KB peak per
      concurrent session.  Pool exhaustion returns OVE_ERR_NO_MEMORY,
      never spills to libc malloc.

config OVE_NET_RX_READY_NOTIFY
    bool
    default y if OVE_NET && OVE_RTOS_FREERTOS
    help
      Internal capability contract: the selected network backend publishes
      receive activity through the engine-neutral readiness channel.

config OVE_NET_RX_FAIR_SCHEDULING
    bool "Bound Ethernet RX work for scheduler fairness"
    default y if OVE_LINUX
    default n
    depends on OVE_NET && OVE_RTOS_FREERTOS
    help
      Rate-limit saturated Ethernet receive processing with a three-frame
      token bucket. This bounds network task interference while preserving
      short ARP/TCP bursts. Disable for throughput-oriented native workloads.

comment "lwIP bounded-pool sizing (FreeRTOS only)"
    depends on OVE_NET && OVE_RTOS_FREERTOS

config OVE_NET_LWIP_MEM_SIZE
    int "lwIP heap size (bytes)"
    default 16384
    depends on OVE_NET && OVE_RTOS_FREERTOS
    help
      MEM_SIZE.  BSS-resident heap lwIP uses for pbufs, segment
      lists, and other dynamic buffers.  MEM_LIBC_MALLOC is pinned
      to 0 in lwipopts_common.h so this is a hard ceiling — lwIP
      never falls back to libc malloc.

config OVE_NET_LWIP_PBUF_POOL_SIZE
    int "lwIP PBUF pool count"
    default 16
    depends on OVE_NET && OVE_RTOS_FREERTOS
    help
      PBUF_POOL_SIZE.  Number of fixed-size pbufs in the receive
      pool.  Drives RX bandwidth ceiling.

config OVE_NET_LWIP_PBUF_BUFSIZE
    int "lwIP PBUF buffer size (bytes)"
    default 1536
    depends on OVE_NET && OVE_RTOS_FREERTOS
    help
      PBUF_POOL_BUFSIZE.  Bytes per pbuf — sized to fit one MTU.

config OVE_NET_LWIP_NUM_TCP_PCB
    int "lwIP active TCP PCB count"
    default 16
    depends on OVE_NET && OVE_RTOS_FREERTOS
    help
      MEMP_NUM_TCP_PCB.  Maximum simultaneous active TCP
      connections.  Caller hits OVE_ERR_NO_MEMORY when exhausted.

config OVE_NET_LWIP_NUM_TCP_PCB_LISTEN
    int "lwIP listening TCP PCB count"
    default 4
    depends on OVE_NET && OVE_RTOS_FREERTOS
    help
      MEMP_NUM_TCP_PCB_LISTEN.  Maximum listening sockets (e.g.
      one per HTTPD/MQTT broker port).

config OVE_NET_LWIP_NUM_UDP_PCB
    int "lwIP UDP PCB count"
    default 8
    depends on OVE_NET && OVE_RTOS_FREERTOS
    help
      MEMP_NUM_UDP_PCB.  Maximum simultaneous UDP sockets.

config OVE_NET_LWIP_NUM_NETCONN
    int "lwIP netconn count"
    default 16
    depends on OVE_NET && OVE_RTOS_FREERTOS
    help
      MEMP_NUM_NETCONN.  Upper bound on concurrent socket-API
      handles (one netconn per BSD socket).

config OVE_NET_LWIP_DNS_TABLE_SIZE
    int "lwIP DNS cache size"
    default 4
    depends on OVE_NET && OVE_RTOS_FREERTOS
    help
      DNS_TABLE_SIZE.  Number of resolved hostnames cached.

comment "Zephyr net stack bounded-pool sizing"
    depends on OVE_NET && OVE_RTOS_ZEPHYR

config OVE_ZEPHYR_NET_MAX_CONN
    int "Active connection slots"
    default 16
    depends on OVE_NET && OVE_RTOS_ZEPHYR
    help
      CONFIG_NET_MAX_CONN.  Concurrent TCP/UDP connections.

config OVE_ZEPHYR_NET_MAX_CONTEXTS
    int "Net context (socket) slots"
    default 16
    depends on OVE_NET && OVE_RTOS_ZEPHYR
    help
      CONFIG_NET_MAX_CONTEXTS.  Maximum BSD-socket-like contexts.

config OVE_ZEPHYR_NET_PKT_RX_COUNT
    int "RX net_pkt slab count"
    default 14
    depends on OVE_NET && OVE_RTOS_ZEPHYR
    help
      CONFIG_NET_PKT_RX_COUNT.  Receive packet descriptor pool.

config OVE_ZEPHYR_NET_PKT_TX_COUNT
    int "TX net_pkt slab count"
    default 14
    depends on OVE_NET && OVE_RTOS_ZEPHYR
    help
      CONFIG_NET_PKT_TX_COUNT.  Transmit packet descriptor pool.

config OVE_ZEPHYR_NET_BUF_RX_COUNT
    int "RX net_buf fragment count"
    default 36
    depends on OVE_NET && OVE_RTOS_ZEPHYR
    help
      CONFIG_NET_BUF_RX_COUNT.  Receive payload buffer pool.

config OVE_ZEPHYR_NET_BUF_TX_COUNT
    int "TX net_buf fragment count"
    default 36
    depends on OVE_NET && OVE_RTOS_ZEPHYR
    help
      CONFIG_NET_BUF_TX_COUNT.  Transmit payload buffer pool.

config OVE_ZEPHYR_NET_BUF_DATA_SIZE
    int "net_buf payload size (bytes)"
    default 128
    range 96 2048
    depends on OVE_NET && OVE_RTOS_ZEPHYR
    help
      CONFIG_NET_BUF_DATA_SIZE.  Payload bytes carried by each network
      fragment.  Choose this together with the RX/TX fragment counts: larger
      fragments reduce per-frame chaining but consume more static SRAM.

config OVE_NET_HTTP_MAX_RESPONSE
    int "HTTP client max response buffer size (bytes)"
    default 8192
    depends on OVE_NET_HTTP
    help
      Maximum HTTP response size in zero-heap mode where the buffer
      cannot grow dynamically.

config OVE_NET_HTTPD_MAX_BODY
    int "HTTPD max POST body size (bytes)"
    default 1024
    depends on OVE_NET_HTTPD

config OVE_NET_HTTPD
    bool "Embedded HTTP server"
    default n
    depends on OVE_NET
    help
      Lightweight single-threaded HTTP server with REST API
      routing and a built-in web dashboard for device management
      (LEDs, GPIO, network config, log console).

config OVE_NET_HTTPD_WS
    bool "WebSocket support"
    default n
    depends on OVE_NET_HTTPD
    help
      Adds RFC 6455 WebSocket upgrade and frame parsing to the
      embedded HTTP server.  Enables real-time bidirectional push
      from device to browser without polling.

config OVE_NET_HTTPD_WS_MAX_CONNS
    int "Max concurrent WebSocket connections"
    default 4
    depends on OVE_NET_HTTPD_WS

config OVE_NET_HTTPD_WS_MAX_FRAME
    int "Max WebSocket frame payload (bytes)"
    default 1024
    depends on OVE_NET_HTTPD_WS

endmenu

menu "Power Management"

config OVE_PM
    bool "Power management framework"
    default n
    select OVE_SYNC
    select OVE_TIME
    help
      Unified power management with sleep state machine,
      peripheral power domains, tickless idle integration,
      wake source management, and runtime power statistics.

config OVE_PM_MAX_WAKE_SOURCES
    int "Maximum registered wake sources"
    default 8
    depends on OVE_PM
    help
      Maximum number of concurrently registered wake sources.
      Each entry consumes ~32 bytes of static RAM.

config OVE_PM_MAX_NOTIFIERS
    int "Maximum transition notifiers"
    default 4
    depends on OVE_PM
    help
      Maximum number of pre/post sleep notification callbacks.

config OVE_PM_IDLE_THRESHOLD_MS
    int "Idle threshold (ms)"
    default 10
    depends on OVE_PM
    help
      Minimum idle duration before transitioning from ACTIVE to IDLE.

config OVE_PM_STANDBY_THRESHOLD_MS
    int "Standby threshold (ms)"
    default 1000
    depends on OVE_PM
    help
      Minimum idle duration before transitioning from IDLE to STANDBY.

config OVE_PM_DEEP_SLEEP_THRESHOLD_MS
    int "Deep sleep threshold (ms)"
    default 10000
    depends on OVE_PM
    help
      Minimum idle duration before transitioning to DEEP_SLEEP.

config OVE_PM_STATS
    bool "Power statistics tracking"
    default y
    depends on OVE_PM
    help
      Track cumulative time in each power state and transition
      counts. Adds ~64 bytes of RAM overhead.

config OVE_PM_BUDGET
    bool "Power budget enforcement"
    default n
    depends on OVE_PM && OVE_PM_STATS
    help
      Enable power budget target tracking. The policy engine
      can use the budget to adjust sleep depth automatically.

endmenu

menu "Simulation"

config OVE_SIM
    bool "Simulation plugin framework"
    default y if OVE_RTOS_POSIX
    help
      Enable the simulation plugin framework. Replaces bare-stub
      HAL implementations with plugin-aware versions that support
      virtual peripherals, sensor injection, and host-side
      web dashboard visualization.
      Enabled by default for POSIX builds (browser-based dashboard).

config OVE_SIM_TRANSPORT_DIRECT
    bool
    default y if OVE_RTOS_POSIX && OVE_SIM

config OVE_SIM_TRANSPORT_SHM
    bool
    default y if !OVE_RTOS_POSIX && OVE_SIM

config OVE_SIM_TRANSPORT_WASM
    bool
    default y if OVE_BOARD_WASM && OVE_SIM

config OVE_SIM_DASHBOARD
    bool "Web dashboard"
    default y if OVE_SIM
    depends on OVE_SIM
    help
      Enable the browser-based simulation dashboard served over
      a local WebSocket server. Displays framebuffer, audio,
      LED states, GPIO matrix, and sensor controls.

config OVE_SIM_DASHBOARD_PORT
    int "Dashboard HTTP port"
    default 8080
    depends on OVE_SIM_DASHBOARD

endmenu

comment "Heap policy"

config OVE_ZERO_HEAP
    bool "Zero-heap build (disable all dynamic allocation)"
    default n
    help
      All oveRTOS create/destroy paths use static storage; the
      _init()/_deinit() APIs with caller-supplied storage remain
      available for loops, arrays, and embedded objects.  Backend
      kernels are configured for fully-static operation:
        - FreeRTOS: configSUPPORT_DYNAMIC_ALLOCATION=0; truly static.
        - Zephyr:   no DYNAMIC_THREAD, no kernel heap, picolibc;
                    truly static.  Block-scope ove_thread_create /
                    ove_workqueue_create emit K_THREAD_STACK_DEFINE-
                    equivalent statics, so k_thread_stack_alloc is
                    not pulled in.
        - NuttX:    static sizing of every preallocated pool via
                    Kconfig; all threads / queues / files / sockets
                    must be created during init; ove_heap_lock() runs
                    at the start of ove_run() and traps any subsequent
                    malloc / kmm_malloc.  Boot-time TCB + stack
                    allocations from task_create are accepted as the
                    irreducible carve-out (see backends/nuttx/
                    nuttx_heap_lock.c for the trap and
                    config/templates/nuttx_defconfig.j2 for the sizing
                    knobs).
        - POSIX:    sim only; pthread implies malloc'd stacks.

if OVE_ZERO_HEAP

comment "NuttX zero-heap sizing"
    depends on OVE_RTOS_NUTTX

config OVE_NUTTX_MAX_TASKS
    int "Maximum concurrent tasks"
    default 16
    depends on OVE_RTOS_NUTTX
    help
      Pinned at compile time as CONFIG_MAX_TASKS — the kernel
      allocates the task table from the static .bss region rather
      than growing it dynamically.

config OVE_NUTTX_FD_BLOCK
    int "File descriptors per task block"
    default 8
    depends on OVE_RTOS_NUTTX

config OVE_NUTTX_PREALLOC_TIMERS
    int "Pre-allocated POSIX timers"
    default 8
    depends on OVE_RTOS_NUTTX

config OVE_NUTTX_PREALLOC_MQ_MSGS
    int "Pre-allocated message-queue messages"
    default 16
    depends on OVE_RTOS_NUTTX

config OVE_NUTTX_TCP_CONNS
    int "TCP connection slots"
    default 8
    depends on OVE_RTOS_NUTTX && OVE_NET

config OVE_NUTTX_UDP_CONNS
    int "UDP connection slots"
    default 8
    depends on OVE_RTOS_NUTTX && OVE_NET

config OVE_NUTTX_IOB_NBUFFERS
    int "Network IOB buffer count"
    default 24
    depends on OVE_RTOS_NUTTX && OVE_NET

config OVE_NUTTX_IOB_BUFSIZE
    int "Network IOB buffer size (bytes)"
    default 196
    depends on OVE_RTOS_NUTTX && OVE_NET

config OVE_NUTTX_HEAP_LOCK
    bool "Wrap malloc/kmm_malloc with post-init trap"
    default y
    depends on OVE_RTOS_NUTTX
    help
      Enables --wrap=malloc,kmm_malloc,... at link time so that
      ove_heap_lock() (called from ove_run()) traps any kernel-mm
      allocation that escapes the static-sizing / boot-time-creation
      discipline.  Implementation in backends/nuttx/nuttx_heap_lock.c.

endif # OVE_ZERO_HEAP

endmenu

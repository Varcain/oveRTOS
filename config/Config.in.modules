menu "oveRTOS Modules"

comment "Core modules (always enabled)"

config OVE_THREAD
    bool
    default y
    help
      Thread management. Always enabled — required by ove_app_run().

config OVE_APP
    bool
    default y
    help
      Application lifecycle. Always enabled.

comment "Optional modules"

config OVE_SYNC
    bool "Synchronization primitives (mutex, sem, event, condvar)"
    default y

config OVE_AUDIO
    bool "Audio subsystem"
    default y
    select OVE_I2S if OVE_RTOS_FREERTOS

config OVE_AUDIO_NODE_CONVERTER
    bool "Audio format converter node"
    depends on OVE_AUDIO
    default y

config OVE_AUDIO_NODE_GAIN
    bool "Audio gain node"
    depends on OVE_AUDIO

config OVE_AUDIO_NODE_TAP
    bool "Audio tap/observer node"
    depends on OVE_AUDIO

config OVE_AUDIO_NODE_CHANNEL_MAP
    bool "Audio channel mapper node"
    depends on OVE_AUDIO

config OVE_FS
    bool "File system"
    default y

config OVE_CONSOLE
    bool "Console I/O"
    default y

config OVE_LOG
    bool "Logging"
    default y
    depends on OVE_CONSOLE

config OVE_TIME
    bool "Time and delay functions"
    default y

config OVE_BOARD
    bool "Board descriptor and init"
    default y

config OVE_GPIO
    bool "GPIO control"
    default y

config OVE_LED
    bool "LED control"
    default y
    select OVE_GPIO

config OVE_BSP
    bool "Board support package (compat — selects board+gpio+led)"
    default y
    select OVE_BOARD
    select OVE_GPIO
    select OVE_LED

config OVE_LVGL
    bool "LVGL UI framework"
    default y
    select OVE_SYNC

config OVE_QUEUE
    bool "Message queues"
    default y

config OVE_TIMER
    bool "Software timers"
    default y

config OVE_EVENTGROUP
    bool "Event groups"
    default y

config OVE_SHELL
    bool "Interactive shell"
    default y
    depends on OVE_CONSOLE

config OVE_NVS
    bool "Non-volatile storage"
    default y

config OVE_WATCHDOG
    bool "Watchdog timer"
    default y

config OVE_WORKQUEUE
    bool "Work queues"
    default n

config OVE_STREAM
    bool "Stream I/O"
    default n

menu "Bus drivers"

config OVE_UART
    bool "UART serial"
    default n
    select OVE_SYNC
    select OVE_STREAM
    help
      General-purpose UART driver with configurable baud rate,
      framing, async RX buffering, and thread-safe TX.

config OVE_SPI
    bool "SPI bus master"
    default n
    select OVE_SYNC
    select OVE_GPIO
    help
      SPI master driver with configurable clock, mode, and
      software CS management via GPIO. Thread-safe bus locking.

config OVE_I2C
    bool "I2C bus master"
    default n
    select OVE_SYNC
    help
      I2C master driver with standard/fast/fast-plus speed,
      register-level convenience APIs, and thread-safe bus locking.

config OVE_I2S
    bool "I2S / SAI audio bus"
    default n
    help
      I2S audio bus driver with DMA double-buffered streaming,
      half-buffer completion callbacks, and configurable sample
      rate, bit depth, and channel count. Codec initialisation
      is board-specific and not part of this driver.

endmenu

menu "Machine learning"

config OVE_INFER
    bool "ML inference engine (LiteRT / TF Lite Micro)"
    default n
    depends on OVE_TIME && OVE_CONSOLE
    help
      Portable C API for running .tflite models via LiteRT
      (formerly TensorFlow Lite Micro). Requires C++ support
      in the toolchain.

config OVE_INFER_CMSIS_NN
    bool "CMSIS-NN kernel acceleration"
    default n
    depends on OVE_INFER
    help
      Use ARM CMSIS-NN optimized kernels for int8 quantized
      operators. Provides 2-10x speedup on Cortex-M4/M7.
      Automatically disabled on non-ARM targets.

config OVE_INFER_ARENA_SIZE
    int "Default tensor arena size (bytes)"
    default 65536
    depends on OVE_INFER
    help
      Default arena allocation for models that don't specify
      a custom size. Can be overridden per-model via
      ove_model_config.arena_size.

endmenu

menu "Networking"

config OVE_NET
    bool "Socket API (TCP/UDP) and DNS"
    default n
    help
      BSD-like socket API with DNS resolution. Each backend uses
      its native TCP/IP stack (POSIX sockets, lwIP, Zephyr net,
      NuttX sockets).

config OVE_NET_TLS
    bool "TLS (mbedTLS)"
    default n
    depends on OVE_NET
    help
      Portable TLS layer using mbedTLS. Provides encrypted
      sockets for HTTPS and secure MQTT.

config OVE_NET_HTTP
    bool "HTTP/1.1 client"
    default n
    depends on OVE_NET
    help
      Portable HTTP/1.1 client for REST APIs. Supports both
      plain HTTP and HTTPS (when OVE_NET_TLS is enabled).

config OVE_NET_MQTT
    bool "MQTT 3.1.1 client"
    default n
    depends on OVE_NET
    help
      Lightweight MQTT 3.1.1 client for IoT pub/sub messaging.
      Supports QoS 0/1, keep-alive, and optional TLS.

config OVE_NET_MQTT_RX_BUF
    int "MQTT receive buffer size (bytes)"
    default 1024
    depends on OVE_NET_MQTT

config OVE_NET_MQTT_TX_BUF
    int "MQTT transmit buffer size (bytes)"
    default 512
    depends on OVE_NET_MQTT

config OVE_NET_MQTT_MAX_SUBS
    int "Max concurrent MQTT subscriptions"
    default 8
    depends on OVE_NET_MQTT
    help
      Maximum number of topic filters tracked for wildcard matching.

config OVE_NET_SNTP
    bool "SNTP time synchronization"
    default n
    depends on OVE_NET && OVE_TIME
    help
      Simple NTP client that queries a time server over UDP and
      stores a UTC offset for wall-clock time correction.

config OVE_NET_TLS_HEAP_SIZE
    int "TLS static heap size (bytes)"
    default 32768
    depends on OVE_NET_TLS
    help
      Size of the static buffer used by mbedTLS for internal
      allocations in zero-heap mode. 32KB is sufficient for
      TLS 1.2 with RSA-2048. Increase for larger certificates.

config OVE_NET_HTTP_MAX_RESPONSE
    int "HTTP client max response buffer size (bytes)"
    default 8192
    depends on OVE_NET_HTTP
    help
      Maximum HTTP response size in zero-heap mode where the buffer
      cannot grow dynamically.

config OVE_NET_HTTPD_MAX_BODY
    int "HTTPD max POST body size (bytes)"
    default 1024
    depends on OVE_NET_HTTPD

config OVE_NET_HTTPD
    bool "Embedded HTTP server"
    default n
    depends on OVE_NET
    help
      Lightweight single-threaded HTTP server with REST API
      routing and a built-in web dashboard for device management
      (LEDs, GPIO, network config, log console).

config OVE_NET_HTTPD_WS
    bool "WebSocket support"
    default n
    depends on OVE_NET_HTTPD
    help
      Adds RFC 6455 WebSocket upgrade and frame parsing to the
      embedded HTTP server.  Enables real-time bidirectional push
      from device to browser without polling.

config OVE_NET_HTTPD_WS_MAX_CONNS
    int "Max concurrent WebSocket connections"
    default 4
    depends on OVE_NET_HTTPD_WS

config OVE_NET_HTTPD_WS_MAX_FRAME
    int "Max WebSocket frame payload (bytes)"
    default 1024
    depends on OVE_NET_HTTPD_WS

endmenu

comment "Heap policy"

config OVE_ZERO_HEAP
    bool "Zero-heap build (disable all dynamic allocation)"
    default n
    help
      When enabled, _create()/_destroy() become macros that auto-generate
      per-call-site static storage instead of using the heap.  No dynamic
      allocation occurs.  The _init()/_deinit() APIs with caller-supplied
      storage remain available for explicit control (loops, arrays, structs).

endmenu

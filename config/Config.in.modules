menu "oveRTOS Modules"

comment "Core modules (always enabled)"

config OVE_THREAD
    bool
    default y
    help
      Thread management. Always enabled — required by ove_app_run().

config OVE_APP
    bool
    default y
    help
      Application lifecycle. Always enabled.

comment "Optional modules"

config OVE_SYNC
    bool "Synchronization primitives (mutex, sem, event, condvar)"
    default n

config OVE_AUDIO
    bool "Audio subsystem"
    default n
    select OVE_I2S if OVE_RTOS_FREERTOS && !OVE_BOARD_QEMU_MPS2_AN500

config OVE_AUDIO_NODE_CONVERTER
    bool "Audio format converter node"
    depends on OVE_AUDIO
    default n

config OVE_AUDIO_NODE_GAIN
    bool "Audio gain node"
    depends on OVE_AUDIO
    help
      Per-channel linear gain stage in the audio graph. Configured via
      ove_audio_node_gain_set(); applied in-place during process().
      Enable when an app needs runtime volume control or fader
      automation without modifying the source node.

config OVE_AUDIO_NODE_TAP
    bool "Audio tap/observer node"
    depends on OVE_AUDIO
    help
      Read-only observer node that copies frames flowing through a
      point in the graph into a ring buffer readable from another
      thread (e.g. for metering, waveform display, or logging). Does
      not modify the audio path.

config OVE_AUDIO_NODE_CHANNEL_MAP
    bool "Audio channel mapper node"
    depends on OVE_AUDIO

config OVE_FS
    bool "File system"
    default n

config OVE_CONSOLE
    bool "Console I/O"
    default n

config OVE_LOG
    bool "Logging"
    default n
    depends on OVE_CONSOLE

config OVE_TIME
    bool "Time and delay functions"
    default n

config OVE_BOARD
    bool "Board descriptor and init"
    default n

config OVE_GPIO
    bool "GPIO control"
    default n

config OVE_LED
    bool "LED control"
    default n
    select OVE_GPIO

config OVE_BSP
    bool "Board support package (compat — selects board+gpio+led)"
    default n
    select OVE_BOARD
    select OVE_GPIO
    select OVE_LED

config OVE_LVGL
    bool "LVGL UI framework"
    default n
    select OVE_SYNC

config OVE_QUEUE
    bool "Message queues"
    default n

config OVE_TIMER
    bool "Software timers"
    default n

config OVE_EVENTGROUP
    bool "Event groups"
    default n

config OVE_SHELL
    bool "Interactive shell"
    default n
    depends on OVE_CONSOLE

config OVE_NVS
    bool "Non-volatile storage"
    default n

config OVE_WATCHDOG
    bool "Watchdog timer"
    default n

config OVE_WORKQUEUE
    bool "Work queues"
    default n

config OVE_STREAM
    bool "Stream I/O"
    default n

menu "Bus drivers"

config OVE_UART
    bool "UART serial"
    default n
    select OVE_SYNC
    select OVE_STREAM
    help
      General-purpose UART driver with configurable baud rate,
      framing, async RX buffering, and thread-safe TX.

config OVE_SPI
    bool "SPI bus master"
    default n
    select OVE_SYNC
    select OVE_GPIO
    help
      SPI master driver with configurable clock, mode, and
      software CS management via GPIO. Thread-safe bus locking.

config OVE_I2C
    bool "I2C bus master"
    default n
    select OVE_SYNC
    help
      I2C master driver with standard/fast/fast-plus speed,
      register-level convenience APIs, and thread-safe bus locking.

config OVE_I2S
    bool "I2S / SAI audio bus"
    default n
    help
      I2S audio bus driver with DMA double-buffered streaming,
      half-buffer completion callbacks, and configurable sample
      rate, bit depth, and channel count. Codec initialisation
      is board-specific and not part of this driver.

endmenu

menu "Machine learning"

config OVE_INFER
    bool "ML inference engine (LiteRT / TF Lite Micro)"
    default n
    depends on OVE_TIME && OVE_CONSOLE
    help
      Portable C API for running .tflite models via LiteRT
      (formerly TensorFlow Lite Micro). Requires C++ support
      in the toolchain.

config OVE_INFER_CMSIS_NN
    bool "CMSIS-NN kernel acceleration"
    default n
    depends on OVE_INFER
    help
      Use ARM CMSIS-NN optimized kernels for int8 quantized
      operators. Provides 2-10x speedup on Cortex-M4/M7.
      Automatically disabled on non-ARM targets.

config OVE_INFER_ARENA_SIZE
    int "Default tensor arena size (bytes)"
    default 65536
    depends on OVE_INFER
    help
      Default arena allocation for models that don't specify
      a custom size. Can be overridden per-model via
      ove_model_config.arena_size.

endmenu

menu "Networking"

config OVE_NET
    bool "Socket API (TCP/UDP) and DNS"
    default n
    help
      BSD-like socket API with DNS resolution. Each backend uses
      its native TCP/IP stack (POSIX sockets, lwIP, Zephyr net,
      NuttX sockets).

config OVE_NET_TLS
    bool "TLS (mbedTLS)"
    default n
    depends on OVE_NET
    help
      Portable TLS layer using mbedTLS. Provides encrypted
      sockets for HTTPS and secure MQTT.

config OVE_NET_HTTP
    bool "HTTP/1.1 client"
    default n
    depends on OVE_NET
    help
      Portable HTTP/1.1 client for REST APIs. Supports both
      plain HTTP and HTTPS (when OVE_NET_TLS is enabled).

config OVE_NET_MQTT
    bool "MQTT 3.1.1 client"
    default n
    depends on OVE_NET
    help
      Lightweight MQTT 3.1.1 client for IoT pub/sub messaging.
      Supports QoS 0/1, keep-alive, and optional TLS.

config OVE_NET_MQTT_RX_BUF
    int "MQTT receive buffer size (bytes)"
    default 1024
    depends on OVE_NET_MQTT

config OVE_NET_MQTT_TX_BUF
    int "MQTT transmit buffer size (bytes)"
    default 512
    depends on OVE_NET_MQTT

config OVE_NET_MQTT_MAX_SUBS
    int "Max concurrent MQTT subscriptions"
    default 8
    depends on OVE_NET_MQTT
    help
      Maximum number of topic filters tracked for wildcard matching.

config OVE_NET_SNTP
    bool "SNTP time synchronization"
    default n
    depends on OVE_NET && OVE_TIME
    help
      Simple NTP client that queries a time server over UDP and
      stores a UTC offset for wall-clock time correction.

config OVE_NET_TLS_HEAP_SIZE
    int "TLS static heap size (bytes)"
    default 32768
    depends on OVE_NET_TLS
    help
      Size of the static buffer used by mbedTLS for internal
      allocations in zero-heap mode. 32KB is sufficient for
      TLS 1.2 with RSA-2048. Increase for larger certificates.

config OVE_NET_HTTP_MAX_RESPONSE
    int "HTTP client max response buffer size (bytes)"
    default 8192
    depends on OVE_NET_HTTP
    help
      Maximum HTTP response size in zero-heap mode where the buffer
      cannot grow dynamically.

config OVE_NET_HTTPD_MAX_BODY
    int "HTTPD max POST body size (bytes)"
    default 1024
    depends on OVE_NET_HTTPD

config OVE_NET_HTTPD
    bool "Embedded HTTP server"
    default n
    depends on OVE_NET
    help
      Lightweight single-threaded HTTP server with REST API
      routing and a built-in web dashboard for device management
      (LEDs, GPIO, network config, log console).

config OVE_NET_HTTPD_WS
    bool "WebSocket support"
    default n
    depends on OVE_NET_HTTPD
    help
      Adds RFC 6455 WebSocket upgrade and frame parsing to the
      embedded HTTP server.  Enables real-time bidirectional push
      from device to browser without polling.

config OVE_NET_HTTPD_WS_MAX_CONNS
    int "Max concurrent WebSocket connections"
    default 4
    depends on OVE_NET_HTTPD_WS

config OVE_NET_HTTPD_WS_MAX_FRAME
    int "Max WebSocket frame payload (bytes)"
    default 1024
    depends on OVE_NET_HTTPD_WS

endmenu

menu "Power Management"

config OVE_PM
    bool "Power management framework"
    default n
    select OVE_SYNC
    select OVE_TIME
    help
      Unified power management with sleep state machine,
      peripheral power domains, tickless idle integration,
      wake source management, and runtime power statistics.

config OVE_PM_MAX_WAKE_SOURCES
    int "Maximum registered wake sources"
    default 8
    depends on OVE_PM
    help
      Maximum number of concurrently registered wake sources.
      Each entry consumes ~32 bytes of static RAM.

config OVE_PM_MAX_NOTIFIERS
    int "Maximum transition notifiers"
    default 4
    depends on OVE_PM
    help
      Maximum number of pre/post sleep notification callbacks.

config OVE_PM_IDLE_THRESHOLD_MS
    int "Idle threshold (ms)"
    default 10
    depends on OVE_PM
    help
      Minimum idle duration before transitioning from ACTIVE to IDLE.

config OVE_PM_STANDBY_THRESHOLD_MS
    int "Standby threshold (ms)"
    default 1000
    depends on OVE_PM
    help
      Minimum idle duration before transitioning from IDLE to STANDBY.

config OVE_PM_DEEP_SLEEP_THRESHOLD_MS
    int "Deep sleep threshold (ms)"
    default 10000
    depends on OVE_PM
    help
      Minimum idle duration before transitioning to DEEP_SLEEP.

config OVE_PM_STATS
    bool "Power statistics tracking"
    default y
    depends on OVE_PM
    help
      Track cumulative time in each power state and transition
      counts. Adds ~64 bytes of RAM overhead.

config OVE_PM_BUDGET
    bool "Power budget enforcement"
    default n
    depends on OVE_PM && OVE_PM_STATS
    help
      Enable power budget target tracking. The policy engine
      can use the budget to adjust sleep depth automatically.

endmenu

menu "Simulation"

config OVE_SIM
    bool "Simulation plugin framework"
    default y if OVE_RTOS_POSIX
    help
      Enable the simulation plugin framework. Replaces bare-stub
      HAL implementations with plugin-aware versions that support
      virtual peripherals, sensor injection, and host-side
      web dashboard visualization.
      Enabled by default for POSIX builds (browser-based dashboard).

config OVE_SIM_TRANSPORT_DIRECT
    bool
    default y if OVE_RTOS_POSIX && OVE_SIM

config OVE_SIM_TRANSPORT_SHM
    bool
    default y if !OVE_RTOS_POSIX && OVE_SIM

config OVE_SIM_TRANSPORT_WASM
    bool
    default y if OVE_BOARD_WASM && OVE_SIM

config OVE_SIM_DASHBOARD
    bool "Web dashboard"
    default y if OVE_SIM
    depends on OVE_SIM
    help
      Enable the browser-based simulation dashboard served over
      a local WebSocket server. Displays framebuffer, audio,
      LED states, GPIO matrix, and sensor controls.

config OVE_SIM_DASHBOARD_PORT
    int "Dashboard HTTP port"
    default 8080
    depends on OVE_SIM_DASHBOARD

endmenu

comment "Heap policy"

config OVE_ZERO_HEAP
    bool "Zero-heap build (disable all dynamic allocation)"
    default n
    help
      When enabled, _create()/_destroy() become macros that auto-generate
      per-call-site static storage instead of using the heap.  No dynamic
      allocation occurs.  The _init()/_deinit() APIs with caller-supplied
      storage remain available for explicit control (loops, arrays, structs).

endmenu

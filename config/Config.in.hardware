menu "Hardware Target"

choice
    prompt "Target board"

config OVE_BOARD_STM32F746G_DISCO
    bool "STM32F746G-DISCO"
    help
      STMicroelectronics STM32F746G Discovery board.
      ARM Cortex-M7 @ 216 MHz, 1 MB Flash, 320 KB SRAM.

config OVE_BOARD_QEMU_MPS2_AN500
    bool "QEMU MPS2-AN500 (Cortex-M7)"
    depends on OVE_RTOS_FREERTOS || OVE_RTOS_ZEPHYR || OVE_RTOS_NUTTX
    # The Linux personality is headless: no sim framework, trace stream, or
    # profiler (all of which pull the sim display transport). Normal an500
    # builds keep the sim dashboard.
    select OVE_SIM if !OVE_LINUX
    select OVE_DEBUG_BUILD
    help
      ARM MPS2-AN500 board emulated by QEMU.
      Cortex-M7 @ 25 MHz, 4 MB Flash, 4 MB RAM.
      Uses semihosting for I/O and sim dashboard for display
      (the Linux personality build is headless — semihosting console only).

config OVE_BOARD_QEMU_MPS2_AN521
    bool "QEMU MPS2-AN521 (Cortex-M33, USERSPACE)"
    depends on OVE_RTOS_ZEPHYR
    select OVE_DEBUG_BUILD
    help
      ARM MPS2-AN521 board emulated by QEMU.
      Cortex-M33 @ 25 MHz, 4 MB Flash, 4 MB RAM, MPU + CONFIG_USERSPACE.
      The substrate for the Linux personality: runs a loaded program
      unprivileged and traps its svc. Console + exit via semihosting.


config OVE_BOARD_HOST_PC
    bool "Host PC (native)"
    depends on OVE_RTOS_POSIX
    select OVE_DEBUG_BUILD
    help
      Native host development. Uses browser dashboard for display and audio.

config OVE_BOARD_WASM
    bool "WebAssembly (browser)"
    depends on OVE_RTOS_POSIX
    select OVE_SIM
    help
      Run in a web browser via WebAssembly + Emscripten.
      Compiles firmware + LVGL to WASM, renders in an HTML
      canvas, hostable as static files on GitHub Pages.

endchoice

config OVE_BOARD_NAME
    string
    default "stm32f746g-discovery" if OVE_BOARD_STM32F746G_DISCO
    default "qemu-mps2-an500" if OVE_BOARD_QEMU_MPS2_AN500
    default "qemu-mps2-an521" if OVE_BOARD_QEMU_MPS2_AN521
    default "host" if OVE_BOARD_HOST_PC
    default "wasm" if OVE_BOARD_WASM

config OVE_FLASH_SIZE
    int
    default 1048576 if OVE_BOARD_STM32F746G_DISCO
    default 4194304 if OVE_BOARD_QEMU_MPS2_AN500
    default 4194304 if OVE_BOARD_QEMU_MPS2_AN521
    default 0 if OVE_BOARD_HOST_PC || OVE_BOARD_WASM

config OVE_RAM_SIZE
    int
    default 327680 if OVE_BOARD_STM32F746G_DISCO
    default 4194304 if OVE_BOARD_QEMU_MPS2_AN500
    default 4194304 if OVE_BOARD_QEMU_MPS2_AN521
    default 0 if OVE_BOARD_HOST_PC || OVE_BOARD_WASM

config OVE_MCU
    string
    default "STM32F746xx" if OVE_BOARD_STM32F746G_DISCO
    default "CMSDK_CM7" if OVE_BOARD_QEMU_MPS2_AN500
    default "CMSDK_CM33" if OVE_BOARD_QEMU_MPS2_AN521
    default "host" if OVE_BOARD_HOST_PC
    default "wasm32" if OVE_BOARD_WASM

endmenu

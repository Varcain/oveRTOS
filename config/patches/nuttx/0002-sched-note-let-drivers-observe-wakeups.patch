   ((drv)->ops->suspend && ((drv)->ops->suspend(drv, tcb), true))
 #define note_resume(drv, tcb)                                                \
   ((drv)->ops->resume && ((drv)->ops->resume(drv, tcb), true))
+#define note_ready(drv, tcb)                                                 \
+  ((drv)->ops->ready && ((drv)->ops->ready(drv, tcb), true))
 #define note_cpu_start(drv, tcb, cpu)                                        \
   ((drv)->ops->cpu_start && ((drv)->ops->cpu_start(drv, tcb, cpu), true))
 #define note_cpu_started(drv, tcb)                                           \
@@ -778,6 +780,27 @@ void sched_note_suspend(FAR struct tcb_s *tcb)
     }
 }
 
+void sched_note_ready(FAR struct tcb_s *tcb)
+{
+  FAR struct note_driver_s **driver;
+
+  /* A task became runnable: it was inserted into the ready-to-run (or
+   * pending) list, but has not necessarily been scheduled yet.  This is
+   * the wake-up edge that suspend/resume notes cannot express: without
+   * it, consumers only see BLOCKED -> RUNNING and lose the ready wait.
+   * No binary note is emitted; drivers that want a record can implement
+   * the ready op themselves.
+   */
+
+  for (driver = g_note_drivers; *driver; driver++)
+    {
+      if (note_isenabled_switch(*driver))
+        {
+          (void)note_ready(*driver, tcb);
+        }
+    }
+}
+
 void sched_note_resume(FAR struct tcb_s *tcb)
 {
   struct note_resume_s note;

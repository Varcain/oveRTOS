{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "oveRTOS Board Descriptor",
  "description": "Describes hardware wiring for a oveRTOS-supported board.",
  "type": "object",
  "required": ["board", "rtos"],
  "properties": {
    "board": {
      "type": "object",
      "required": ["name", "mcu_family", "mcu", "symbol", "title"],
      "properties": {
        "name":        { "type": "string" },
        "mcu_family":  { "type": "string" },
        "mcu":         { "type": "string" },
        "symbol":      { "type": "string", "pattern": "^OVE_BOARD_[A-Z0-9_]+$",
                         "description": "Kconfig symbol selecting the board" },
        "title":       { "type": "string", "description": "Board menu prompt" },
        "description": { "type": "string", "description": "Kconfig help text; the MCU, clock, flash and RAM are appended" },
        "default":     { "type": "boolean", "description": "The board the Kconfig choice selects by default" },
        "kconfig":     { "type": "string", "description": "Kconfig attribute lines (select, imply, ...) added to the board symbol" }
      },
      "additionalProperties": false
    },
    "rtos": {
      "type": "object",
      "description": "The engines the board supports, each with the upstream board it builds. An engine missing here is unsupported.",
      "minProperties": 1,
      "properties": {
        "freertos": {
          "type": "object",
          "additionalProperties": false
        },
        "nuttx": {
          "type": "object",
          "required": ["board", "config"],
          "properties": {
            "board":  { "type": "string", "description": "NuttX board directory, e.g. stm32f746g-disco" },
            "config": { "type": "string", "description": "NuttX board config, e.g. nsh" }
          },
          "additionalProperties": false
        },
        "zephyr": {
          "type": "object",
          "required": ["board"],
          "properties": {
            "board": { "type": "string", "description": "Zephyr board target (west -b), e.g. mps2/an521/cpu0" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "clock": {
      "type": "object",
      "properties": {
        "hse_freq_mhz": { "type": "integer", "minimum": 1 },
        "sysclk_mhz":   { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "memory": {
      "type": "object",
      "properties": {
        "flash_kb":    { "type": "integer", "minimum": 0 },
        "ram_kb":      { "type": "integer", "minimum": 0 },
        "sdram_kb":    { "type": "integer", "minimum": 0 },
        "sdram_start": { "type": "string", "pattern": "^0x[0-9a-fA-F]+$" }
      },
      "additionalProperties": false
    },
    "gpio": {
      "type": "object",
      "properties": {
        "port_count":    { "type": "integer", "minimum": 1 },
        "pins_per_port": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "leds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["port", "pin"],
        "properties": {
          "port":       { "type": "integer", "minimum": 0 },
          "pin":        { "type": "integer", "minimum": 0 },
          "active_low": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "audio": {
      "type": "object",
      "properties": {
        "i2s": {
          "type": "object",
          "properties": {
            "sample_rate":     { "type": "integer", "minimum": 1 },
            "bit_depth":       { "type": "integer", "enum": [8, 16, 24, 32] },
            "channels":        { "type": "integer", "minimum": 1 },
            "buffer_samples":  { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "codec": {
          "type": "object",
          "properties": {
            "type":     { "type": "string" },
            "i2c_addr": { "type": "string", "pattern": "^0x[0-9a-fA-F]+$" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "display": {
      "type": "object",
      "properties": {
        "width":        { "type": "integer", "minimum": 1 },
        "height":       { "type": "integer", "minimum": 1 },
        "color_format": { "type": "string" }
      },
      "additionalProperties": false
    },
    "serial": {
      "type": "object",
      "properties": {
        "console": {
          "type": "object",
          "properties": {
            "instance":       { "type": "string", "description": "Console UART as NuttX names it, e.g. USART1, CMSDK_UART0" },
            "baud":           { "type": "integer", "minimum": 1 },
            "rx_buffer_size": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "sdcard": {
      "type": "object",
      "description": "Present when the board has an SD card slot.",
      "additionalProperties": false
    },
    "defconfig": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Board-specific Kconfig lines merged during fragment-based configuration."
    },
    "rtos_defconfig": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" }
      },
      "description": "Per-RTOS Kconfig overrides, keyed by RTOS name (freertos, zephyr, nuttx, posix)."
    },
    "variants": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" }
      },
      "description": "Named variants of the board. A variant's name stands in for the board in '<board>.<rtos>.<app>'; its Kconfig lines are applied on top of the board's own."
    }
  },
  "additionalProperties": false
}

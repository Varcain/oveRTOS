# NuttX defconfig overlay for the Linux personality on stm32f746g-discovery (real hardware).
# Applied automatically when CONFIG_OVE_LINUX=y (layer 2b, see
# config/ove-cli/ove/rtos_menuconfig.py:_merge_nuttx_layers).
#
# The personality loads FDPIC programs and runs them UNPRIVILEGED behind an MPU view the seam
# programs DIRECTLY via raw registers (backends/nuttx/nuttx_lnx_trap.c: ove_lnx_mpu_init + PRIVDEFENA
# + a MemManage containment handler) — done in plain CONFIG_BUILD_FLAT, no CONFIG_BUILD_PROTECTED. We
# own the MPU, so NuttX's own arm_mpu.c must stay OUT of the build. It is already off by default on
# this board; pin it off so a base-config change can't silently re-enable it and fight the seam.
CONFIG_ARM_MPU=n

# The personality's svc handler runs on NuttX's interrupt stack and calls into the syscall core + the
# app's I/O callbacks (including the polled USART1 console); give it headroom over the 2 KB default.
CONFIG_ARCH_INTERRUPTSTACK=4096

# Phase 2 inter-program isolation: a note driver (backends/nuttx/nuttx_lnx_trap.c) hooks EVERY
# context switch — including round-robin preemption between same-priority program tasks, which the
# seam's syscall path cannot see — to reprogram the MPU to the incoming program's OWN region. That
# hook is the sched_note switch instrumentation, dispatched through the note-driver framework
# (CONFIG_DRIVERS_NOTE compiles note_driver.c = sched_note_* + note_driver_register). We register
# our own driver only; no note buffer (NOTERAM/etc.) is enabled.
#
# On the real M7 the per-switch reprogram narrows the MPU to only the running program's pool region;
# every OTHER program's region then falls to the ARM default map, which types the external SDRAM at
# 0xC0000000 as DEVICE. ove_lnx_mpu_init therefore keeps a privileged-only whole-pool base region so
# the coordinator still sees all pool memory as Normal (an unaligned access to Device memory
# Usage-Faults on silicon — QEMU's an500 PSRAM default is Normal, so that build never hit it).
CONFIG_DRIVERS_NOTE=y
CONFIG_DRIVERS_NOTERAM=n
CONFIG_SCHED_INSTRUMENTATION=y
CONFIG_SCHED_INSTRUMENTATION_SWITCH=y

# QUADSPI controller for the QSPI-XIP rootfs (CONFIG_OVE_LINUX_ROOTFS_QSPI). board_init.c uses
# stm32f7_qspi_initialize + stm32f7_qspi_enter_memorymapped to memory-map the N25Q128A NOR at
# 0x90000000 (read-only, 0xEB quad). Do NOT enable CONFIG_MTD_N25QXXX — its board setup mounts
# NXFFS on the NOR, which would try to format/erase the already-programmed rootfs. (Bank 1 +
# 16 MB flash size are the Kconfig defaults.)
CONFIG_STM32F7_QUADSPI=y
CONFIG_STM32F7_QSPI_POLLING=y
CONFIG_STM32F7_QSPI_FLASH_SIZE=16777216

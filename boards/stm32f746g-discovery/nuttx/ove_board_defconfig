# LD1 (PI1) is board.yaml's LED, driven through the ove GPIO HAL (src/gpio.c),
# so neither NuttX's OS-state LED driver nor its /dev/userleds may claim it.
# (Without ARCH_LEDS the board still compiles stm32_userleds.c; patch 0015.)
# CONFIG_ARCH_LEDS is not set
# CONFIG_USERLED is not set
CONFIG_WATCHDOG=y

# LTDC framebuffer (base and size come from board.yaml)
CONFIG_BOARD_LATE_INITIALIZE=y
CONFIG_DRIVERS_VIDEO=y
CONFIG_VIDEO_FB=y
CONFIG_STM32F7_FMC=y
CONFIG_STM32F7_LTDC=y
# CONFIG_STM32F7_LTDC_L2 is not set
# CONFIG_STM32F7_FB_CMAP is not set
CONFIG_FS_RAMMAP=y

# DTCM for DMA-safe audio buffers (excluded from heap → 2 MM regions)
CONFIG_ARMV7M_DTCM=y
CONFIG_STM32F7_DTCMEXCLUDE=y
CONFIG_MM_REGIONS=2

# --- Flash trim: drop NSH shell + apps/builtin machinery ----------------
# The upstream stm32f746g-disco:nsh base config pulls in ~45 KB of code
# we never call: an interactive shell, the `dd` builtin, the mkfatfs
# utility, and the binfmt-based builtin-app loader. Entry into oveRTOS
# is via CONFIG_INIT_ENTRYPOINT (set in the j2 template),
# so none of this is on the boot path.
# CONFIG_SYSTEM_NSH is not set
# CONFIG_NSH_LIBRARY is not set
# CONFIG_NSH_READLINE is not set
# CONFIG_NSH_BUILTIN_APPS is not set
# CONFIG_SYSTEM_READLINE is not set
# CONFIG_SYSTEM_DD is not set
# CONFIG_FSUTILS_MKFATFS is not set
# CONFIG_BUILTIN is not set
# CONFIG_BINFMT_LOADABLE is not set

# --- Fault diagnostic: print Cortex-M fault info on hardfault ---
CONFIG_DEBUG_HARDFAULT_ALERT=y
CONFIG_DEBUG_BUSFAULT=y
CONFIG_DEBUG_USAGEFAULT=y
# STM32F746 silicon uses Cortex-M7 r0p1. Erratum 837070 can let the
# instruction following a BASEPRI raise be preempted before the new mask takes
# effect, violating NuttX scheduler critical sections. Serialize priority
# raises through PRIMASK using NuttX's architecture workaround.
CONFIG_ARMV7M_BASEPRI_WAR=y

# The init task's stack (the app's entry) comes from CONFIG_NUTTX_STACKSIZE,
# 16 KB on this board.

# The NuttX console backend reads RX through NuttX's IRQ-filled serial buffer and puts its
# non-blocking descriptor in raw mode so NuttX does not also echo each keystroke (the shell, or
# the Linux guest's shell, owns echo) or line-buffer to a newline. tcsetattr needs termios.
CONFIG_SERIAL_TERMIOS=y

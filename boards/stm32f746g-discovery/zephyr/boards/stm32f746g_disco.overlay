/* Auto-generated by board_tool.py -- BEGIN */

/ {
	leds {
		compatible = "gpio-leds";
		led_0: led_0 {
			gpios = <&gpioi 1 GPIO_ACTIVE_HIGH>;
		};
	};
};

/* TODO: verify USART instance — defaulting to usart1 */
&usart1 {
	current-speed = <115200>;
	status = "okay";
};


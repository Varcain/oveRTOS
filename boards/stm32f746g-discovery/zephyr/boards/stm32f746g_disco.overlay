#include <zephyr/dt-bindings/dma/stm32_dma.h>
#include <dt-bindings/clock/stm32f7_sai_clock.h>
#include <zephyr/dt-bindings/memory-controller/stm32-fmc-sdram.h>

/*
 * FMC read-pipe delay = 1. At the 108 MHz FMC clock RPIPE=0 leaves no read-capture margin: once the
 * LTDC continuously burst-reads the framebuffer out of this SDRAM, CPU cache-line fills and other
 * SDRAM reads go marginal. Every build that drives the panel needs it, native LVGL as well as the
 * Linux personality; FreeRTOS applies the same in bsp_sdram_fixup() and NuttX in board patch 0016.
 * Here it is the st,sdram-control RPIPE field (index 7), which the memc driver programs into
 * SDCR1[14:13] during init, before the LTDC starts fetching. The SDTR timing and refresh stay stock.
 */
&fmc {
	sdram {
		bank@0 {
			st,sdram-control = <STM32_FMC_SDRAM_NC_8
					    STM32_FMC_SDRAM_NR_12
					    STM32_FMC_SDRAM_MWID_16
					    STM32_FMC_SDRAM_NB_4
					    STM32_FMC_SDRAM_CAS_2
					    STM32_FMC_SDRAM_SDCLK_PERIOD_2
					    STM32_FMC_SDRAM_RBURST_ENABLE
					    STM32_FMC_SDRAM_RPIPE_1>;
		};
	};
};

/* ove_watchdog drives the IWDG through the watchdog0 alias. */
/ {
	aliases {
		watchdog0 = &iwdg;
	};
};

/* Hardware entropy for the network stack and the Linux personality's CSPRNG
 * (ENTROPY_STM32_RNG); the upstream board leaves the RNG disabled. */
&rng {
	status = "okay";
};

&iwdg {
	status = "okay";
};

/* SRAM1 + SRAM2, contiguous from 0x20010000 (240 KB + 16 KB). The 64 KB DTCM
 * (0x20000000-0x2000FFFF) is a separate region — must not overlap. */
&sram0 {
	reg = <0x20010000 0x40000>;
};

/* Define SAI2 Block A and B nodes (not yet in upstream Zephyr) */
/ {
	soc {
		sai2_a: sai2@40015c04 {
			compatible = "st,stm32-sai";
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0x40015c04 0x20>;
			clocks = <&rcc STM32_CLOCK(APB2, 23)>;
			dmas = <&dma2 4 3 (STM32_DMA_MODE_NORMAL |
				STM32_DMA_PRIORITY_HIGH |
				STM32_DMA_16BITS) 0>;
			status = "disabled";
		};

		sai2_b: sai2@40015c24 {
			compatible = "st,stm32-sai";
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0x40015c24 0x20>;
			clocks = <&rcc STM32_CLOCK(APB2, 23)>;
			dmas = <&dma2 7 0 (STM32_DMA_MODE_NORMAL |
				STM32_DMA_PRIORITY_HIGH |
				STM32_DMA_16BITS) 0>;
			status = "disabled";
		};
	};
};

&dma2 {
	status = "okay";
};

&sdmmc1 {
	dmas = <&dma2 6 4 0x30000 0x00>, <&dma2 3 4 0x30000 0x00>;
	dma-names = "tx", "rx";
	/* 48 MHz / (0 + 2) = 24 MHz, as on FreeRTOS. A 2 MHz clock and
	 * single-sector transfers were used while the board froze under
	 * sustained SQLite rewrites; that freeze was a speculative read of the
	 * QSPI window beyond the flash (board patch 0005), not the SD path. */
	clk-div = <0>;
	/* All four data lines. The binding defaults to one line, and the HAL's
	 * own switch probes the SCR with a loop that fails at low clocks, so the
	 * driver sends ACMD6 itself (patches/0004-sdmmc-direct-wide-bus-switch.patch). */
	bus-width = <4>;
	/delete-property/ cd-gpios;
};

/* Configure PLLSAI for audio clocking (approximate 44.1k family)
 * Goal: produce MCLK near 11.2896 MHz (256 * 44.1k = 11.2896 MHz).
 * Exact 11.2896 cannot be produced with HSE=25MHz and integer dividers,
 * so we choose PLLSAI N = 361 and dividers 8 and 4 to get:
 * PLLSAI_VCO = (25MHz / 25) * 361 = 361 MHz
 * SAI clock = 361 / 8 / 4 = 11.28125 MHz
 * Resulting sample rate = 11.28125 / 256 = 44032.22656 Hz (approx. 44.03 kHz)
 */
&pllsai {
	/* Zephyr 4.4.0 reworked the st,stm32fx-pll-clock binding: div-divq was
	 * renamed to post-div-q, and div-m + clocks are now required.  div-m
	 * is shared between PLL/PLLSAI/PLLI2S on F7, so it must match &pll's. */
	div-m = <25>;
	mul-n = <361>;
	div-q = <8>;
	post-div-q = <4>;
	clocks = <&clk_hse>;
	status = "okay";
};

i2s_tx: &sai2_a {
	status = "okay";
	pinctrl-0 = <&sai2_mclk_a_pi4 &sai2_sck_a_pi5
		     &sai2_sd_a_pi6 &sai2_fs_a_pi7>;
	pinctrl-names = "default";
	clocks = <&rcc STM32_CLOCK(APB2, 23)>,
		 <&rcc STM32_SRC_PLLSAI_POST_Q SAI2_SEL(0)>;
	dma-names = "tx";
	mclk-enable;
	mclk-divider = "div-256";
};

i2s_rx: &sai2_b {
	status = "okay";
	pinctrl-0 = <&sai2_sd_b_pg10>;
	pinctrl-names = "default";
	dma-names = "rx";
	/* SAI2_B must be synchronous with SAI2_A since it shares clocks */
	synchronous;
};

&i2c3 {
audio_codec: wm8994@1a {
	compatible = "wolfson,wm8994";
	reg = <0x1a>;
	#sound-dai-cells = <0>;
	status = "okay";
};
};

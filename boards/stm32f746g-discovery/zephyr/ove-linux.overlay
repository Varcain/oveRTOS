 *
 * Linux personality (headless) on the STM32F746G-Discovery. The upstream board enables the LTDC
 * display, which uses the 8 MB FMC SDRAM (sdram1 @0xC0000000) as its framebuffer. The Linux
 * personality places its program-image pool (NREG x 768K) in that same SDRAM (the "SDRAM1" NOLOAD
 * linker region, via Z_GENERIC_SECTION in backends/zephyr/zephyr_lnx.c), so disable the display to
 * free the whole region. The FMC controller itself stays enabled (the memc driver still brings the
 * SDRAM up at boot).
 */

&ltdc {
	status = "disabled";
};

/*
 * Free an MPU region for the program's memory domain. This M7 has only 8 PMSAv7 regions; the Linux
 * program needs three domain partitions (libc TLS + image + dynamic arena) plus its K_USER stack.
 * The STM32 seam deliberately omits Zephyr's unused malloc partition. These do not fit alongside
 * the full static set and stack guard. The headless build never uses the QSPI window at 0x90000000,
 * whose placeholder memory-region ("QSPI_PLACEHOLDER") costs a static MPU region — delete it (and
 * disable the unused controller) to reclaim the room.
 */
/delete-node/ &quadspi_memory;

&quadspi {
	status = "disabled";
};

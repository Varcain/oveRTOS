+		uint8_t *sector_buf = stm32_sdmmc_bounded_buffer + (size_t)i * BLOCKSIZE;
+
+		sys_cache_data_flush_range(sector_buf, BLOCKSIZE);
+		err = stm32_sdmmc_write_transfer(priv, sector_buf, start_sector + i, 1);
+		if (err != 0) {
+			(void)stm32_sdmmc_recover_transfer(priv, "write retry");
+			return err;
+		}
+	}
+	return 0;
+}

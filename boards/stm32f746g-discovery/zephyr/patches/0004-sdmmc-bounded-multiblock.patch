+static HAL_StatusTypeDef stm32_sdmmc_read_multiblock_dma(HandleTypeDef *hsd,
+						 uint8_t *data_buf,
+						 uint32_t start_sector,
+						 uint32_t num_sector)
+{
+	SDMMC_DataInitTypeDef config;
+	uint32_t address = start_sector;
+	uint32_t error;
+
+	if (data_buf == NULL || num_sector <= 1u || start_sector > hsd->SdCard.LogBlockNbr ||
+	    num_sector > hsd->SdCard.LogBlockNbr - start_sector) {
+		hsd->ErrorCode |= HAL_SD_ERROR_PARAM;
+		return HAL_ERROR;
+	}
+	if (hsd->State != HAL_SD_STATE_READY)
+		return HAL_BUSY;
+
+	hsd->ErrorCode = HAL_SD_ERROR_NONE;
+	hsd->State = HAL_SD_STATE_BUSY;
+	hsd->Instance->DCTRL = 0u;
+	hsd->Context = SD_CONTEXT_READ_MULTIPLE_BLOCK | SD_CONTEXT_DMA;
+	STM32_SDMMC_CLEAR_FLAG(hsd, SDMMC_STATIC_DATA_FLAGS);
+	__HAL_SD_ENABLE_IT(hsd, SDMMC_IT_DCRCFAIL | SDMMC_IT_DTIMEOUT |
+				  SDMMC_IT_RXOVERR | SDMMC_IT_DATAEND);
+	hsd->hdmarx->XferCpltCallback = stm32_sdmmc_bounded_rx_complete;
+	hsd->hdmarx->XferErrorCallback = stm32_sdmmc_bounded_dma_error;
+	hsd->hdmarx->XferAbortCallback = NULL;
+	hsd->hdmarx->Init.Direction = DMA_PERIPH_TO_MEMORY;
+	MODIFY_REG(hsd->hdmarx->Instance->CR, DMA_SxCR_DIR,
+		   hsd->hdmarx->Init.Direction);
+	if (HAL_DMA_Start_IT(hsd->hdmarx, (uint32_t)&hsd->Instance->FIFO,
+			     (uint32_t)data_buf,
+			     (uint32_t)(BLOCKSIZE * num_sector) / 4u) != HAL_OK) {
+		stm32_sdmmc_bounded_start_failed(hsd, hsd->hdmarx,
+						 HAL_SD_ERROR_DMA, false);
+		return HAL_ERROR;
+	}
+	__HAL_SD_DMA_ENABLE(hsd);
+	if (hsd->SdCard.CardType != CARD_SDHC_SDXC)
+		address *= BLOCKSIZE;
+	config.DataTimeOut = SDMMC_DATATIMEOUT;
+	config.DataLength = BLOCKSIZE * num_sector;
+	config.DataBlockSize = SDMMC_DATABLOCK_SIZE_512B;
+	config.TransferDir = SDMMC_TRANSFER_DIR_TO_SDMMC;
+	config.TransferMode = SDMMC_TRANSFER_MODE_BLOCK;
+	config.DPSM = SDMMC_DPSM_ENABLE;
+	(void)SDMMC_ConfigData(hsd->Instance, &config);
+	error = SDMMC_CmdReadMultiBlock(hsd->Instance, address);
+	if (error != HAL_SD_ERROR_NONE) {
+		stm32_sdmmc_bounded_start_failed(hsd, hsd->hdmarx, error, true);
+		return HAL_ERROR;
+	}
+	return HAL_OK;
+}

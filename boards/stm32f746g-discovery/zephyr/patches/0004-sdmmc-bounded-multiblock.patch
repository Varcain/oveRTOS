+#if defined(CONFIG_SDMMC_STM32_BOUNDED_MULTIBLOCK) && STM32_SDMMC_USE_DMA
+static int stm32_sdmmc_read_bounded(struct stm32_sdmmc_priv *priv,
+				    uint32_t start_sector, uint32_t num_sector)
+{
+	size_t bytes = (size_t)num_sector * BLOCKSIZE;
+	int err;
+
+	sys_cache_data_flush_and_invd_range(stm32_sdmmc_bounded_buffer, bytes);
+	err = stm32_sdmmc_read_transfer(priv, stm32_sdmmc_bounded_buffer, start_sector,
+					 num_sector);
+	if (err == 0) {
+		sys_cache_data_invd_range(stm32_sdmmc_bounded_buffer, bytes);
+		return 0;
+	}
+	sys_cache_data_invd_range(stm32_sdmmc_bounded_buffer, bytes);
+	if (stm32_sdmmc_recover_transfer(priv, "read") != 0)
+		return err;
+
+	LOG_WRN("sd read retry: sector=%u count=%u", start_sector, num_sector);
+	for (uint32_t i = 0; i < num_sector; i++) {
+		uint8_t *sector_buf = stm32_sdmmc_bounded_buffer + (size_t)i * BLOCKSIZE;
+
+		sys_cache_data_flush_and_invd_range(sector_buf, BLOCKSIZE);
+		err = stm32_sdmmc_read_transfer(priv, sector_buf, start_sector + i, 1);
+		if (err != 0) {
+			(void)stm32_sdmmc_recover_transfer(priv, "read retry");
+			return err;
+		}
+	}
+	sys_cache_data_invd_range(stm32_sdmmc_bounded_buffer, bytes);
+	return 0;
+}
+#endif

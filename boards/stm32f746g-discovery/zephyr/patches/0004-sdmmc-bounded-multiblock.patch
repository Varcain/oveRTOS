+static int stm32_sdmmc_stop_multiblock(struct stm32_sdmmc_priv *priv,
+				       const char *operation)
+{
+	uint32_t error = SDMMC_CmdStopTransfer(priv->hsd.Instance);
+
+	if (error == HAL_SD_ERROR_NONE)
+		return 0;
+	priv->hsd.ErrorCode |= error;
+	LOG_ERR("sd %s stop failed: error=0x%x sta=0x%x", operation,
+		priv->hsd.ErrorCode, priv->hsd.Instance->STA);
+	return -EIO;
+}
+
+static int stm32_sdmmc_recover_transfer(struct stm32_sdmmc_priv *priv,
+					const char *operation)
+{
+	int64_t deadline = k_uptime_get() + STM32_SDMMC_CARD_READY_TIMEOUT_MS;
+	bool stop_sent = false;
+
+	stm32_sdmmc_record_recovery(priv);
+	/* HAL abort runs in this disk thread, where its bounded tick waits and any
+	 * status/stop commands cannot wedge interrupt context. */
+	stm32_sdmmc_abort_transfer(priv);
+	priv->hsd.ErrorCode = HAL_SD_ERROR_NONE;
+	priv->hsd.State = HAL_SD_STATE_READY;
+	priv->hsd.Context = SD_CONTEXT_NONE;
+
+	do {
+		HAL_SD_CardStateTypeDef state = HAL_SD_GetCardState(&priv->hsd);
+
+		if (state == HAL_SD_CARD_TRANSFER) {
+			priv->hsd.ErrorCode = HAL_SD_ERROR_NONE;
+			return 0;
+		}
+		if ((state == HAL_SD_CARD_SENDING || state == HAL_SD_CARD_RECEIVING) &&
+		    !stop_sent) {
+			uint32_t error = SDMMC_CmdStopTransfer(priv->hsd.Instance);
+
+			if (error != HAL_SD_ERROR_NONE) {
+				priv->hsd.ErrorCode |= error;
+				break;
+			}
+			stop_sent = true;
+		} else if (state != HAL_SD_CARD_PROGRAMMING &&
+			   state != HAL_SD_CARD_SENDING && state != HAL_SD_CARD_RECEIVING) {
+			break;
+		}
+		k_msleep(1);
+	} while (k_uptime_get() < deadline);
+
+	LOG_ERR("sd %s recovery failed: state=%u error=0x%x sta=0x%x", operation,
+		HAL_SD_GetCardState(&priv->hsd), priv->hsd.ErrorCode,
+		priv->hsd.Instance->STA);
+	return -EIO;
+}
+
+static void stm32_sdmmc_bounded_start_failed(HandleTypeDef *hsd,
+					     DMA_HandleTypeDef *hdma,
+					     uint32_t error, bool dma_started)
+{
+	STM32_SDMMC_DISABLE_IT(hsd, SDMMC_IT_DATAEND | SDMMC_IT_DCRCFAIL |
+				      SDMMC_IT_DTIMEOUT | SDMMC_IT_TXUNDERR |
+				      SDMMC_IT_RXOVERR);
+	hsd->Instance->DCTRL = 0u;
+	if (dma_started)
+		(void)HAL_DMA_Abort(hdma);
+	STM32_SDMMC_CLEAR_FLAG(hsd, SDMMC_STATIC_FLAGS);
+	hsd->ErrorCode |= error;
+	hsd->State = HAL_SD_STATE_READY;
+	hsd->Context = SD_CONTEXT_NONE;
+}

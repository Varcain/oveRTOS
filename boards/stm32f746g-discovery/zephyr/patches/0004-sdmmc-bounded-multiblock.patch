+				  SDMMC_IT_TXUNDERR);
+	hsd->hdmatx->XferCpltCallback = stm32_sdmmc_bounded_tx_complete;
+	hsd->hdmatx->XferErrorCallback = stm32_sdmmc_bounded_dma_error;
+	hsd->hdmatx->XferAbortCallback = NULL;
+	if (hsd->SdCard.CardType != CARD_SDHC_SDXC)

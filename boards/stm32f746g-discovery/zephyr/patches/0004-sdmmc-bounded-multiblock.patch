+	if (HAL_DMA_Start_IT(hsd->hdmatx, (uint32_t)data_buf,
+			     (uint32_t)&hsd->Instance->FIFO,
+			     (uint32_t)(BLOCKSIZE * num_sector) / 4u) != HAL_OK) {
+		stm32_sdmmc_bounded_start_failed(hsd, hsd->hdmatx,
+						 HAL_SD_ERROR_DMA, false);
+		return HAL_ERROR;
+	}
+	__HAL_SD_DMA_ENABLE(hsd);
+	config.DataTimeOut = SDMMC_DATATIMEOUT;
+	config.DataLength = BLOCKSIZE * num_sector;
+	config.DataBlockSize = SDMMC_DATABLOCK_SIZE_512B;
+	config.TransferDir = SDMMC_TRANSFER_DIR_TO_CARD;
+	config.TransferMode = SDMMC_TRANSFER_MODE_BLOCK;
+	config.DPSM = SDMMC_DPSM_ENABLE;
+	(void)SDMMC_ConfigData(hsd->Instance, &config);
+	return HAL_OK;

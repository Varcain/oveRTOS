+static int stm32_sdmmc_write_bounded(struct stm32_sdmmc_priv *priv,
+				     uint32_t start_sector, uint32_t num_sector)
+{
+	size_t bytes = (size_t)num_sector * BLOCKSIZE;
+	int err;

+	error = SDMMC_CmdWriteMultiBlock(hsd->Instance, address);
+	if (error != HAL_SD_ERROR_NONE) {
+		stm32_sdmmc_bounded_start_failed(hsd, hsd->hdmatx, error, false);
+		return HAL_ERROR;
+	}
+	hsd->hdmatx->Init.Direction = DMA_MEMORY_TO_PERIPH;
+	MODIFY_REG(hsd->hdmatx->Instance->CR, DMA_SxCR_DIR,

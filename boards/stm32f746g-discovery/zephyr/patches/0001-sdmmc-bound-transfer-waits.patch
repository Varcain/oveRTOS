+			stm32_sdmmc_dma_quiesce_isr(hsd, context);
+		}
+#endif
+		STM32_SDMMC_CLEAR_FLAG(hsd, SDMMC_STATIC_DATA_FLAGS);
+		stm32_sdmmc_signal_isr(hsd);
+		return;
+	}
 

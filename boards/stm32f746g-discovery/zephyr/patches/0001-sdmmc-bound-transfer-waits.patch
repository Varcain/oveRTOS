+static int stm32_sdmmc_wait_for_completion(struct stm32_sdmmc_priv *priv,
+					   const char *operation)
+{
+	int ret = k_sem_take(&priv->sync, STM32_SDMMC_TRANSFER_TIMEOUT);
+
+	if (ret == 0) {
+		return 0;
+	}
+
+	LOG_ERR("sd %s completion timeout: state=%u error=0x%x sta=0x%x "
+		"dcount=%u dctrl=0x%x",
+		operation, priv->hsd.State, priv->hsd.ErrorCode,
+		priv->hsd.Instance->STA, priv->hsd.Instance->DCOUNT,
+		priv->hsd.Instance->DCTRL);
+	stm32_sdmmc_abort_transfer(priv);
+	return -ETIMEDOUT;
+}
+
+static int stm32_sdmmc_wait_for_card(struct stm32_sdmmc_priv *priv,
+				     const char *operation)
+{
+	int64_t deadline = k_uptime_get() + STM32_SDMMC_CARD_READY_TIMEOUT_MS;
+
+	do {
+		if (stm32_sdmmc_is_card_in_transfer(&priv->hsd)) {
+			return 0;
+		}
+		k_msleep(1);
+	} while (k_uptime_get() < deadline);
+
+	LOG_ERR("sd %s card-ready timeout: state=%u error=0x%x sta=0x%x "
+		"dcount=%u dctrl=0x%x",
+		operation, priv->hsd.State, priv->hsd.ErrorCode,
+		priv->hsd.Instance->STA, priv->hsd.Instance->DCOUNT,
+		priv->hsd.Instance->DCTRL);
+	stm32_sdmmc_abort_transfer(priv);
+	return -ETIMEDOUT;
+}

 static void stm32_sdmmc_isr(const struct device *dev)
 {
 	struct stm32_sdmmc_priv *priv = dev->data;
+	HandleTypeDef *hsd = &priv->hsd;
+	uint32_t context = hsd->Context;
+	uint32_t status = hsd->Instance->STA;
+	uint32_t error_flags = status & (SDMMC_FLAG_DCRCFAIL | SDMMC_FLAG_DTIMEOUT |
+					 SDMMC_FLAG_TXUNDERR | SDMMC_FLAG_RXOVERR);
+
+	/* STM32Cube's F7 error path leaves the FIFO level interrupts enabled and
+	 * issues CMD12 synchronously from interrupt context. A data error can then
+	 * tail-chain the SDMMC IRQ indefinitely and starve the entire system. Stop
+	 * the data path here, wake the bounded thread-context waiter, and let the
+	 * disk layer report the failed sector without attempting ISR recovery. */
+	if (error_flags != 0u) {
+		if ((error_flags & SDMMC_FLAG_DCRCFAIL) != 0u)
+			hsd->ErrorCode |= SDMMC_ERROR_DATA_CRC_FAIL;
+		if ((error_flags & SDMMC_FLAG_DTIMEOUT) != 0u)
+			hsd->ErrorCode |= SDMMC_ERROR_DATA_TIMEOUT;
+		if ((error_flags & SDMMC_FLAG_TXUNDERR) != 0u)
+			hsd->ErrorCode |= SDMMC_ERROR_TX_UNDERRUN;
+		if ((error_flags & SDMMC_FLAG_RXOVERR) != 0u)
+			hsd->ErrorCode |= SDMMC_ERROR_RX_OVERRUN;
+
+		STM32_SDMMC_DISABLE_IT(hsd, SDMMC_IT_DATAEND | SDMMC_IT_DCRCFAIL |
+					      SDMMC_IT_DTIMEOUT | SDMMC_IT_TXUNDERR |
+					      SDMMC_IT_RXOVERR | SDMMC_IT_TXFIFOHE |
+					      SDMMC_IT_RXFIFOHF);
+		hsd->Instance->DCTRL = 0u;
+#if STM32_SDMMC_USE_DMA
+		if ((context & SD_CONTEXT_DMA) != 0u) {
+			stm32_sdmmc_dma_quiesce_isr(hsd, context);
+		}
+#endif
+		STM32_SDMMC_CLEAR_FLAG(hsd, SDMMC_STATIC_DATA_FLAGS);
+		priv->status = (int)hsd->ErrorCode;
+		k_sem_give(&priv->sync);
+		return;
+	}
 

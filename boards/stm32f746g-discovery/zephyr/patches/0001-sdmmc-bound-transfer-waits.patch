+		STM32_SDMMC_DISABLE_IT(hsd, SDMMC_IT_DATAEND | SDMMC_IT_DCRCFAIL |
+						    SDMMC_IT_DTIMEOUT | SDMMC_IT_TXUNDERR |
+						    SDMMC_IT_RXOVERR | SDMMC_IT_TXFIFOHE |
+						    SDMMC_IT_RXFIFOHF);
+		hsd->Instance->DCTRL = 0u;

+static void stm32_sdmmc_dma_quiesce_isr(HandleTypeDef *hsd, uint32_t context)
+{
+	DMA_HandleTypeDef *hdma = NULL;
+
+	if ((context & (SD_CONTEXT_WRITE_SINGLE_BLOCK |
+			SD_CONTEXT_WRITE_MULTIPLE_BLOCK)) != 0u) {
+		hdma = hsd->hdmatx;
+	} else if ((context & (SD_CONTEXT_READ_SINGLE_BLOCK |
+			   SD_CONTEXT_READ_MULTIPLE_BLOCK)) != 0u) {
+		hdma = hsd->hdmarx;
+	}
+
+	if (hdma == NULL) {
+		return;
+	}
+
+	/* Stop new peripheral requests and prevent a stale DMA callback from
+	 * racing the thread-context abort. HAL_DMA_Abort() is deliberately not
+	 * called here: its timeout depends on the system tick, which need not
+	 * advance while this interrupt is running. */
+	hdma->Instance->CR &= ~(DMA_IT_TC | DMA_IT_TE | DMA_IT_DME | DMA_IT_HT);
+	hdma->Instance->FCR &= ~DMA_IT_FE;
+	__HAL_DMA_DISABLE(hdma);

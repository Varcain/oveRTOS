+static uint64_t stm32_sdmmc_elapsed_us(uint64_t start_cycles)
+{
+	return k_cyc_to_us_floor64(k_cycle_get_64() - start_cycles);
+}
+
+static void stm32_sdmmc_record_command(struct stm32_sdmmc_priv *priv,
+				       bool write, uint32_t blocks)
+{
+	k_spinlock_key_t key = k_spin_lock(&priv->metrics_lock);
+
+	if (write) {
+		priv->metrics.write_commands++;
+		priv->metrics.write_blocks += blocks;
+	} else {
+		priv->metrics.read_commands++;
+		priv->metrics.read_blocks += blocks;
+	}
+	if (blocks > 1u) {
+		priv->metrics.multiblock_commands++;
+	}
+	k_spin_unlock(&priv->metrics_lock, key);
+}
+
+static void stm32_sdmmc_record_wait(struct stm32_sdmmc_priv *priv,
+				    bool card_ready, uint64_t elapsed_us)
+{
+	k_spinlock_key_t key = k_spin_lock(&priv->metrics_lock);
+	uint64_t *total = card_ready ? &priv->metrics.ready_wait_us_total
+				     : &priv->metrics.completion_wait_us_total;
+	uint64_t *maximum = card_ready ? &priv->metrics.ready_wait_us_max
+				       : &priv->metrics.completion_wait_us_max;
+
+	*total += elapsed_us;
+	if (elapsed_us > *maximum) {
+		*maximum = elapsed_us;
+	}
+	k_spin_unlock(&priv->metrics_lock, key);
+}
+
+static void stm32_sdmmc_record_error(struct stm32_sdmmc_priv *priv)
+{
+	k_spinlock_key_t key = k_spin_lock(&priv->metrics_lock);
+
+	priv->metrics.errors++;
+	k_spin_unlock(&priv->metrics_lock, key);
+}

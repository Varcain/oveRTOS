+void stm32_sdmmc_get_metrics(const struct device *dev,
+			     struct stm32_sdmmc_metrics *metrics)
+{
+	struct stm32_sdmmc_priv *priv = dev->data;
+	k_spinlock_key_t key = k_spin_lock(&priv->metrics_lock);
+
+	*metrics = priv->metrics;
+	k_spin_unlock(&priv->metrics_lock, key);
+}
+
+void stm32_sdmmc_reset_metrics(const struct device *dev)
+{
+	struct stm32_sdmmc_priv *priv = dev->data;
+	k_spinlock_key_t key = k_spin_lock(&priv->metrics_lock);
+
+	memset(&priv->metrics, 0, sizeof(priv->metrics));
+	k_spin_unlock(&priv->metrics_lock, key);
+}

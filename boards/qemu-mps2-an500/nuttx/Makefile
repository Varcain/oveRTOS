############################################################################
# boards/qemu-mps2-an500/nuttx/Makefile
#
# NuttX application Makefile for oveRTOS on QEMU MPS2-AN500.
############################################################################

ifneq ($(APPDIR),)
include $(APPDIR)/Make.defs
endif

PROGNAME  = $(CONFIG_EXTERNAL_OVE_APP_PROGNAME)
PRIORITY  = $(CONFIG_EXTERNAL_OVE_APP_PRIORITY)
STACKSIZE = $(CONFIG_EXTERNAL_OVE_APP_STACKSIZE)
MODULE    = $(CONFIG_EXTERNAL_OVE_APP)

# Resolve directories — written by ove build or passed via make command line.
# .ove_env is generated by the build system alongside this Makefile.
-include .ove_env
OVE_DIR     ?= $(error OVE_DIR must be set — run ove build)
OVE_GEN_DIR ?= $(error OVE_GEN_DIR must be set — run ove build)
QEMU_SRC_DIR    := $(OVE_DIR)/boards/qemu-mps2-an500/src

# Resolve app dir
ifeq ($(OVE_APP_DIR),)
  _APP := $(shell grep '^CONFIG_OVE_APP_NAME=' $(OVE_DIR)/.config 2>/dev/null | cut -d'"' -f2)
  ifneq ($(_APP),)
    OVE_APP_DIR := $(OVE_DIR)/apps/$(_APP)
  endif
endif

MAINSRC = main.c

# Backend sources from generated config
-include $(OVE_GEN_DIR)/ove_sources.mk

# Sim framework replaces the NuttX display/audio backends on QEMU.
# Always replace — QEMU uses semihosting transport, never native drivers.
SIM_DIR := $(OVE_DIR)/sim

CSRCS = $(OVE_BACKEND_SRCS)
CSRCS := $(filter-out %nuttx_lvgl.c,$(CSRCS))
CSRCS := $(filter-out %nuttx_audio.c,$(CSRCS))
ifneq ($(wildcard $(LVGL_INCLUDE_PATH)/lvgl.h),)
CSRCS += $(SIM_DIR)/hal/sim_lvgl.c
endif
CSRCS += $(SIM_DIR)/hal/sim_audio.c
CSRCS += $(SIM_DIR)/src/ove_sim_registry.c
CSRCS += $(SIM_DIR)/src/ove_sim_input.c
CSRCS += $(SIM_DIR)/src/ove_sim_transport_shm_guest.c
CSRCS += $(SIM_DIR)/hal/sim_board.c
CSRCS += $(SIM_DIR)/hal/sim_display.c

# Application sources (generated from app.yaml by 'ove configure')
-include $(OVE_GEN_DIR)/app_sources.mk
# Legacy fallback
ifeq ($(APP_LANG),)
-include $(OVE_APP_DIR)/sources.mk
endif
-include $(OVE_DIR)/config/make/ove_app_lang.mk

CFLAGS += $(APP_INCLUDES)
CFLAGS += -I$(OVE_DIR)/include
CFLAGS += -I$(OVE_DIR)/backends/nuttx/include
CFLAGS += -I$(OVE_DIR)/backends/common
CFLAGS += -I$(OVE_DIR)/sim/include
CFLAGS += -I$(OVE_DIR)/sim/src
CFLAGS += -I$(OVE_GEN_DIR)
CFLAGS += -I$(OVE_GEN_DIR)/generated_models
CFLAGS += -I$(QEMU_SRC_DIR)
ifneq ($(wildcard $(LVGL_INCLUDE_PATH)/lvgl.h),)
CFLAGS += -I$(LVGL_INCLUDE_PATH)
CFLAGS += -I$(LVGL_PARENT_PATH)
endif

ifneq ($(APPDIR),)
include $(APPDIR)/Application.mk
endif

# NuttX defconfig overlay for the Linux personality on qemu-mps2-an500.
# Applied automatically when CONFIG_OVE_LINUX=y (layer 2b, see
# config/ove-cli/ove/rtos_menuconfig.py:_merge_nuttx_layers).
#
# The personality loads FDPIC programs and runs them UNPRIVILEGED behind an MPU view LXP's NuttX
# port programs DIRECTLY via raw registers (ports/nuttx/lxp_nuttx_port.c: lxp_mpu_init + PRIVDEFENA
# + a MemManage containment handler) — done in plain CONFIG_BUILD_FLAT, no CONFIG_BUILD_PROTECTED. We
# own the MPU, so NuttX's own arm_mpu.c (whose FLAT setup marks the program RAM execute-never, which
# would fault the program on its first instruction fetch) must stay OUT of the build.
CONFIG_ARM_MPU=n

# The personality's svc handler runs on NuttX's interrupt stack and calls into
# the syscall core + the app's I/O callbacks; give it headroom over the 2 KB
# default.
CONFIG_ARCH_INTERRUPTSTACK=4096

# Persistent Linux guest parking uses NuttX's stopped-task state; the LXP port moves
# the existing TCB back to the ready list when the syscall completes.
CONFIG_SIG_DEFAULT=y
CONFIG_SIG_SIGSTOP_ACTION=y

# Inter-program isolation: LXP's NuttX port note driver hooks EVERY
# context switch — including round-robin preemption between same-priority program tasks, which the
# syscall path cannot see — to reprogram the MPU to the incoming program's OWN region. That
# hook is the sched_note switch instrumentation, dispatched through the note-driver framework
# (CONFIG_DRIVERS_NOTE compiles note_driver.c = sched_note_* + note_driver_register). We register
# our own driver only; no note buffer (NOTERAM/etc.) is enabled.
CONFIG_DRIVERS_NOTE=y
CONFIG_DRIVERS_NOTERAM=n
CONFIG_SCHED_INSTRUMENTATION=y
CONFIG_SCHED_INSTRUMENTATION_SWITCH=y

# Kernel RAM lives in SSRAM2&3 (0x20000000, 4M — QEMU mps.ssram23), not the 16M
# block at 0x60000000. Must match the sram1 region in this board's flash.ld,
# patched by boards/qemu-mps2-an500/nuttx/patches/0001-*: CONFIG_RAM_START sizes
# the heap, the linker script places .data/.bss, and they have to agree.
#
# The 16M block is the only region big enough to stage the personality's
# rootfs.cpio, so kernel RAM cannot share it: NuttX's startup would copy .data
# over the CPIO header and zero .bss across it ("rootfs CPIO parse failed
# n=4294967295"). Moving out hands 0x60000000..0x60800000 to the rootfs and
# leaves the upper 8M for the guest pool. 4M here is more heap than the 2M it replaces.
CONFIG_RAM_START=0x20000000
CONFIG_RAM_SIZE=4194304

 *
 * Linux personality: split the AN521 PSRAM (16 MB @ 0x80000000) between a raw
 * rootfs loaded by QEMU and a NOLOAD linker region ("OVE_PROG_RAM") for the
 * program pools. Keeping both out of the ELF lets the normal 15 MB Buildroot
 * image coexist with Zephyr's 4 MB internal flash limit.
 */

/delete-node/ &psram;

/ {
	chosen {
		/* NET_QEMU_SLIP selects UART_PIPE; keep its transport off the
		 * console and bind the board's already-enabled second UART. */
		zephyr,uart-pipe = &uart1;
	};

	/* qemu-run.sh rejects a rootfs larger than this reserved window. */
	lxp_rootfs_ram: memory@80000000 {
		device_type = "memory";
		reg = <0x80000000 0x00ef0000>;
	};

	/* One QEMU validation region plus its cold captures and optional
	 * 256 KiB netfs-exec stage fits in the remaining 1088 KiB. */
	lxp_pool_ram: memory@80ef0000 {
		device_type = "memory";
		reg = <0x80ef0000 0x00110000>;
		compatible = "zephyr,memory-region", "mmio-sram";
		zephyr,memory-region = "OVE_PROG_RAM";
	};
};

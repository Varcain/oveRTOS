/*
 * Public structs whose C layout the Rust and Zig bindings must match.
 * The size probe (OveBindingsCommon.cmake) expands these X-macros; the
 * bindings assert size, alignment and each listed field's offset and size.
 * Anonymous unions are covered by size/alignment only.  struct
 * ove_fb_info is not listed: ove/fb.h is not part of ove/ove.h.
 */

OVE_ABI_STRUCT(ove_audio_fmt)
OVE_ABI_FIELD(ove_audio_fmt, sample_rate)
OVE_ABI_FIELD(ove_audio_fmt, channels)
OVE_ABI_FIELD(ove_audio_fmt, sample_fmt)


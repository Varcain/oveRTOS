From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: oveRTOS <noreply@overtos.local>
Date: Wed, 29 Jul 2026 00:00:00 +0200
Subject: [PATCH] ARM_CM4_MPU: dedicate peripheral region to tasks

The Linux personality grants devices through generation-keyed per-task
capabilities. FreeRTOS' default 512 MiB unprivileged peripheral mapping both
bypasses that policy and consumes an MPU region needed for copied-text W^X.

Keep the three kernel/static regions and stack region, return the removed slot
to the task-configurable set, and restore the additional descriptor in both
context-switch paths.
---
 portable/GCC/ARM_CM4_MPU/port.c      | 22 ++++++++++------------
 portable/GCC/ARM_CM4_MPU/portmacro.h |  7 +++----
 2 files changed, 13 insertions(+), 16 deletions(-)

diff --git a/portable/GCC/ARM_CM4_MPU/port.c b/portable/GCC/ARM_CM4_MPU/port.c
index 0000000..0000000 100644
--- a/portable/GCC/ARM_CM4_MPU/port.c
+++ b/portable/GCC/ARM_CM4_MPU/port.c
@@ -781,6 +781,11 @@ static void prvRestoreContextOfFirstTask( void )
             " stmia r0, {r4-r11}                    \n" /* Write 4 sets of MPU registers. [MPU Region # 9 - 12]. */
         #endif /* configTOTAL_MPU_REGIONS == 16. */
+        #if ( ( portTOTAL_NUM_REGIONS_IN_TCB % 4UL ) == 1UL )
+            " ldmia r2!, {r4-r5}                    \n" /* Read the final set of MPU registers. */
+            " stmia r0, {r4-r5}                     \n" /* Write the final set of MPU registers. */
+        #endif
         "                                       \n"
         " ldr r0, =0xe000ed94                   \n" /* MPU_CTRL register. */
         " ldr r3, [r0]                          \n" /* Read the value of MPU_CTRL. */
@@ -1140,6 +1145,11 @@ void xPortPendSVHandler( void )
             " stmia r0, {r4-r11}                    \n" /* Write 4 sets of MPU registers. [MPU Region # 8 - 11]. */
         #endif /* configTOTAL_MPU_REGIONS == 16. */
+        #if ( ( portTOTAL_NUM_REGIONS_IN_TCB % 4UL ) == 1UL )
+            " ldmia r2!, {r4-r5}                    \n" /* Read the final set of MPU registers. */
+            " stmia r0, {r4-r5}                     \n" /* Write the final set of MPU registers. */
+        #endif
         "                                       \n"
         " ldr r0, =0xe000ed94                   \n" /* MPU_CTRL register. */
         " ldr r3, [r0]                          \n" /* Read the value of MPU_CTRL. */
@@ -1290,16 +1290,6 @@ static void prvSetupMPU( void )
                                        prvGetMPURegionSizeSetting( ( uint32_t ) __privileged_data_end__ - ( uint32_t ) __privileged_data_start__ ) |
                                        ( portMPU_REGION_ENABLE );
 
-        /* By default allow everything to access the general peripherals.  The
-         * system peripherals and registers are protected. */
-        portMPU_REGION_BASE_ADDRESS_REG = ( portPERIPHERALS_START_ADDRESS ) |
-                                          ( portMPU_REGION_VALID ) |
-                                          ( portGENERAL_PERIPHERALS_REGION );
-
-        portMPU_REGION_ATTRIBUTE_REG = ( portMPU_REGION_READ_WRITE | portMPU_REGION_EXECUTE_NEVER ) |
-                                       ( prvGetMPURegionSizeSetting( portPERIPHERALS_END_ADDRESS - portPERIPHERALS_START_ADDRESS ) ) |
-                                       ( portMPU_REGION_ENABLE );
-
         /* Enable the memory fault exception. */
         portNVIC_SYS_CTRL_STATE_REG |= portNVIC_MEM_FAULT_ENABLE;
 
diff --git a/portable/GCC/ARM_CM4_MPU/portmacro.h b/portable/GCC/ARM_CM4_MPU/portmacro.h
index 0000000..0000000 100644
--- a/portable/GCC/ARM_CM4_MPU/portmacro.h
+++ b/portable/GCC/ARM_CM4_MPU/portmacro.h
@@ -180,14 +180,13 @@
     #define configTEX_S_C_B_SRAM          ( 0x07UL )
 #endif
 
-#define portSTACK_REGION                  ( configTOTAL_MPU_REGIONS - 5UL )
-#define portGENERAL_PERIPHERALS_REGION    ( configTOTAL_MPU_REGIONS - 4UL )
+#define portSTACK_REGION                  ( configTOTAL_MPU_REGIONS - 4UL )
 #define portUNPRIVILEGED_FLASH_REGION     ( configTOTAL_MPU_REGIONS - 3UL )
 #define portPRIVILEGED_FLASH_REGION       ( configTOTAL_MPU_REGIONS - 2UL )
 #define portPRIVILEGED_RAM_REGION         ( configTOTAL_MPU_REGIONS - 1UL )
 #define portFIRST_CONFIGURABLE_REGION     ( 0UL )
-#define portLAST_CONFIGURABLE_REGION      ( configTOTAL_MPU_REGIONS - 6UL )
-#define portNUM_CONFIGURABLE_REGIONS      ( configTOTAL_MPU_REGIONS - 5UL )
+#define portLAST_CONFIGURABLE_REGION      ( configTOTAL_MPU_REGIONS - 5UL )
+#define portNUM_CONFIGURABLE_REGIONS      ( configTOTAL_MPU_REGIONS - 4UL )
 #define portTOTAL_NUM_REGIONS_IN_TCB      ( portNUM_CONFIGURABLE_REGIONS + 1 ) /* Plus 1 to create space for the stack region. */
 
 typedef struct MPU_REGION_REGISTERS
-- 
2.50.1
